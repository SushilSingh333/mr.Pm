---
// The id lives in pixel.ts, because the thank-you page needs the same one to attach
// advanced matching, and two copies would drift apart without ever erroring.
import { PIXEL_ID } from './pixel.js';
/**
 * Third-party measurement: Google Analytics 4 and the Meta pixel.
 *
 * Loaded on the visitor's first touch, not on page load. Their two scripts are about
 * 290 KB and held the main thread for ~360 ms on a phone (PageSpeed, Oct 2026), and they
 * downloaded alongside the banner photo, the page's Largest Contentful Paint. Nothing is
 * lost by waiting: the inline stubs below queue every call at once - the page view, and
 * any event a page fires - and each library replays its queue when it arrives. The files
 * load on the first scroll, tap, key or mouse move, or after a few seconds regardless,
 * so a visitor who only reads is still counted. /thank-you loads them at once: it fires
 * the conversion, and the visitor may leave straight away.
 *
 * The Meta pixel is site-wide rather than only on the quote page. It was asked for on
 * /get-quote alone, but a pixel that only sees the form page cannot attribute the ad
 * click that led there, cannot build a retargeting audience from people who browsed a
 * city page and left, and reports a conversion rate against a denominator of one page.
 * Meta's own install instructions say every page, and that is what makes the ad spend
 * measurable. The conversion itself is fired separately on /thank-you.
 *
 * (Doc 02 §10 zero-JS-by-default still holds for first-party code.)
 *
 * The measurement ID is public by design; PUBLIC_GA_MEASUREMENT_ID overrides it
 * for staging/preview properties. Skipped in `astro dev` so local traffic never
 * lands in the reports — `astro build` + preview does send hits.
 */
// `?? ` alone would not catch a blank `PUBLIC_GA_MEASUREMENT_ID=` line in the env
// file — an empty string is not null, so the site would ship with no tag at all and
// no error. Trim first and treat empty as unset.
const GA_ENV = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined)?.trim();
const GA_ID = GA_ENV || 'G-B35EXJ95XY';
const enabled = import.meta.env.PROD && Boolean(GA_ID);

const pixelEnabled = import.meta.env.PROD && Boolean(PIXEL_ID);

/** The two library files, fetched on first touch. */
const SCRIPTS = [
  ...(enabled ? [`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`] : []),
  ...(pixelEnabled ? ['https://connect.facebook.net/en_US/fbevents.js'] : []),
];
/** The fallback when nobody touches the page: still counted, once the page has settled. */
const DELAY_MS = 6000;

// Google's own snippet, minus its script tag: the queue gtag.js replays.
const GA_STUB = enabled
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('js',new Date());gtag('config','${GA_ID}');`
  : '';
// Meta's own snippet, minus its script tag: the queue fbevents.js replays.
const PIXEL_STUB = pixelEnabled
  ? `!function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
n.push=n;n.loaded=!0;n.version='2.0';n.queue=[]}(window);
fbq('init','${PIXEL_ID}');fbq('track','PageView');`
  : '';
const LOADER = `(function(){var src=${JSON.stringify(SCRIPTS)},done=false,
ev=['scroll','pointerdown','touchstart','keydown','mousemove'];
function load(){if(done)return;done=true;
ev.forEach(function(e){removeEventListener(e,load,{passive:true})});
src.forEach(function(u){var s=document.createElement('script');s.async=true;s.src=u;document.head.appendChild(s)})}
if(location.pathname==='/thank-you'){load();return}
ev.forEach(function(e){addEventListener(e,load,{passive:true})});
setTimeout(load,${DELAY_MS})})();`;
---

{SCRIPTS.length > 0 && <script is:inline set:html={`${GA_STUB}\n${PIXEL_STUB}\n${LOADER}`} />}
{
  pixelEnabled && (
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`}
      />
    </noscript>
  )
}
