---
import type { CityHubData } from '@mpm/shared';
import { jsonld } from '@mpm/seo';
import { rowsOfType, dataOf } from '../../data/manifest.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeoHero from '../../components/sections/GeoHero.astro';
import Band from '../../components/ui/Band.astro';
import Breadcrumbs from '../../components/nav/Breadcrumbs.astro';
import StatStrip from '../../components/trust/StatStrip.astro';
import AreasGrid from '../../components/sections/AreasGrid.astro';
import LocalNotes from '../../components/sections/LocalNotes.astro';
import ReviewList from '../../components/trust/ReviewList.astro';
import RelatedLinks from '../../components/sections/RelatedLinks.astro';
import Faq from '../../components/sections/Faq.astro';
import { SITE_ORIGIN } from '../../lib/site.js';

/** City hub. Every path comes from a manifest row — no arbitrary input (ADR-0003). */
export function getStaticPaths() {
  return rowsOfType('city-hub').map((row) => ({
    params: { city: row.slug },
    props: { row },
  }));
}

const { row } = Astro.props;
const data = dataOf<CityHubData>(row);
// City hero artwork.
//
// /images/hero/cities/<slug>.jpg was being used as this banner's background, but those
// files are 240x240 square thumbnails built for the city cards on the home page. Used
// full-bleed they were upscaled roughly six times and read as a blur on exactly the
// pages that matter most - Delhi, Mumbai, Bengaluru and the rest.
//
// They also had no WebP variants, because the variant builder only walks the top level
// of the hero folder, so every one of those pages requested a -narrow/-full file that
// did not exist and preloaded two 404s.
//
// The branded montage is 1920 wide, sharp, and carries the current logo, so it is the
// better banner until city-specific wide artwork exists. The square thumbnails keep
// doing their real job on the city cards, untouched.
const heroImage = 'home';
const areas = data.areas ?? [];
// Localities are shown in the Areas grid, so keep RelatedLinks to services + routes.
const otherLinks = row.relatedLinks.filter((l) => l.group !== 'localities');

const extraJsonLd = [
  jsonld.service({
    siteOrigin: SITE_ORIGIN,
    name: `Packers and Movers in ${data.cityName}`,
    areaServed: data.cityName,
    offer: data.priceFrom ? { priceFrom: data.priceFrom } : undefined,
  }),
  jsonld.faqPage(data.faqs),
];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  <div class="container-page"><Breadcrumbs items={row.breadcrumbs} current={data.cityName} /></div>

  <GeoHero
    h1={row.h1}
    intro={data.stats.jobs12m > 0
      ? `Fixed written quotes, verified crews, and ${data.stats.jobs12m.toLocaleString('en-IN')} moves completed across ${data.cityName}. We pick up here, and deliver anywhere in India.`
      : `Fixed written quotes and verified crews in ${data.cityName}. We pick up here, and deliver anywhere in India.`}
    image={heroImage}
    imageUrl={data.heroImage?.url}
    prefillCity={data.cityName}
    bands={data.rateBands}
  />

  {
    /* A newly launched city has no completed-job data yet. Claiming a track
       record with zeros would contradict the site's own honesty pitch, so the
       band appears only once real numbers exist. */
    data.stats.jobs12m > 0 && (
      <Band label="Serviceability">
        <div class="section-head">
          <h2>Our track record in {data.cityName}</h2>
        </div>
        <StatStrip stats={data.stats} scope={`in ${data.cityName}`} />
      </Band>
    )
  }

  {
    areas.length > 0 && (
      <Band label="Areas">
        <AreasGrid areas={areas} cityName={data.cityName} />
      </Band>
    )
  }

  {
    data.editorial.length > 0 && (
      <Band alt label="Local notes">
        <LocalNotes
          paragraphs={data.editorial}
          heading={`Moving in ${data.cityName}: what our crews plan for`}
        />
      </Band>
    )
  }

  {
    data.reviews.length > 0 && (
      <Band label="Reviews">
        <ReviewList reviews={data.reviews} heading={`Reviews from ${data.cityName}`} />
      </Band>
    )
  }

  {
    otherLinks.length > 0 && (
      <Band alt label="Explore">
        <RelatedLinks links={otherLinks} />
      </Band>
    )
  }

  {
    data.faqs.length > 0 && (
      <Band label="FAQ">
        <Faq faqs={data.faqs} heading={`Packers and movers in ${data.cityName}: FAQs`} />
      </Band>
    )
  }
</BaseLayout>
