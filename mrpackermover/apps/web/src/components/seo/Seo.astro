---
import type { ManifestRow } from '@mpm/shared';
import { jsonld } from '@mpm/seo';
import { manifest } from '../../data/manifest.js';
import { themeColor } from '@mpm/ui-tokens/tokens';
import JsonLd from './JsonLd.astro';
import { shareFor, type Share } from '../../lib/share.js';
import { FOUNDER_NAME } from '../../lib/site.js';

/**
 * Head SEO for every page. Canonical comes from the manifest row (never from
 * Astro.url — Doc 02 §4). robots defaults to index,follow and is emitted only when
 * noindex. BreadcrumbList + Organization/WebSite (home) are injected here.
 */
interface Props {
  row: ManifestRow;
  /** Extra JSON-LD specific to the page type (Service, Offer, Review, FAQPage...). */
  extraJsonLd?: Array<Record<string, unknown> | null>;
  /** What a shared link shows; blank uses the page's banner photo (lib/share.ts). */
  share?: Share;
}
const { row, extraJsonLd = [], share } = Astro.props;
const m = manifest();
const s = share ?? shareFor(row);
const shareImage = /^https?:\/\//.test(s.image)
  ? s.image
  : `${m.siteOrigin.replace(/\/$/, '')}${s.image}`;
const org = m.org;

const blocks: Array<Record<string, unknown> | null> = [];

if (row.pageType === 'home' && org) {
  blocks.push(
    jsonld.organization({
      siteOrigin: m.siteOrigin,
      legalName: org.legalName,
      brandName: org.brandName,
      // Not published on the site (the owner's call); it is on every quote and invoice.
      gstin: '',
      cin: org.cin,
      registeredOffice: org.registeredOffice,
      sameAs: org.sameAs,
      founder: FOUNDER_NAME,
    }),
  );
  blocks.push(jsonld.website(m.siteOrigin, org.brandName));
}

if (row.breadcrumbs.length > 0) {
  blocks.push(
    jsonld.breadcrumbs([
      ...row.breadcrumbs.map((b) => ({
        name: b.anchor,
        url: `${m.siteOrigin}${b.path === '/' ? '' : b.path}`,
      })),
      { name: row.h1, url: row.canonical },
    ]),
  );
}
blocks.push(...extraJsonLd);
---

<title>{row.title}</title>
{row.metaDescription && <meta name="description" content={row.metaDescription} />}
<link rel="canonical" href={row.canonical} />
{row.noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={s.type ?? 'website'} />
<meta property="og:site_name" content="MrMoverPacker" />
<meta property="og:locale" content="en_IN" />
<meta property="og:title" content={row.title} />
{row.metaDescription && <meta property="og:description" content={row.metaDescription} />}
<meta property="og:url" content={row.canonical} />
<meta property="og:image" content={shareImage} />
{s.width && <meta property="og:image:width" content={String(s.width)} />}
{s.height && <meta property="og:image:height" content={String(s.height)} />}
{s.alt && <meta property="og:image:alt" content={s.alt} />}
{s.published && <meta property="article:published_time" content={s.published} />}
{s.modified && <meta property="article:modified_time" content={s.modified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content={themeColor} />

{
  /* Search Console ownership — home page only, per Google's instruction. Google:
    "don't remove the meta tag, even after verification succeeds". */
}
{
  row.pageType === 'home' && (
    <meta name="google-site-verification" content="wFoitKdfylsmjDu2MRfY9AZ5JBZml0_ypGKtvzsPGHs" />
  )
}

<JsonLd blocks={blocks} />
