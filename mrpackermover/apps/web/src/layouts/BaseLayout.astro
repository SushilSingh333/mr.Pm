---
import type { ManifestRow } from '@mpm/shared';
import Seo from '../components/seo/Seo.astro';
import Analytics from '../components/seo/Analytics.astro';
import SiteIcons from '../components/seo/SiteIcons.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import WhatsAppFab from '../components/nav/WhatsAppFab.astro';
import FocusChrome from '../components/account/FocusChrome.astro';
import '../styles/global.css';
import type { Share } from '../lib/share.js';

/**
 * Base HTML shell for every page. Zero JS by default (Doc 02 §10) — only the
 * header toggle and any hydrated island ship script. Fonts are self-hosted woff2
 * (ADR-0002); until the licence-clean pair is pinned, the token fallbacks (system
 * serif/grotesk) render, so there is never an invisible-text or blocking request.
 */
interface Props {
  row: ManifestRow;
  extraJsonLd?: Array<Record<string, unknown> | null>;
  /** What a shared link shows; blank uses the page's banner photo (lib/share.ts). */
  share?: Share;
  /**
   * `focus`: the account pages' frame, Google-sign-in style. Only the logo, a help link
   * and the account avatar on top, and a one-line footer: no menu, no big footer and no
   * WhatsApp button competing with the one form on the page.
   */
  chrome?: 'full' | 'focus';
}
const { row, extraJsonLd, share, chrome = 'full' } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    {/* First, always: a browser only looks for the charset in the first 1024 bytes. */}
    <meta charset="utf-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteIcons />
    {
      /* Self-hosted fonts get preloaded here once pinned (ADR-0002):
         <link rel="preload" href="/fonts/fraunces-subset.woff2" as="font" type="font/woff2" crossorigin /> */
    }
    <Seo row={row} extraJsonLd={extraJsonLd} share={share} />
    {
      /* For a page that must run something in <head> in a particular order relative to
        the tags above - the thank-you page sets Meta advanced matching here, which has
        to happen after the pixel is initialised and before any event is tracked. */
    }
    <slot name="head" />
  </head>
  <body>
    {
      /* Cloudflare's Email Address Obfuscation rewrites every address on the page and adds
        a render-blocking script to decode them again (about a second on a phone in
        PageSpeed). These markers tell Cloudflare to leave the page's addresses alone; our
        one address is published on purpose. */
    }
    <!--email_off-->
    <a href="#main" class="skip-link">Skip to content</a>
    {
      chrome === 'focus' ? (
        <FocusChrome>
          <slot />
        </FocusChrome>
      ) : (
        <>
          <Header />
          <main id="main">
            <slot />
          </main>
          <Footer />
          <WhatsAppFab />
        </>
      )
    }
    <!--/email_off-->
  </body>
</html>
