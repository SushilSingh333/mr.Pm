---
import { iconSvg } from '../../lib/icons.js';

/**
 * A responsive grid of feature/step cards. Each item is an icon badge + title +
 * body. `numbered` swaps the icon for a step number (for "how it works" flows).
 */
export interface FeatureItem {
  icon?: string;
  title: string;
  body: string;
}
interface Props {
  items: FeatureItem[];
  columns?: 2 | 3 | 4;
  numbered?: boolean;
}
const { items, columns = 3, numbered = false } = Astro.props;
---

<ul class:list={['feature-grid', `cols-${columns}`]} role="list">
  {
    items.map((item, i) => (
      <li class="feature-card">
        {numbered ? (
          <span class="fc-num">{i + 1}</span>
        ) : (
          <span class="fc-icon">
            <svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={iconSvg(item.icon ?? 'check')}
            />
          </span>
        )}
        <h3>{item.title}</h3>
        <p set:html={item.body} />
      </li>
    ))
  }
</ul>

<style>
  .feature-grid {
    list-style: none;
    display: grid;
    gap: 1.25rem;
    max-width: 1120px;
    margin-inline: auto;
  }
  .cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }
  .feature-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
  }
  .fc-icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: var(--radius-md);
    background: linear-gradient(140deg, var(--color-navy-600), var(--color-navy-800));
    color: #fff;
    box-shadow: 0 6px 16px rgba(9, 35, 65, 0.28);
    margin-bottom: 0.3rem;
  }
  .fc-num {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-lg);
    margin-bottom: 0.3rem;
  }
  .feature-card h3 {
    font-size: var(--text-xl);
  }
  .feature-card p {
    color: var(--color-ink-500);
    flex: 1;
  }
  .feature-card :global(a) {
    color: var(--color-brand-700);
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .cols-3,
    .cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cols-2,
    .cols-3,
    .cols-4 {
      grid-template-columns: 1fr;
    }
  }
</style>
