# ─────────────────────────────────────────────────────────────────────────────
# MrMoverPacker — environment template. Copy to `.env` and fill in real values.
# Never commit `.env`. All secrets are read through `packages/db` and app configs
# so no provider detail leaks into feature code (see docs/runbook.md §portability).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (absolute, no trailing slash). Used for canonicals + sitemaps.
#
# This single value decides the domain of every canonical, every sitemap entry and
# the JSON-LD, because build-manifest bakes it into manifest.json at build time.
# Changing the domain therefore means: change this, rebuild the manifest, rebuild
# the site. Changing it WITHOUT rebuilding leaves the old domain in the canonicals,
# which tells Google the new site is a copy of the old one.
PUBLIC_SITE_URL=http://localhost:4321

# Caddy only (deploy/Caddyfile). SITE_DOMAIN is the live host.
# SITE_DOMAIN=mrmoverpacker.com
#
# OLD_SITE_DOMAIN would name a previous domain kept alive only to 301 its URLs to
# the new ones. Unused: mrpackermover.com is being retired, not redirected. Its
# Caddy block is commented out rather than removed, because an unset variable
# expands to an empty site address and Caddy will not start on that.

# ── Database ────────────────────────────────────────────────────────────────
# Standard Postgres connection string. Portable across Neon / Supabase / RDS /
# self-hosted. PostGIS must be available on the target. This is the ONLY line
# that changes when migrating database providers.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Payload CMS ─────────────────────────────────────────────────────────────
# 32+ char random string. Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# ── Cloudflare (cache purge on publish — ADR-0005) ──────────────────────────
# Cloudflare is a cache-only CDN in front of the DigitalOcean origin. A token with
# the "Zone → Cache Purge" permission lets deploys refresh the edge (scripts/purge-cache.mjs).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Turnstile (quote form anti-spam; never Bot Fight Mode) ──────────────────
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Maps (quote estimator distance + address autocomplete, CMS geocoding) ──
# WEB (apps/web/.env): browser key — enable Maps JavaScript API + Places API +
#   Distance Matrix API; restrict by HTTP referrer to your domain(s). Without it the
#   estimator falls back to a built-in distance estimate.
PUBLIC_GOOGLE_MAPS_API_KEY=
# CMS (apps/cms/.env): server key — enable Geocoding API; auto-fills a city's lat/lng
#   from its name so editors don't type coordinates. Can be the same key or a server-
#   restricted one. Without it, lat/lng just stay blank (optional).
GOOGLE_MAPS_API_KEY=

# ── Cloudinary (Media storage — signed, server-side; CMS only) ──────────────
# When all three are set, CMS Media uploads (incl. a city's Hero image) go to
# Cloudinary and are served/resized from its CDN via URL transforms. Uploads are
# signed with the API secret server-side — no browser upload preset to abuse.
# Leave blank to keep Media on the droplet's local disk (design/CI). Find these in
# Cloudinary → Dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional base folder for all uploads (default: mrpackermover).
CLOUDINARY_FOLDER=

# ── Build pipeline ──────────────────────────────────────────────────────────
# Shared secret + URL the Payload afterChange hook uses to trigger a rebuild/deploy.
BUILD_TRIGGER_TOKEN=
BUILD_WEBHOOK_URL=
