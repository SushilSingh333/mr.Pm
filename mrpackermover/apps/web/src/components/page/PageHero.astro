---
import type { ManifestLink } from '@mpm/shared';
import { cldUrl, CLD_TRANSFORM } from '@mpm/shared';
import Breadcrumbs from '../nav/Breadcrumbs.astro';
import { heroAlt } from '../../lib/hero.js';

/**
 * Interior-page hero — centered, to match the rest of the site (Doc 01: pages read
 * centered, Porter-style). Light on the cool base, or a deep-navy variant; the
 * crimson brand appears only as an accent (the eyebrow pill, a soft glow), never as
 * the whole background. CTAs go in the default slot.
 */
interface Props {
  eyebrow?: string;
  h1: string;
  intro?: string;
  dark?: boolean;
  breadcrumbs?: ManifestLink[];
  current?: string;
  /**
   * Static-file convention, matching HeroShell: /images/hero/<image>.jpg. Used when
   * the CMS has no upload for this page. Omit both and the hero stays a flat gradient.
   */
  image?: string;
  /** Overrides the description looked up from `image`. Needed for CMS uploads. */
  imageAlt?: string;
  /** CMS-uploaded hero background (Cloudinary) — takes precedence over `image`. */
  imageUrl?: string;
}
const {
  eyebrow,
  h1,
  intro,
  dark = false,
  breadcrumbs = [],
  current,
  image,
  imageUrl,
  imageAlt,
} = Astro.props;
const hasCta = Astro.slots.has('default');
// A photo forces the dark treatment - the light gradient has no scrim, so dark text
// over a photograph would be unreadable.
// A CMS upload wins; otherwise fall back to the committed artwork — same precedence
// as HeroShell. `cldUrl` adds the delivery transform and is a no-op for a local path.
const resolvedImage = imageUrl
  ? cldUrl(imageUrl, CLD_TRANSFORM.hero)
  : image
    ? `/images/hero/${image}.jpg`
    : null;
const hasImage = Boolean(resolvedImage);
const isDark = dark || hasImage;

/**
 * The banner photograph, as sources for a <picture> - same reasoning as HeroShell:
 * a CSS background cannot be indexed by image search or described to a screen
 * reader. A Cloudinary URL is transformed on delivery and has no local variants.
 */
const pheroSources =
  imageUrl || !image
    ? { fallback: resolvedImage, narrow: null, full: null }
    : {
        fallback: `/images/hero/${image}.jpg`,
        narrow: `/images/hero/${image}-narrow.webp`,
        full: `/images/hero/${image}-full.webp`,
      };
const alt = imageAlt ?? (image ? heroAlt(image) : '');
---

<section class:list={['phero', { dark: isDark, 'has-image': hasImage }]}>
  {
    hasImage && (
      <div class="phero-photo">
        <picture>
          {pheroSources.full && (
            <source type="image/webp" media="(min-width: 900px)" srcset={pheroSources.full} />
          )}
          {pheroSources.narrow && <source type="image/webp" srcset={pheroSources.narrow} />}
          <img
            src={pheroSources.fallback}
            alt={alt}
            width="1920"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    )
  }
  <span class="phero-glow" aria-hidden="true"></span>
  <div class="container-page phero-inner">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} current={current ?? h1} />}
    {
      eyebrow && (
        <span class="phero-eyebrow">
          <span class="dot" aria-hidden="true" />
          {eyebrow}
        </span>
      )
    }
    <h1 class="phero-title">{h1}</h1>
    {intro && <p class="phero-lead">{intro}</p>}
    {
      hasCta && (
        <div class="phero-cta">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.75rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--color-line);
    background:
      radial-gradient(90% 80% at 50% -20%, var(--color-surface-3), transparent 70%),
      linear-gradient(180deg, var(--color-surface-2), var(--color-surface) 90%);
  }
  .phero-inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .phero :global(.breadcrumbs ol) {
    justify-content: center;
    padding-block: 0 0.5rem;
  }

  .phero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-brand-700);
    background: var(--color-brand-50);
    border: 1px solid color-mix(in oklab, var(--color-brand-300) 45%, transparent);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.1rem;
  }
  .phero-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-600);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-brand-500) 25%, transparent);
  }

  .phero-title {
    font-size: clamp(2rem, 5vw, var(--text-5xl));
    max-width: 22ch;
    letter-spacing: -0.02em;
  }
  .phero-lead {
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 2.2vw, var(--text-xl));
    color: var(--color-ink-500);
    max-width: 60ch;
  }
  /* The hero backdrop is royal blue and .btn-primary is that same royal blue,
     so the solid CTA disappeared into it after the brand change. Invert to a
     white plate with brand text — 11:1 against the gradient either way. */
  .phero-cta :global(.btn-primary) {
    background: #fff;
    color: var(--color-brand-700);
  }
  .phero-cta :global(.btn-primary:hover) {
    background: var(--color-brand-50);
    color: var(--color-brand-800);
  }

  .phero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.9rem;
  }

  /* A single soft accent glow — the only place crimson touches the backdrop. */
  .phero-glow {
    position: absolute;
    top: -140px;
    left: 50%;
    transform: translateX(-50%);
    width: min(680px, 90%);
    height: 300px;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      color-mix(in oklab, var(--color-brand-400) 16%, transparent),
      transparent 70%
    );
  }

  /* ── Deep navy variant ──────────────────────────────────────────────────── */
  .phero.dark {
    border-bottom: 0;
    /* Deepened one step down the navy scale (900 -> 800, glow 500 -> 600) so the
       interior heroes read as a rich brand blue rather than a bright one, and sit
       in the same tonal family as the footer. Still a gradient, just darker. */
    background:
      radial-gradient(80% 70% at 50% -20%, var(--color-navy-600), transparent 65%),
      linear-gradient(180deg, var(--color-navy-900), var(--color-navy-800));
  }
  /* CMS photo. Sits under a dark scrim so the white heading keeps its contrast
     whatever the editor uploads - same approach as the home hero. */
  .phero.has-image {
    /* Kept so the banner is navy, not white, for the moment before the photo
       decodes - what the background-color did before. */
    background-color: var(--color-navy-700);
    border-bottom: 0;
  }
  /* The photograph, and the scrim that used to ride along inside the same
     `background-image` shorthand. `object-fit: cover` + `object-position: center`
     reproduce `background-size: cover` + `background-position: center` exactly, so
     the crop is unchanged.

     The scrim is ::after on this wrapper rather than on .phero: as an absolutely
     positioned pseudo-element of the wrapper it paints directly over the <img> and
     under everything else, which is the same layer the gradient occupied when it was
     the first background layer. */
  .phero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .phero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .phero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.42));
  }
  .phero.has-image .phero-glow {
    display: none;
  }

  .phero.dark .phero-glow {
    top: -120px;
    background: radial-gradient(
      ellipse at center,
      color-mix(in oklab, var(--color-brand-500) 32%, transparent),
      transparent 68%
    );
    opacity: 0.45;
  }
  .phero.dark .phero-title {
    color: #fff;
  }
  .phero.dark .phero-lead {
    color: rgba(255, 255, 255, 0.82);
  }
  .phero.dark .phero-eyebrow {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.22);
  }
  .phero.dark .phero-eyebrow .dot {
    background: var(--color-brand-400);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-brand-400) 30%, transparent);
  }
  .phero.dark :global(.breadcrumbs a),
  .phero.dark :global(.breadcrumbs [aria-current='page']) {
    color: rgba(255, 255, 255, 0.72);
  }
  .phero.dark :global(.breadcrumbs .sep) {
    color: rgba(255, 255, 255, 0.3);
  }
</style>
