---
import { PHONE_DISPLAY, PHONE_TEL, WHATSAPP_HREF } from '../../lib/site.js';

/**
 * The FAQs as a band on the page's centre line: the heading centred, then every question
 * as its own card, two across on a laptop. A question opens in place with a +/× toggle,
 * the open card lifts and turns brand-tinted, and opening one closes the others, like
 * Google's own help pages. Under the cards, a quiet line for anyone whose question is not
 * there: call or WhatsApp.
 *
 * Answers arrive as escaped HTML paragraphs (lib/rich-text.ts).
 */
interface Props {
  heading: string;
  faqs: { question: string; html: string[] }[];
  /** White or tinted, to carry on the sections' alternation. */
  tone?: 'white' | 'tint';
}
const { heading, faqs, tone = 'white' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class:list={['gb', { 'gb--tint': tone === 'tint' }]} aria-label="Questions">
      <h2 class="gb-h2" id="faqs">
        {heading || 'Questions'}
      </h2>
      <div class="gsv-faqs">
        {faqs.map((f) => (
          <details class="gsv-faq">
            <summary>
              <span class="gsv-faq__q">{f.question}</span>
              <span class="gsv-faq__x" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20">
                  <path
                    d="M12 5v14M5 12h14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>
            <div class="gsv-faq__a">
              {f.html.map((h) => (
                <p set:html={h} />
              ))}
            </div>
          </details>
        ))}
      </div>
      <div class="gsv-faq-help">
        <p>Still have a question? Ask a real person.</p>
        <div class="gsv-faq-help__actions">
          <a href={`tel:${PHONE_TEL}`}>
            <svg viewBox="0 -960 960 960" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M798-120q-125 0-247-54.5T329-329Q229-429 174.5-551T120-798q0-18 12-30t30-12h162q14 0 25 9.5t13 22.5l26 140q2 16-1 27t-11 19l-97 98q20 37 47.5 71.5T387-386q31 31 65 57.5t72 48.5l94-94q9-9 23.5-13.5T670-390l138 28q14 4 23 14.5t9 23.5v162q0 18-12 30t-30 12Z"
              />
            </svg>
            {PHONE_DISPLAY}
          </a>
          <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.03c-.25.69-1.43 1.33-1.98 1.38-.51.05-1 .24-3.36-.7-2.84-1.12-4.65-4.03-4.79-4.22-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07.99-2.35.25-.28.55-.35.74-.35l.53.01c.17.01.4-.06.62.48.25.6.84 2.06.92 2.2.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.17-.3.37-.42.5-.14.14-.29.29-.12.57.17.28.73 1.2 1.57 1.95 1.08.96 1.99 1.26 2.27 1.4.28.14.45.12.61-.07.17-.19.71-.83.9-1.11.19-.28.37-.23.63-.14.25.09 1.62.76 1.9.9.28.14.46.21.53.32.07.12.07.67-.18 1.36Z"
              />
            </svg>
            WhatsApp us
          </a>
        </div>
      </div>
    </section>
  )
}

<script>
  const faqs = [...document.querySelectorAll<HTMLDetailsElement>('.gsv-faq')];
  for (const d of faqs) {
    d.addEventListener('toggle', () => {
      if (d.open) for (const o of faqs) if (o !== d) o.open = false;
    });
  }
</script>

<style>
  /* A full-width band on the page's centre line, white or tinted to carry on the
     sections' alternation (the page passes `tone`). */
  .gb {
    padding: clamp(3rem, 6vw, 4.75rem) 1.25rem;
    background: #fff;
  }
  .gb--tint {
    background: var(--g-surface-2);
  }
  .gb-h2 {
    margin: 0 auto;
    max-width: 36rem;
    font-size: clamp(1.625rem, 3vw, 2.375rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--g-ink);
    text-wrap: balance;
  }

  /* ── The questions: one card each, two across ── */
  .gsv-faqs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 0.75rem;
    max-width: calc(var(--container-page) - 2.5rem);
    margin: 2rem auto 0;
  }
  .gsv-faq {
    border: 1px solid var(--g-outline);
    border-radius: 1.25rem;
    background: #fff;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .gsv-faq:hover {
    border-color: var(--color-brand-100);
  }
  .gsv-faq[open] {
    border-color: var(--color-brand-100);
    box-shadow:
      0 1px 3px rgb(60 64 67 / 0.1),
      0 10px 24px rgb(60 64 67 / 0.1);
  }
  .gsv-faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 1rem 1rem 1rem 1.35rem;
    border-radius: 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .gsv-faq summary::-webkit-details-marker {
    display: none;
  }
  .gsv-faq summary:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .gsv-faq__q {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--g-ink);
  }
  .gsv-faq[open] .gsv-faq__q {
    color: var(--color-brand-700);
  }
  /* A tonal round button: + to open, turning to × once open. */
  .gsv-faq__x {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--g-surface-2);
    color: var(--g-ink-2);
    transition:
      transform 0.25s,
      background-color 0.2s,
      color 0.2s;
  }
  .gsv-faq summary:hover .gsv-faq__x {
    background: var(--color-brand-50);
    color: var(--color-brand-600);
  }
  .gsv-faq[open] .gsv-faq__x {
    transform: rotate(45deg);
    background: var(--color-brand-600);
    color: #fff;
  }
  .gsv-faq__a {
    padding: 0 1.35rem 1.25rem;
  }
  .gsv-faq__a p {
    margin: 0 0 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--g-ink-2);
  }
  .gsv-faq__a p:last-child {
    margin-bottom: 0;
  }
  .gsv-faq__a :global(a) {
    color: var(--color-brand-600);
    font-weight: 500;
    text-decoration: none;
  }
  .gsv-faq__a :global(a:hover) {
    text-decoration: underline;
  }

  /* ── Still have a question? ── */
  .gsv-faq-help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
    text-align: center;
  }
  .gsv-faq-help p {
    margin: 0;
    font-size: 1rem;
    color: var(--g-ink-2);
  }
  .gsv-faq-help__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .gsv-faq-help a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.5rem;
    padding: 0 1.1rem 0 0.95rem;
    border: 1px solid var(--g-outline-strong);
    border-radius: 999px;
    background: #fff;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-brand-700);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .gsv-faq-help a:hover {
    background: var(--color-brand-50);
  }
  .gsv-faq-help a:focus-visible {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .gsv-faqs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .gsv-faq summary {
      padding-left: 1.1rem;
    }
    .gsv-faq__a {
      padding: 0 1.1rem 1.1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gsv-faq__x {
      transition: none;
    }
  }

  /* Hover: a closed question lifts a little; the open one already stands out. */
  .gsv-faq {
    transition:
      transform 0.2s cubic-bezier(0.2, 0, 0, 1),
      border-color 0.2s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.2s cubic-bezier(0.2, 0, 0, 1);
  }
  .gsv-faq:not([open]):hover {
    box-shadow:
      0 2px 4px rgb(60 64 67 / 0.06),
      0 8px 20px rgb(60 64 67 / 0.08);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .gsv-faq {
      transition: none;
    }
    .gsv-faq:not([open]):hover {
      transform: none;
    }
  }
</style>
