# ─────────────────────────────────────────────────────────────────────────────
# MrPackerMover — environment template. Copy to `.env` and fill in real values.
# Never commit `.env`. All secrets are read through `packages/db` and app configs
# so no provider detail leaks into feature code (see docs/runbook.md §portability).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (absolute, no trailing slash). Used for canonicals + sitemaps.
PUBLIC_SITE_URL=http://localhost:4321

# ── Database ────────────────────────────────────────────────────────────────
# Standard Postgres connection string. Portable across Neon / Supabase / RDS /
# self-hosted. PostGIS must be available on the target. This is the ONLY line
# that changes when migrating database providers.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Payload CMS ─────────────────────────────────────────────────────────────
# 32+ char random string. Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# ── Cloudflare (cache purge on publish — ADR-0005) ──────────────────────────
# Cloudflare is a cache-only CDN in front of the DigitalOcean origin. A token with
# the "Zone → Cache Purge" permission lets deploys refresh the edge (scripts/purge-cache.mjs).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Turnstile (quote form anti-spam; never Bot Fight Mode) ──────────────────
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Maps (quote estimator distance + address autocomplete, CMS geocoding) ──
# WEB (apps/web/.env): browser key — enable Maps JavaScript API + Places API +
#   Distance Matrix API; restrict by HTTP referrer to your domain(s). Without it the
#   estimator falls back to a built-in distance estimate.
PUBLIC_GOOGLE_MAPS_API_KEY=
# CMS (apps/cms/.env): server key — enable Geocoding API; auto-fills a city's lat/lng
#   from its name so editors don't type coordinates. Can be the same key or a server-
#   restricted one. Without it, lat/lng just stay blank (optional).
GOOGLE_MAPS_API_KEY=

# ── Build pipeline ──────────────────────────────────────────────────────────
# Shared secret + URL the Payload afterChange hook uses to trigger a rebuild/deploy.
BUILD_TRIGGER_TOKEN=
BUILD_WEBHOOK_URL=
