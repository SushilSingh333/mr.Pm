---
import type { ServiceHubData } from '@mpm/shared';
import { jsonld } from '@mpm/seo';
import { rowsOfType, dataOf } from '../../data/manifest.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBanner from '../../components/sections/HeroBanner.astro';
import Band from '../../components/ui/Band.astro';
import Breadcrumbs from '../../components/nav/Breadcrumbs.astro';
import Inclusions from '../../components/sections/Inclusions.astro';
import RelatedLinks from '../../components/sections/RelatedLinks.astro';
import ValueProps from '../../components/sections/ValueProps.astro';
import { SITE_ORIGIN } from '../../lib/site.js';
import { heroForService } from '../../lib/hero.js';

/** National service hub — parent of the city × service matrix. */
export function getStaticPaths() {
  return rowsOfType('service-hub')
    .filter((row) => row.path.startsWith('/services/'))
    .map((row) => ({ params: { service: row.slug }, props: { row } }));
}

const { row } = Astro.props;
const data = dataOf<ServiceHubData>(row);

// "Cities we serve" shows only the cities that actually offer this service (group
// 'cities'); sibling-service links live in relatedLinks for the link graph but aren't
// listed here. A city that didn't check this service is never shown → no 404.
const cityLinks = row.relatedLinks.filter((l) => l.group === 'cities');

const extraJsonLd = [
  jsonld.service({
    siteOrigin: SITE_ORIGIN,
    name: `${data.serviceName} in India`,
    areaServed: 'India',
  }),
];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  <div class="container-page">
    <Breadcrumbs items={row.breadcrumbs} current={data.serviceName} />
  </div>

  <HeroBanner
    badge={data.serviceName}
    h1={row.h1}
    intro={data.summary ??
      `${data.serviceName} handled by our own trained crews, with a fixed written quote and transit insurance.`}
    image={heroForService(row.slug)}
    prefillService={data.serviceName}
  />

  <Band label="Why us"><ValueProps /></Band>

  <Band alt label="Scope">
    <div class="section-head"><h2>What's included</h2></div>
    <Inclusions inclusions={data.inclusions} exclusions={data.exclusions} />
  </Band>

  {
    cityLinks.length > 0 && (
      <Band label="Cities">
        <div class="section-head">
          <h2>Cities we serve</h2>
        </div>
        <RelatedLinks links={cityLinks} heading="Cities we serve" />
      </Band>
    )
  }
</BaseLayout>
