{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "PAYLOAD_SECRET",
    "PUBLIC_SITE_URL",
    "CF_HYPERDRIVE_ID",
    "TURNSTILE_SECRET_KEY",
    "PUBLIC_TURNSTILE_SITE_KEY"
  ],
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "seed": {
      "cache": false
    },
    "migrate": {
      "cache": false
    }
  }
}
