# Payload/Next and some native deps resolve more reliably when hoisted.
public-hoist-pattern[]=*payload*
public-hoist-pattern[]=*next*
public-hoist-pattern[]=*sharp*
strict-peer-dependencies=false
auto-install-peers=true
# CI runs an explicit frozen install; don't re-run an implicit install before every script.
verify-deps-before-run=false
