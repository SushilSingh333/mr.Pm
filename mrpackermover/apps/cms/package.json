{
  "name": "@mpm/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "generate:types": "payload generate:types && node ./scripts/copy-types.mjs",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "build-manifest": "tsx src/scripts/build-manifest.ts",
    "set-city-services": "tsx src/scripts/set-city-services.ts",
    "backfill-service-scope": "tsx src/scripts/backfill-service-scope.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mpm/db": "workspace:*",
    "@mpm/seo": "workspace:*",
    "@mpm/shared": "workspace:*",
    "@payloadcms/db-postgres": "^3.37.0",
    "@payloadcms/next": "^3.37.0",
    "@payloadcms/richtext-lexical": "^3.37.0",
    "@payloadcms/ui": "^3.37.0",
    "graphql": "^16.9.0",
    "next": "^15.1.6",
    "payload": "^3.37.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@mpm/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
