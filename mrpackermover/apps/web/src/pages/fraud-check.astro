---
import { jsonld } from '@mpm/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import Band from '../components/ui/Band.astro';
import FeatureGrid from '../components/page/FeatureGrid.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBand from '../components/page/CtaBand.astro';
import { staticRow, editorialFor } from '../lib/page.js';

const ed = editorialFor('fraud-check');
const row = staticRow({
  path: '/fraud-check',
  pageType: 'trust',
  title: ed.metaTitle ?? 'Fraud Check – Avoid Moving Scams | MrPackerMover',
  h1: ed.title ?? 'Don’t get scammed by a fake mover',
  metaDescription:
    ed.seoDescription ??
    'How to spot packers-and-movers fraud in India — advance-fee scams, bait quotes, fake listings and hostage-goods tricks — and how to verify a mover before you pay.',
  breadcrumbs: [{ path: '/', anchor: 'Home' }],
});

const scams = [
  {
    icon: 'rupee',
    title: 'The advance-fee trap',
    body: 'A large “booking deposit” demanded upfront to a personal account or UPI — then the “mover” vanishes. Legitimate movers take a token advance against a written, GST quote.',
  },
  {
    icon: 'tag',
    title: 'The bait quote',
    body: 'A phone price far below everyone else, with no survey. On moving day it balloons, or your goods are held until you pay “extra charges”. A fixed written quote after a survey is the antidote.',
  },
  {
    icon: 'search',
    title: 'The look-alike listing',
    body: 'A fake page copies a real company’s name, reviews and even photos. The name on the invoice won’t match the registration. Always check the GSTIN and CIN against the name.',
  },
  {
    icon: 'lock',
    title: 'Hostage goods',
    body: 'Your belongings are loaded, then the price jumps and the truck won’t move until you pay. A written, itemised quote agreed in advance removes the leverage entirely.',
  },
];

const checklist = [
  {
    title: 'Insist on a survey & written quote',
    body: 'No real fixed price exists without someone seeing your goods. If a quote arrives with no survey, be cautious.',
  },
  {
    title: 'Verify the registration',
    body: 'Match the GSTIN and CIN on the quote to the company name on the official portals. See our <a href="/company/licences">licences &amp; GST</a> page for how.',
  },
  {
    title: 'Pay the company, on record',
    body: 'Prefer traceable payment against a GST invoice. Be wary of large cash or personal-account transfers demanded upfront.',
  },
  {
    title: 'Match the crew & vehicle',
    body: 'On the day, check the crew IDs and vehicle number against what you were sent. Our <a href="/verify">verify-us</a> guide walks through it.',
  },
];

const faqs = [
  {
    question: 'How do I know a MrPackerMover listing is really us?',
    answer:
      'The GSTIN and CIN on your quote should match our registered name exactly — check them on the government portals. We use one legal identity, never a set of similar-sounding local names. If something looks off, contact us and we will confirm.',
  },
  {
    question: 'I think I have been scammed by a mover. What do I do?',
    answer:
      'Stop further payments immediately, gather all communication and receipts, and report it: file a complaint on the National Cyber Crime portal (cybercrime.gov.in) or call 1930 for financial fraud, and lodge a police complaint. If the listing impersonated us, tell us so we can act on it.',
  },
  {
    question: 'Someone is using your brand name. Can you help?',
    answer:
      'Yes. Report the fake listing or message to us with a screenshot and any contact details. We investigate impersonation reports and pursue takedowns where we can.',
  },
];

const extraJsonLd = [jsonld.faqPage(faqs)];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  <PageHero
    dark
    eyebrow={ed.eyebrow ?? 'Stay safe'}
    h1={row.h1}
    intro={ed.intro ??
      'Moving fraud is common, and it preys on people at their most stressed. Here are the scams to know, the checks that stop them, and what to do if you’re targeted — whether or not it involves us.'}
    breadcrumbs={row.breadcrumbs}
    current="Fraud check"
  />

  <Band label="Common scams">
    <div class="section-head">
      <h2>Four scams worth recognising</h2>
      <p>They rely on urgency and a low first number. Slow down, and they fall apart.</p>
    </div>
    <FeatureGrid items={scams} columns={2} />
  </Band>

  <Band alt label="Protect yourself">
    <div class="section-head">
      <h2>Your four-step fraud check</h2>
      <p>Do these before you pay anyone — us included.</p>
    </div>
    <FeatureGrid items={checklist} columns={4} numbered />
  </Band>

  <Band label="Report">
    <div class="report-box card">
      <h2>Report fraud</h2>
      <p>If you’ve been targeted by moving fraud in India, act quickly:</p>
      <ul class="report-list">
        <li>
          <strong>Financial fraud helpline:</strong> call <strong>1930</strong> as soon as possible.
        </li>
        <li>
          <strong>Cyber Crime portal:</strong> file at <span class="muted">cybercrime.gov.in</span>.
        </li>
        <li><strong>Local police:</strong> lodge a written complaint with all evidence.</li>
        <li>
          <strong>Impersonating us?</strong>
          <a href="/company/contact">Tell our team</a> with a screenshot — we investigate every report.
        </li>
      </ul>
    </div>
  </Band>

  <Band alt label="Fraud FAQ">
    <Faq faqs={faqs} heading="Fraud-check questions, answered" />
  </Band>

  <CtaBand
    heading="Deal with a mover you can verify"
    text="Every claim on our site is checkable — the company, the crew and the vehicle. Start with a fixed quote from a registered entity."
    primaryLabel="Get a fixed quote"
    primaryHref="/get-quote"
    secondaryLabel="How to verify us"
    secondaryHref="/verify"
  />
</BaseLayout>

<style>
  .report-box {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  .report-box h2 {
    font-size: clamp(1.35rem, 3vw, var(--text-2xl));
    margin-bottom: 0.75rem;
  }
  .report-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1rem;
  }
  .report-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-ink-700);
  }
  .report-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-brand-600);
    font-weight: 700;
  }
  .report-list strong {
    color: var(--color-ink-900);
  }
</style>
