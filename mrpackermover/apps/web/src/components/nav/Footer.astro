---
import { manifest, rowsOfType } from '../../data/manifest.js';
import type { CityHubData } from '@mpm/shared';
import { FOOTER_SERVICES, FOOTER_COMPANY, FOOTER_TRUST } from '../../lib/site.js';
import Logo from './Logo.astro';

/**
 * Footer, in Porter's structure but adapted to what we actually have: no app
 * download (we have no app), no "Countries" (India only). Carries the legal
 * identity on every page (Doc 01 §2): registered entity, GSTIN, CIN — not just a
 * phone number. Cities are the serviceable cities from the manifest.
 */
const org = manifest().org;
const cityLinks = rowsOfType('city-hub').map((r) => ({
  path: r.path,
  name: (r.data as unknown as CityHubData).cityName,
}));

const ICONS: Record<string, string> = {
  linkedin:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 102.5 6 2.5 2.5 0 004.98 3.5zM3 8.98h4V21H3zM9 8.98h3.8v1.64h.05a4.17 4.17 0 013.75-2.06c4 0 4.75 2.64 4.75 6.06V21h-4v-5.36c0-1.28 0-2.92-1.78-2.92s-2.05 1.39-2.05 2.83V21H9z"/></svg>',
  facebook:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"/></svg>',
  instagram:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  youtube:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 00-1.77-1.77C19.34 5 12 5 12 5s-7.34 0-8.83.53A2.5 2.5 0 001.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 001.77 1.77C4.66 19 12 19 12 19s7.34 0 8.83-.53a2.5 2.5 0 001.77-1.77C23 15.2 23 12 23 12zm-13 3V9l5 3z"/></svg>',
};
const socialIcon = (name: string): string => ICONS[name] ?? '';

const socials = [
  { label: 'LinkedIn', href: org?.sameAs?.[0] ?? '#', icon: 'linkedin' },
  { label: 'Facebook', href: '#', icon: 'facebook' },
  { label: 'Instagram', href: '#', icon: 'instagram' },
  { label: 'YouTube', href: '#', icon: 'youtube' },
];
---

<footer class="site-footer">
  <div class="container-page footer-top">
    <div class="footer-brand">
      <Logo light />
      <p class="footer-tagline">
        Fixed quotes, verified crews, and claims data we actually publish. We serve the areas listed
        below — we don't claim offices we don't have.
      </p>
      <div class="footer-social">
        <span class="follow">Follow us on</span>
        <div class="social-row">
          {
            socials.map((s) => (
              <a
                href={s.href}
                class="social"
                aria-label={s.label}
                rel="noopener"
                set:html={socialIcon(s.icon)}
              />
            ))
          }
        </div>
      </div>
    </div>

    <nav class="footer-col" aria-label="Company">
      <h2 class="footer-heading">Company</h2>
      <ul>
        {
          FOOTER_COMPANY.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Services">
      <h2 class="footer-heading">Services</h2>
      <ul>
        {
          FOOTER_SERVICES.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Support">
      <h2 class="footer-heading">Support</h2>
      <ul>
        {
          FOOTER_TRUST.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {
    cityLinks.length > 0 && (
      <div class="container-page footer-cities">
        <h2 class="footer-heading">Cities we serve</h2>
        <ul class="cities-list">
          {cityLinks.map((c) => (
            <li>
              <a href={c.path}>{c.name}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="container-page footer-legal">
    <h2 class="footer-heading">Registered office</h2>
    {
      org ? (
        <p class="legal-lines">
          <strong>{org.legalName}</strong>
          <span>{org.registeredOffice}</span>
          <span>
            GSTIN {org.gstin} · CIN {org.cin}
          </span>
          {org.phone && <span>Phone: {org.phone}</span>}
        </p>
      ) : (
        <p class="legal-lines">Registered entity, GSTIN and CIN appear here.</p>
      )
    }
    <p class="footer-fine">
      © {new Date().getFullYear()} MrPackerMover. Reviews are tied to real job references. We publish
      no physical premises; serviceability is proven with completed-job data.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: #0b1220;
    color: color-mix(in oklab, white 76%, #0b1220);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.7fr repeat(3, 1fr);
    gap: 2rem;
    padding-block: 3.5rem 2.5rem;
  }
  .footer-tagline {
    margin-top: 1.1rem;
    max-width: 36ch;
    font-size: var(--text-sm);
    color: color-mix(in oklab, white 60%, #0b1220);
  }
  .footer-social {
    margin-top: 1.5rem;
  }
  .follow {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: color-mix(in oklab, white 70%, #0b1220);
    margin-bottom: 0.6rem;
  }
  .social-row {
    display: flex;
    gap: 0.6rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in oklab, white 18%, #0b1220);
    color: color-mix(in oklab, white 82%, #0b1220);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .social:hover {
    background: var(--color-brand-600);
    color: #fff;
    border-color: var(--color-brand-600);
  }
  .footer-heading {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    margin-bottom: 1rem;
  }
  .footer-col ul,
  .cities-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .site-footer a {
    color: color-mix(in oklab, white 78%, #0b1220);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer-cities {
    padding-block: 0.5rem 2.5rem;
  }
  .cities-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.65rem 1.5rem;
  }
  .footer-legal {
    padding-block: 2rem 2.75rem;
    border-top: 1px solid color-mix(in oklab, white 12%, #0b1220);
    font-size: var(--text-sm);
  }
  .legal-lines {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: color-mix(in oklab, white 66%, #0b1220);
    max-width: 90ch;
  }
  .legal-lines strong {
    color: #fff;
  }
  .footer-fine {
    margin-top: 0.85rem;
    color: color-mix(in oklab, white 48%, #0b1220);
    max-width: 90ch;
  }
  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
