{
  "name": "mrpackermover",
  "version": "0.1.0",
  "private": true,
  "description": "MrPackerMover — data-backed packers & movers site. Astro (SSG) · Payload CMS · Postgres/Neon · Cloudflare.",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,astro,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,js,jsx,json,md,css,yaml,yml}\"",
    "build-manifest": "pnpm --filter @mpm/cms build-manifest",
    "check": "tsx scripts/check-all.ts",
    "seed": "pnpm --filter @mpm/cms seed",
    "migrate": "pnpm --filter @mpm/cms migrate",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@mpm/seo": "workspace:*",
    "@mpm/shared": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
