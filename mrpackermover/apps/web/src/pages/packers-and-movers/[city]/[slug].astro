---
import type { CityServiceData, GeoPage, LocalityData } from '@mpm/shared';
import {
  CITY_SERVICE_PAGES,
  LOCALITY_PAGES,
  fallbackGeoPage,
  geoPageWithCount,
  plainText,
  serviceCopy,
} from '@mpm/shared';
import { jsonld } from '@mpm/seo';
import { rowsOfType, dataOf } from '../../../data/manifest.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GeoHero from '../../../components/sections/GeoHero.astro';
import Band from '../../../components/ui/Band.astro';
import Inclusions from '../../../components/sections/Inclusions.astro';
import LocalNotes from '../../../components/sections/LocalNotes.astro';
import RelatedLinks from '../../../components/sections/RelatedLinks.astro';
import Faq from '../../../components/sections/Faq.astro';
import GeoPageBody from '../../../components/g/GeoPageBody.astro';
import GPage from '../../../components/g/GPage.astro';
import { SITE_ORIGIN } from '../../../lib/site.js';
import { cardPhoto } from '../../../lib/card-photo.js';

/**
 * Two page families share this depth: city × service and locality. Both come from
 * manifest rows, so the route table is finite; the template branches on pageType.
 *
 * A locality page is built like its city page: the same photo banner and price bar,
 * then the locality's brief on the tinted canvas of cards (GeoPageBody).
 */
export function getStaticPaths() {
  return [...rowsOfType('city-service'), ...rowsOfType('locality')].map((row) => {
    const [city, slug] = row.slug.split('/');
    return { params: { city, slug }, props: { row } };
  });
}

const { row } = Astro.props;
const isService = row.pageType === 'city-service';
const cs = isService ? dataOf<CityServiceData>(row) : null;
const loc = !isService ? dataOf<LocalityData>(row) : null;

const cityName = cs?.cityName ?? loc?.cityName ?? '';
// Same banner choice as the city page - see the note there.
const heroImage = 'home';

// ── Locality ───────────────────────────────────────────────────────────────
const page: GeoPage | null = loc
  ? (loc.page ??
    geoPageWithCount(
      LOCALITY_PAGES[row.slug] ??
        fallbackGeoPage({
          place: loc.localityName,
          city: loc.cityName,
          notes: loc.editorial,
          faqs: loc.faqs,
        }),
      rowsOfType('city-hub').length,
    ))
  : null;
const serviceLinks = row.relatedLinks
  .filter((l) => l.group === 'services')
  .map((l) => {
    const slug = l.path.split('/').pop() ?? '';
    const name = serviceCopy(slug)?.name;
    return {
      href: l.path,
      label: name ?? l.anchor,
      sub: name ? `in ${cityName}` : undefined,
      image: cardPhoto(slug) ?? undefined,
    };
  });
// The whole city first, then the sibling areas with pages of their own.
const nearbyLinks = loc
  ? [
      { href: loc.cityPath, label: loc.cityName, sub: 'The whole city' },
      ...row.relatedLinks
        .filter((l) => l.group === 'siblings')
        .map((l) => ({ href: l.path, label: l.anchor.replace(/^Movers in /, '') })),
    ]
  : [];

// ── City × service ─────────────────────────────────────────────────────────
// The page written for this service in this city, when there is one: it renders like the
// city and locality pages. Without one, the older generic template below stays.
const csPage: GeoPage | null = cs
  ? (cs.page ??
    (CITY_SERVICE_PAGES[row.slug]
      ? geoPageWithCount(CITY_SERVICE_PAGES[row.slug]!, rowsOfType('city-hub').length)
      : null))
  : null;
const citySlug = row.slug.split('/')[0] ?? '';
const csServiceLinks = csPage
  ? rowsOfType('city-service')
      .filter((r) => r.slug.startsWith(`${citySlug}/`) && r.slug !== row.slug)
      .map((r) => {
        const slug = r.slug.split('/')[1] ?? '';
        const name = serviceCopy(slug)?.name ?? dataOf<CityServiceData>(r).serviceName;
        return {
          href: r.path,
          label: name,
          sub: `in ${cityName}`,
          image: cardPhoto(slug) ?? undefined,
        };
      })
  : [];
const csNearbyLinks = csPage
  ? [
      { href: `/packers-and-movers/${citySlug}`, label: cityName, sub: 'All moving services' },
      ...row.relatedLinks
        .filter((l) => l.group === 'nearby')
        .map((l) => ({
          href: l.path,
          label: l.anchor.replace(/^.* in /, ''),
          sub: cs!.serviceName,
        })),
    ]
  : [];
const csAreaLinks = csPage
  ? row.relatedLinks
      .filter((l) => l.group === 'localities')
      .map((l) => ({ href: l.path, label: l.anchor.replace(/^Movers in /, '') }))
  : [];
const csFaqs = csPage
  ? csPage.faqs.map((f) => ({ question: f.question, answer: plainText(f.answer) }))
  : (cs?.faqs ?? []);

const extraJsonLd = isService
  ? [
      jsonld.service({
        siteOrigin: SITE_ORIGIN,
        name: `${cs!.serviceName} in ${cityName}`,
        ...(csPage ? { description: plainText(csPage.subhead) } : {}),
        areaServed: cityName,
        offer: cs!.priceFrom ? { priceFrom: cs!.priceFrom } : undefined,
      }),
      jsonld.faqPage(csFaqs),
    ]
  : [
      jsonld.service({
        siteOrigin: SITE_ORIGIN,
        name: `Packers and movers in ${loc!.localityName}, ${cityName}`,
        serviceType: 'Packers and movers',
        description: plainText(page!.subhead),
        areaServed: `${loc!.localityName}, ${cityName}`,
        offer: loc!.priceFrom ? { priceFrom: loc!.priceFrom } : undefined,
      }),
      jsonld.faqPage(
        page!.faqs.map((f) => ({ question: f.question, answer: plainText(f.answer) })),
      ),
    ];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  {
    isService && csPage ? (
      <>
        <GeoHero
          align="split"
          crumbs={[
            { href: '/', label: 'Home' },
            { href: `/packers-and-movers/${citySlug}`, label: cityName },
            { label: `${cs!.serviceName}` },
          ]}
          h1={csPage.h1}
          intro={plainText(csPage.subhead)}
          image={heroImage}
          imageUrl={cs!.heroImage?.url}
          imageAlt={cs!.heroImage?.alt ?? `A view of ${cityName}`}
          prefillCity={cityName}
          prefillService={cs!.serviceName}
          bands={cs!.rateBands ?? []}
        />

        <GPage>
          <GeoPageBody
            page={csPage}
            place={cityName}
            serviceLinks={csServiceLinks}
            areas={
              csAreaLinks.length
                ? { heading: `Areas we cover in ${cityName}`, links: csAreaLinks }
                : undefined
            }
            nearbyLinks={csNearbyLinks}
            inclusions={cs!.inclusions}
            exclusions={cs!.exclusions}
          />
        </GPage>
      </>
    ) : isService ? (
      <>
        <GeoHero
          align="split"
          crumbs={[
            { href: '/', label: 'Home' },
            { href: `/packers-and-movers/${row.slug.split('/')[0]}`, label: cityName },
            { label: `${cs!.serviceName}` },
          ]}
          h1={row.h1}
          intro={`${cs!.serviceName} in ${cityName} with one fixed, written quote and our own trained crews.`}
          image={heroImage}
          imageUrl={cs!.heroImage?.url}
          imageAlt={cs!.heroImage?.alt ?? `A view of ${cityName}`}
          prefillCity={cityName}
          prefillService={cs!.serviceName}
          bands={cs!.rateBands ?? []}
        />

        <Band label="Scope">
          <Inclusions inclusions={cs!.inclusions} exclusions={cs!.exclusions} />
        </Band>

        {cs!.editorial.length > 0 && (
          <Band alt label="Local notes">
            <LocalNotes
              paragraphs={cs!.editorial}
              heading={`What our crews plan for in ${cityName}`}
            />
          </Band>
        )}

        {row.relatedLinks.length > 0 && (
          <Band label="Explore">
            <RelatedLinks links={row.relatedLinks} />
          </Band>
        )}

        {csFaqs.length > 0 && (
          <Band alt label="FAQ">
            <Faq faqs={csFaqs} />
          </Band>
        )}
      </>
    ) : (
      <>
        <GeoHero
          align="split"
          crumbs={[
            { href: '/', label: 'Home' },
            { href: loc!.cityPath, label: cityName },
            { label: loc!.localityName },
          ]}
          h1={page!.h1}
          intro={plainText(page!.subhead)}
          image={heroImage}
          imageUrl={loc!.heroImage?.url}
          imageAlt={loc!.heroImage?.alt ?? `A view of ${cityName}`}
          prefillCity={cityName}
          bands={loc!.rateBands ?? []}
        />

        <GPage>
          <GeoPageBody
            page={page!}
            place={loc!.localityName}
            serviceLinks={serviceLinks}
            nearbyLinks={nearbyLinks}
          />
        </GPage>
      </>
    )
  }
</BaseLayout>
