---
/**
 * Closing call-to-action band. Dark navy by default (matches the footer lead-in);
 * the whole thing is one gradient card inside the page container. Buttons are
 * driven by props so every page ends on a consistent, honest CTA.
 */
interface Props {
  heading?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading = 'Get a fixed, written quote',
  text = 'No call-centre haggling. Tell us what you’re moving and where — we’ll send an itemised price you can hold us to.',
  primaryLabel = 'Get a fixed quote',
  primaryHref = '/get-quote',
  secondaryLabel = 'Talk to us',
  secondaryHref = '/company/contact',
} = Astro.props;
---

<section class="cta-band-wrap section">
  <div class="container-page">
    <div class="cta-band">
      <span class="cta-glow" aria-hidden="true"></span>
      <div class="cta-copy">
        <h2>{heading}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href={primaryHref}>{primaryLabel}</a>
        {
          secondaryLabel && (
            <a class="btn cta-ghost btn-lg" href={secondaryHref}>
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band-wrap {
    background: var(--color-surface);
  }
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, #071b31 0%, #092341 55%, #0d2f56 100%);
    color: #fff;
    box-shadow: var(--shadow-pop);
  }
  .cta-glow {
    position: absolute;
    top: -100px;
    right: -60px;
    width: 320px;
    height: 320px;
    border-radius: var(--radius-pill);
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-brand-500) 60%, transparent),
      transparent 70%
    );
    opacity: 0.55;
    z-index: -1;
  }
  .cta-copy {
    max-width: 46ch;
  }
  .cta-copy h2 {
    color: #fff;
    font-size: clamp(1.4rem, 3vw, var(--text-3xl));
  }
  .cta-copy p {
    margin-top: 0.65rem;
    color: rgba(255, 255, 255, 0.8);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta-ghost {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .cta-ghost:hover {
    background: rgba(255, 255, 255, 0.16);
    text-decoration: none;
  }
  /* Keep both CTAs in one row on mobile, sharing the width equally. */
  @media (max-width: 560px) {
    .cta-actions {
      flex-wrap: nowrap;
      width: 100%;
      gap: 0.6rem;
    }
    .cta-actions .btn {
      flex: 1 1 0;
      min-width: 0;
      padding: 0.8rem 0.6rem;
      font-size: var(--text-sm);
      line-height: 1.2;
    }
  }
</style>
