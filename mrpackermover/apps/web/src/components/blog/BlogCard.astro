---
import type { BlogPost } from '../../data/blog.js';
import { formatDate } from '../../lib/format.js';

interface Props {
  post: BlogPost;
}
const { post } = Astro.props;
---

<article class="blog-card" data-category={post.category}>
  <a class="bc-link" href={`/blog/${post.slug}`}>
    <div class="bc-media">
      <img
        src={post.cover}
        alt={post.coverAlt}
        loading="lazy"
        decoding="async"
        width="640"
        height="360"
      />
      <span class="bc-cat">{post.category}</span>
    </div>
    <div class="bc-body">
      <h3 class="bc-title">{post.title}</h3>
      <p class="bc-excerpt">{post.excerpt}</p>
      <div class="bc-meta">
        <span>{formatDate(post.date)}</span>
        <span class="bc-dot" aria-hidden="true">·</span>
        <span>{post.readMins} min read</span>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    height: 100%;
  }
  .bc-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .bc-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
    text-decoration: none;
  }
  .bc-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-3);
  }
  .bc-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .bc-link:hover .bc-media img {
    transform: scale(1.04);
  }
  .bc-cat {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-brand-700);
    background: color-mix(in oklab, white 88%, transparent);
    backdrop-filter: blur(4px);
    padding: 0.28rem 0.6rem;
    border-radius: var(--radius-pill);
  }
  .bc-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.35rem 1.4rem;
    flex: 1;
  }
  .bc-title {
    font-size: var(--text-xl);
    line-height: 1.25;
    color: var(--color-ink-900);
  }
  .bc-excerpt {
    color: var(--color-ink-500);
    font-size: var(--text-base);
    flex: 1;
  }
  .bc-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-ink-500);
    margin-top: 0.25rem;
  }
</style>
