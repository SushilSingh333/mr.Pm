---
import { WHATSAPP_HREF } from '../../lib/site.js';

/**
 * Floating WhatsApp button, mobile/tablet only (hidden from 1080px up, where the
 * header already shows the call + quote CTAs). Rendered once in BaseLayout so it
 * is present on every page. Zero JS — a plain link with a pre-filled message.
 */
---

<a
  class="wa-fab"
  href={WHATSAPP_HREF}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
  data-wa-fab
>
  <span class="wa-ring" aria-hidden="true"></span>
  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
    <path
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.08-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.07-.13-.27-.2-.57-.35z"
    ></path>
    <path
      d="M12.04 2h-.01C6.5 2 2 6.5 2 12.04c0 1.77.46 3.5 1.34 5.02L2 22.5l5.6-1.46a10 10 0 0 0 4.44 1.04h.01c5.53 0 10.03-4.5 10.03-10.04C22.08 6.5 17.58 2 12.04 2zm0 18.16h-.01a8.3 8.3 0 0 1-4.22-1.16l-.3-.18-3.13.82.84-3.05-.2-.31a8.28 8.28 0 0 1-1.27-4.42c0-4.58 3.72-8.3 8.3-8.3 2.22 0 4.3.87 5.87 2.44a8.24 8.24 0 0 1 2.43 5.87c0 4.58-3.73 8.3-8.31 8.3z"
    ></path>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 80;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: #25d366;
    color: #fff;
    text-decoration: none;
    box-shadow:
      0 10px 24px rgba(18, 140, 70, 0.34),
      0 2px 6px rgba(9, 35, 65, 0.18);
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      visibility var(--dur-base);
  }
  .wa-fab:active {
    transform: scale(0.94);
    box-shadow: 0 6px 16px rgba(18, 140, 70, 0.3);
  }
  .wa-fab svg {
    position: relative;
    z-index: 1;
  }

  /* Soft attention pulse — behind the button, never intercepts taps. */
  .wa-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    background: #25d366;
    opacity: 0.45;
    animation: wa-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    70% {
      transform: scale(1.55);
      opacity: 0;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  /* Get out of the way while the mobile menu is open. */
  :global(html.nav-open) .wa-fab {
    opacity: 0;
    visibility: hidden;
  }

  /* Desktop already has the call + quote CTAs in the header. */
  @media (min-width: 1080px) {
    .wa-fab {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-ring {
      animation: none;
    }
    .wa-fab {
      transition-duration: 0.001ms;
    }
  }
</style>
