---
import type { CityHubData, GeoPage } from '@mpm/shared';
import { CITY_PAGES, fallbackGeoPage, geoPageWithCount, plainText, serviceCopy } from '@mpm/shared';
import { jsonld } from '@mpm/seo';
import { rowsOfType, dataOf } from '../../data/manifest.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeoHero from '../../components/sections/GeoHero.astro';
import GPage from '../../components/g/GPage.astro';
import GeoPageBody from '../../components/g/GeoPageBody.astro';
import { SITE_ORIGIN } from '../../lib/site.js';
import { cardPhoto } from '../../lib/card-photo.js';

/**
 * City page (/packers-and-movers/<city>): the same photo banner and price bar as every
 * geo page and the home page (GeoHero), then the owner's city brief on the service
 * pages' tinted canvas of cards (GeoPageBody). The copy comes finished from the manifest - the brief with the
 * editor's "Page content" fields laid over it. The committed sample manifest CI builds
 * from has none, so there the brief (or the plain fallback) stands in.
 *
 * Every path comes from a manifest row - no arbitrary input (ADR-0003).
 */
export function getStaticPaths() {
  return rowsOfType('city-hub').map((row) => ({
    params: { city: row.slug },
    props: { row },
  }));
}

const { row } = Astro.props;
const data = dataOf<CityHubData>(row);
const page: GeoPage =
  data.page ??
  geoPageWithCount(
    CITY_PAGES[row.slug] ??
      fallbackGeoPage({ place: data.cityName, notes: data.editorial, faqs: data.faqs }),
    rowsOfType('city-hub').length,
  );

// Each service as a photo card: the sentence-case name, whatever capitals the CMS record
// uses, and the service's own photograph.
const serviceLinks = row.relatedLinks
  .filter((l) => l.group === 'services')
  .map((l) => {
    const slug = l.path.split('/').pop() ?? '';
    const name = serviceCopy(slug)?.name;
    return {
      href: l.path,
      label: name ?? l.anchor,
      sub: name ? `in ${data.cityName}` : undefined,
      image: cardPhoto(slug) ?? undefined,
    };
  });
// The banner artwork. /images/hero/cities/<slug>.jpg are 240px square card thumbnails
// that blur when stretched full-bleed (and have no WebP variants), so the branded 1920px
// montage is the banner until wide city artwork exists. A CMS upload wins.
const heroImage = 'home';

const areaLinks = (data.areas ?? []).map((a) => ({ href: a.path, label: a.name }));
const nearbyLinks = row.relatedLinks
  .filter((l) => l.group === 'nearby')
  .map((l) => ({ href: l.path, label: l.anchor }));

const extraJsonLd = [
  jsonld.service({
    siteOrigin: SITE_ORIGIN,
    name: `Packers and movers in ${data.cityName}`,
    serviceType: 'Packers and movers',
    description: plainText(page.subhead),
    areaServed: data.cityName,
    offer: data.priceFrom ? { priceFrom: data.priceFrom } : undefined,
  }),
  jsonld.faqPage(page.faqs.map((f) => ({ question: f.question, answer: plainText(f.answer) }))),
];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  <GeoHero
    align="split"
    crumbs={[{ href: '/', label: 'Home' }, { label: data.cityName }]}
    h1={page.h1}
    intro={plainText(page.subhead)}
    image={heroImage}
    imageUrl={data.heroImage?.url}
    prefillCity={data.cityName}
    bands={data.rateBands}
  />

  <GPage>
    <GeoPageBody
      page={page}
      serviceLinks={serviceLinks}
      areas={{
        heading: `Which areas of ${data.cityName} do you cover?`,
        intro: `All of ${data.cityName}. Each area below has its own guide to access, society rules and timings.`,
        links: areaLinks,
        search: {
          label: `Find your area in ${data.cityName}`,
          empty: `No guide for that area yet, but we cover all of ${data.cityName}.`,
        },
      }}
      nearbyLinks={nearbyLinks}
    />
  </GPage>
</BaseLayout>
