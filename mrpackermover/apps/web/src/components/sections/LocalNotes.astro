---
/**
 * The unique-prose section. On a location page it is the block that must exist or the
 * page does not publish (Doc 01 §6, Doc 02 §9 step 6): societies, lift and stair
 * access, gate timings, no-entry hours. Service pages reuse it for their own copy.
 * Either way it is what an operator can write and a str_replace farm cannot.
 *
 * Laid out as an editorial split rather than one centred column. These notes run to
 * several hundred words, and a single 68ch measure stranded half the band empty while
 * the reader scrolled a long way. The heading now holds a left rail that stays put as
 * the notes scroll past it, so the section reads as reference material about one place
 * instead of an unbroken wall of text.
 */
import { PHONE_DISPLAY, PHONE_TEL } from '../../lib/site.js';

interface Props {
  paragraphs: string[];
  heading: string;
  /** Small label above the heading. Defaults to the section's own purpose. */
  eyebrow?: string;
}
const { paragraphs, heading, eyebrow = 'On the ground' } = Astro.props;

/** What the quote actually guarantees. Each line is checkable on this site. */
const QUOTE_PROMISES = [
  'One itemised price, in writing',
  'Crew and vehicle you can verify',
  'Transit cover available on request',
];
---

{
  paragraphs.length > 0 && (
    <section class="local-notes" aria-label={heading}>
      <div class="ln-rail">
        <p class="ln-eyebrow">
          {eyebrow}
          <span class="ln-rule" aria-hidden="true" />
        </p>
        <h2>{heading}</h2>
        {/* The rail is tall next to several hundred words, and a heading alone left it
            empty. This is the one thing a reader this far into the page actually wants
            next, and it stays with them as the notes scroll. */}
        <aside class="ln-aside">
          <span class="ln-aside-rule" aria-hidden="true" />
          <p class="ln-aside-lead">Want a number you can hold us to?</p>
          <p class="ln-aside-body">
            Tell us what you are moving and where it is going. You get one price for the whole job,
            itemised and in writing, with nothing added on moving day.
          </p>
          <ul class="ln-aside-list" role="list">
            {QUOTE_PROMISES.map((promise) => (
              <li>
                <svg
                  viewBox="0 0 24 24"
                  width="15"
                  height="15"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 12.5l5 5L20 6.5" />
                </svg>
                {promise}
              </li>
            ))}
          </ul>
          <div class="ln-aside-actions">
            <a class="ln-aside-cta" href="/get-quote">
              Get a fixed quote
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a class="ln-aside-call" href={`tel:${PHONE_TEL}`}>
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 4h3.6l1.4 4-2 1.3a11 11 0 0 0 4.7 4.7L18 16l1.4 1.4V21a1 1 0 0 1-1 1A15 15 0 0 1 3 6a1 1 0 0 1 1-1z" />
              </svg>
              {PHONE_DISPLAY}
            </a>
          </div>
        </aside>
      </div>
      <div class="ln-body prose">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </section>
  )
}

<style>
  .local-notes {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  /* Sticky so the place stays named while its notes scroll. The site header is
     sticky and about 68px tall, so 6rem clears it with room to spare. */
  .ln-rail {
    position: sticky;
    top: 6rem;
  }
  .ln-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.7rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-brand-600);
  }
  .ln-rule {
    height: 2px;
    width: 34px;
    border-radius: 2px;
    background: var(--color-orange-500);
  }
  .local-notes h2 {
    font-size: clamp(1.5rem, 3vw, var(--text-3xl));
    line-height: 1.15;
    margin: 0;
    text-wrap: balance;
  }
  .ln-aside {
    margin-top: 1.75rem;
    padding: 1.5rem 1.45rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  /* The same orange rule the eyebrow uses, so the card reads as part of the section
     rather than an advert dropped into it. */
  .ln-aside-rule {
    display: block;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-orange-500);
    margin-bottom: 0.9rem;
  }
  .ln-aside-lead {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1.2;
    color: var(--color-ink-900);
    text-wrap: balance;
  }
  .ln-aside-body {
    margin: 0 0 1.1rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-500);
  }
  .ln-aside-list {
    list-style: none;
    margin: 0 0 1.3rem;
    padding: 0 0 1.2rem;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ln-aside-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-ink-700);
  }
  .ln-aside-list svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--color-accent-600);
  }
  /* Button and phone share one row; they wrap only if the rail gets genuinely narrow. */
  .ln-aside-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.85rem;
  }
  .ln-aside-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.05rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-600);
    color: #fff;
    font-weight: 600;
    font-size: var(--text-sm);
    white-space: nowrap;
    text-decoration: none;
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .ln-aside-cta:hover,
  .ln-aside-cta:focus-visible {
    background: var(--color-brand-700);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .ln-aside-call {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-brand-700);
    text-decoration: none;
  }
  .ln-aside-call:hover {
    text-decoration: underline;
  }
  .ln-body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    /* Short notes (a locality with two paragraphs) would otherwise sit stranded at the
       top of a row whose height the taller rail sets. Centring only bites when the
       prose is the shorter column; when it is the taller one it defines the row height
       and this is a no-op. */
    align-self: center;
    /* Wider than the old centred column but still inside a readable measure. */
    max-width: 72ch;
    color: var(--color-ink-700);
  }
  .ln-body p {
    font-size: var(--text-lg);
    line-height: 1.65;
    margin: 0;
  }
  /* The opening note carries the most context, so it leads. */
  .ln-body p:first-child {
    font-size: clamp(1.0625rem, 1.6vw, var(--text-xl));
    line-height: 1.55;
    color: var(--color-ink-900);
  }

  @media (max-width: 900px) {
    .local-notes {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .ln-rail {
      position: static;
    }
    .ln-body {
      max-width: none;
      align-self: stretch;
    }
    /* Stacked, the card would sit between the heading and its own prose. Order moves
       it below, where it reads as a next step rather than an interruption. */
    .ln-rail {
      display: contents;
    }
    .ln-aside {
      order: 3;
      margin-top: 0.5rem;
    }
    .local-notes {
      display: flex;
      flex-direction: column;
    }
  }
</style>
