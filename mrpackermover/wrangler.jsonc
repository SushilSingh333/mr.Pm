{
  // Frontend-only deploy for Cloudflare Workers Builds (Git-connected).
  //
  // This is an ASSETS-ONLY Worker: it has no server code (no `main`), it just
  // serves the static Astro site built into apps/web/dist. That is exactly the
  // "deploy only the frontend" case — the /quote /track /search endpoints and the
  // Hyperdrive/Postgres wiring are intentionally NOT included here.
  //
  // Root directory / Path in the Cloudflare Build settings must be "/" so the
  // pnpm workspace installs, and the build command produces apps/web/dist.
  //
  // NOTE: `name` MUST match the Worker you connected in the dashboard (the name
  // shown at the top of the Worker's page). Change it if yours differs.
  "name": "mrpackermover",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./apps/web/dist",
    // Serve the built 404.html for unknown paths (Astro emits /404.html).
    "not_found_handling": "404-page"
  }
}
