---
/**
 * MrPackerMover wordmark logo: the two-tone "MR" monogram + "PackerMover" +
 * a location pin, in the brand navy/blue. Rendered inline so it uses the site
 * font and stays crisp at any size. Pass `light` for the dark footer.
 *
 * To use the exact brand artwork instead, drop it at `public/logo.svg` (or .png)
 * and swap the markup below for an <img src="/logo.svg" alt="MrPackerMover" />.
 */
interface Props {
  light?: boolean;
  href?: string;
}
const { light = false, href = '/' } = Astro.props;
---

<a class:list={['logo', { light }]} href={href} aria-label="MrPackerMover home">
  <span class="logo-mark"><span class="mk-m">M</span><span class="mk-r">R</span></span>
  <span class="logo-word"><span class="wd-a">Packer</span><span class="wd-b">Mover</span></span>
  <svg class="logo-pin" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
    <path
      fill="currentColor"
      d="M12 2a7 7 0 00-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 00-7-7zm0 9.6A2.6 2.6 0 1112 6.4a2.6 2.6 0 010 5.2z"
    ></path>
  </svg>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    font-family: var(--font-display);
    line-height: 1;
    white-space: nowrap;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-mark {
    font-weight: 800;
    font-size: 1.55em;
    letter-spacing: -0.05em;
  }
  .mk-m {
    color: var(--color-ink-900);
  }
  .mk-r {
    color: var(--color-brand-600);
  }
  .logo-word {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.98em;
  }
  .wd-a {
    color: var(--color-ink-900);
  }
  .wd-b {
    color: var(--color-brand-600);
  }
  .logo-pin {
    color: var(--color-brand-600);
    align-self: center;
    margin-inline-start: -0.1rem;
  }

  /* Light variant for dark backgrounds (footer). */
  .logo.light .mk-m,
  .logo.light .wd-a {
    color: #fff;
  }
  .logo.light .mk-r,
  .logo.light .wd-b,
  .logo.light .logo-pin {
    color: var(--color-brand-300);
  }
</style>
