---
import Logo from './Logo.astro';
import { iconSvg } from '../../lib/icons.js';
import { PRIMARY_NAV, MORE_NAV, PHONE_DISPLAY, PHONE_TEL } from '../../lib/site.js';

/** Fixed top bar: logo left, centered nav, actions right. Secondary links live in "More". */
---

<header class="site-header">
  <div class="container-page header-inner">
    <div class="brand"><Logo /></div>

    <nav class="primary-nav" aria-label="Primary">
      {PRIMARY_NAV.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}

      <div class="nav-more">
        <button
          type="button"
          class="nav-link more-btn"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="more-menu"
        >
          More
          <svg class="chev" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>

        <div class="more-menu" id="more-menu" role="menu">
          <span class="more-caret" aria-hidden="true"></span>
          <div class="more-grid">
            {
              MORE_NAV.map((l) => (
                <a class="more-item" role="menuitem" href={l.href}>
                  <span class="mi-icon" set:html={`<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>${iconSvg(l.icon)}</svg>`} />
                  <span class="mi-text">
                    <strong>{l.label}</strong>
                    <small>{l.desc}</small>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </nav>

    <div class="header-right">
      <div class="header-cta">
        <a class="header-phone" href={`tel:${PHONE_TEL}`} aria-label={`Call us on ${PHONE_DISPLAY}`}>
          <span class="hp-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.6l1.4 4-2 1.3a11 11 0 0 0 4.7 4.7L18 16l1.4 1.4V21a1 1 0 0 1-1 1A15 15 0 0 1 3 6a1 1 0 0 1 1-1z" /></svg>
          </span>
          <span class="hp-text">
            <small>Call for a quote</small>
            <strong>{PHONE_DISPLAY}</strong>
          </span>
        </a>
        <a href="/get-quote" class="btn btn-primary quote-btn">
          Get a fixed quote
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mobile-drawer" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer + backdrop (kept OUTSIDE the backdrop-filtered header so they anchor to the viewport). -->
<div class="m-backdrop" id="mBackdrop"></div>

<aside class="m-drawer" id="mobile-drawer" aria-label="Menu" aria-hidden="true">
  <div class="md-top">
    <Logo />
    <button class="md-close" id="mClose" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <div class="md-scroll">
  <nav class="md-primary" aria-label="Primary">
    {
      PRIMARY_NAV.map((l) => (
        <a class="md-link" href={l.href}>
          <span>{l.label}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      ))
    }
  </nav>

  <span class="md-label">Explore</span>
  <nav class="md-more" aria-label="More">
    {
      MORE_NAV.map((l) => (
        <a class="md-item" href={l.href}>
          <span class="md-ic" set:html={`<svg viewBox='0 0 24 24' width='19' height='19' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>${iconSvg(l.icon)}</svg>`} />
          <span class="md-tx">
            <strong>{l.label}</strong>
            <small>{l.desc}</small>
          </span>
        </a>
      ))
    }
  </nav>
  </div>

  <div class="md-foot">
    <a class="md-call" href={`tel:${PHONE_TEL}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.6l1.4 4-2 1.3a11 11 0 0 0 4.7 4.7L18 16l1.4 1.4V21a1 1 0 0 1-1 1A15 15 0 0 1 3 6a1 1 0 0 1 1-1z" /></svg>
      {PHONE_DISPLAY}
    </a>
    <a class="btn btn-primary md-cta" href="/get-quote">
      Get a fixed quote
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</aside>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-surface) 90%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    height: 68px;
  }
  .brand {
    grid-column: 1;
    justify-self: start;
    display: flex;
    align-items: center;
  }
  .brand :global(.logo) {
    font-size: 1.02rem;
  }

  /* ── Centered primary nav (desktop) ───────────────────────────────────── */
  .primary-nav {
    grid-column: 2;
    display: none;
    justify-self: center;
    align-items: center;
    gap: 0.35rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-pill);
    color: var(--color-ink-700);
    text-decoration: none;
    font-family: var(--font-text);
    font-weight: 600;
    font-size: var(--text-base);
    background: none;
    border: 0;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover {
    color: var(--color-brand-700);
    background: var(--color-surface-2);
  }

  .nav-more {
    position: relative;
  }
  .more-btn .chev {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nav-more.open .more-btn .chev {
    transform: rotate(180deg);
  }
  .nav-more.open .more-btn {
    color: var(--color-brand-700);
    background: var(--color-surface-2);
  }
  .more-menu {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    width: 480px;
    max-width: 92vw;
    padding: 0.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-pop);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-8px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility var(--dur-base);
  }
  .nav-more:hover .more-menu,
  .nav-more:focus-within .more-menu,
  .nav-more.open .more-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }
  .more-caret {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    transform: translateX(-50%) rotate(45deg);
    background: var(--color-surface);
    border-left: 1px solid var(--color-line);
    border-top: 1px solid var(--color-line);
    border-radius: 3px 0 0 0;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.15rem;
  }
  .more-item {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    text-align: left;
    gap: 0.8rem;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .more-item:hover {
    background: var(--color-surface-2);
    text-decoration: none;
  }
  .mi-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: var(--radius-md);
    background: var(--color-surface-3);
    color: var(--color-brand-600);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .more-item:hover .mi-icon {
    background: var(--color-brand-600);
    color: #fff;
    transform: translateY(-2px);
  }
  .mi-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    line-height: 1.2;
    min-width: 0;
  }
  .mi-text strong {
    color: var(--color-ink-900);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .mi-text small {
    color: var(--color-ink-500);
    font-size: var(--text-xs);
  }

  /* ── Right actions ────────────────────────────────────────────────────── */
  .header-right {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .header-cta {
    display: none;
    gap: 0.9rem;
    align-items: center;
  }
  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .hp-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-3);
    color: var(--color-brand-600);
    flex: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .header-phone:hover .hp-icon {
    background: var(--color-brand-600);
    color: #fff;
  }
  .hp-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .hp-text small {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }
  .hp-text strong {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink-900);
    font-size: var(--text-sm);
  }
  .quote-btn {
    padding: 0.62rem 1.1rem;
  }

  /* ── Hamburger ────────────────────────────────────────────────────────── */
  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    align-items: center;
    background: none;
    border: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--color-ink-900);
    border-radius: 2px;
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
    transform-origin: center;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile drawer ────────────────────────────────────────────────────── */
  .m-backdrop {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(9, 35, 65, 0.5);
    backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-base) var(--ease-out),
      visibility var(--dur-base);
  }
  .m-backdrop.show {
    opacity: 1;
    visibility: visible;
  }
  .m-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 100;
    height: 100dvh;
    width: min(88vw, 360px);
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.05rem 1.1rem;
    background: var(--color-surface);
    box-shadow: -22px 0 55px rgba(9, 35, 65, 0.28);
    overflow: hidden; /* the middle section scrolls, not the whole drawer */
    transform: translateX(100%);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .m-drawer.show {
    transform: translateX(0);
  }
  /* Scrollable middle: links scroll here; top bar + footer stay pinned. */
  .md-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-inline: -0.2rem;
    padding-inline: 0.2rem;
  }
  .md-top {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.9rem;
    margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--color-line);
  }
  .md-close {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink-700);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .md-close:hover {
    background: var(--color-surface-2);
    color: var(--color-brand-700);
  }

  .md-primary {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .md-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 0.75rem;
    border-radius: var(--radius-md);
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .md-link svg {
    color: var(--color-ink-500);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .md-link:active,
  .md-link:hover {
    background: var(--color-surface-2);
    color: var(--color-brand-700);
    text-decoration: none;
  }
  .md-link:hover svg {
    color: var(--color-brand-600);
    transform: translateX(3px);
  }

  .md-label {
    display: block;
    margin: 1rem 0.75rem 0.45rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .md-more {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .md-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .md-item:hover,
  .md-item:active {
    background: var(--color-surface-2);
    text-decoration: none;
  }
  .md-ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: var(--radius-md);
    background: var(--color-surface-3);
    color: var(--color-brand-600);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .md-item:hover .md-ic {
    background: var(--color-brand-600);
    color: #fff;
  }
  .md-tx {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .md-tx strong {
    color: var(--color-ink-900);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .md-tx small {
    color: var(--color-ink-500);
    font-size: var(--text-xs);
  }

  .md-foot {
    flex: none;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--color-surface);
  }
  .md-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem;
    border-radius: var(--radius-btn);
    border: 1px solid var(--color-line);
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }
  .md-call svg {
    color: var(--color-brand-600);
  }
  .md-call:active {
    background: var(--color-surface-2);
  }
  .md-cta {
    width: 100%;
  }

  /* Lock background scroll while the drawer is open. */
  :global(html.nav-open) {
    overflow: hidden;
  }

  @media (min-width: 1080px) {
    .primary-nav,
    .header-cta {
      display: flex;
    }
    .nav-toggle,
    .m-backdrop,
    .m-drawer {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .m-drawer,
    .m-backdrop,
    .nav-toggle span {
      transition-duration: 0.001ms;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mBackdrop');
  const closeBtn = document.getElementById('mClose');
  const html = document.documentElement;

  if (toggle && drawer && backdrop) {
    const isOpen = (): boolean => drawer.classList.contains('show');
    const open = (): void => {
      drawer.classList.add('show');
      backdrop.classList.add('show');
      drawer.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      html.classList.add('nav-open');
    };
    const close = (): void => {
      drawer.classList.remove('show');
      backdrop.classList.remove('show');
      drawer.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      html.classList.remove('nav-open');
    };

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    closeBtn?.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        close();
        toggle.focus();
      }
    });
  }

  // "More" dropdown (desktop): click toggles; hover/focus handle pointer + keyboard.
  const more = document.querySelector<HTMLElement>('.nav-more');
  const moreBtn = more?.querySelector<HTMLButtonElement>('.more-btn');
  moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = more!.classList.toggle('open');
    moreBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (more && !more.contains(e.target as Node)) {
      more.classList.remove('open');
      moreBtn?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && more?.classList.contains('open')) {
      more.classList.remove('open');
      moreBtn?.setAttribute('aria-expanded', 'false');
      moreBtn?.focus();
    }
  });
</script>
