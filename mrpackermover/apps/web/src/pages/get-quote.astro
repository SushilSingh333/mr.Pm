---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import Band from '../components/ui/Band.astro';
import { iconSvg } from '../lib/icons.js';
import { staticRow, editorialFor } from '../lib/page.js';
import { PHONE_DISPLAY, PHONE_TEL } from '../lib/site.js';

const ed = editorialFor('get-quote');
const row = staticRow({
  path: '/get-quote',
  pageType: 'core',
  title: ed.metaTitle ?? 'Get a Fixed Quote | MrMoverPacker',
  h1: 'Get your fixed, written quote',
  metaDescription:
    ed.seoDescription ??
    'Tell us about your move and get a fixed, itemised quote from MrMoverPacker, no moving-day surprises. A coordinator calls you back within 24 hours.',
  breadcrumbs: [{ path: '/', anchor: 'Home' }],
});

const services = [
  'Home Shifting',
  'Office Shifting',
  'Car Transport',
  'Bike Transport',
  'Loading & Unloading',
  'Packing & Unpacking',
  'International Relocation',
];
/**
 * Truck sizes, matching the estimator on the city pages so the same answer produces the
 * same number in both places. The old "Approximate size" list was BHK bands, which the
 * pricing engine cannot read: it prices by truck feet.
 */
const truckSizes = [10, 12, 14, 15, 16, 17, 19];

const assurances = [
  {
    icon: 'search',
    title: 'Survey-based',
    body: 'We assess your goods first, a real price, not a phone guess.',
  },
  {
    icon: 'fixed-quote',
    title: 'Written & fixed',
    body: 'The number we send is the number you pay. In writing.',
  },
  {
    icon: 'shield-check',
    title: 'No surprises',
    body: 'Anything that could change the price is itemised up front.',
  },
];
---

<BaseLayout row={row}>
  <PageHero
    dark
    eyebrow="Free · no obligation"
    h1={row.h1}
    intro="Fill this in and your estimated price appears straight away. A representative then confirms the details and sends one fixed, itemised number in writing."
    breadcrumbs={row.breadcrumbs}
    current="Get a quote"
  />

  <Band label="Quote request">
    <div class="quote-layout">
      <!-- Form -->
      <div class="quote-main card" id="quote-card">
        <div class="qm-head">
          <h2>Tell us about your move</h2>
        </div>

        <div class="qm-promise">
          <span
            class="qmp-icon"
            aria-hidden="true"
            set:html={`<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>${iconSvg('rupee')}</svg>`}
          />
          <div class="qmp-text">
            <strong>You get your estimated price the moment you submit.</strong>
            <span>A representative then confirms it and sends your fixed price in writing.</span>
          </div>
        </div>

        <p class="qm-required">Fields marked <span class="req">*</span> are required.</p>

        <p class="form-error" id="form-error" role="alert" hidden>
          Please fill the required fields highlighted below.
        </p>

        <form id="quote-form" class="qform" novalidate>
          <div class="field-row">
            <div class="field">
              <label for="q-name">Full name <span class="req">*</span></label>
              <input
                id="q-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                placeholder="Your name"
              />
            </div>
            <div class="field">
              <label for="q-phone">Phone number <span class="req">*</span></label>
              <input
                id="q-phone"
                name="phone"
                type="tel"
                inputmode="numeric"
                autocomplete="tel"
                required
                maxlength="10"
                pattern="[6-9][0-9]{9}"
                title="10-digit mobile number"
                placeholder="10-digit mobile"
              />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="q-from">Moving from <span class="req">*</span></label>
              <input
                id="q-from"
                name="from"
                type="text"
                required
                autocomplete="off"
                placeholder="Flat / building, area, city"
              />
            </div>
            <div class="field">
              <label for="q-to">Moving to <span class="req">*</span></label>
              <input
                id="q-to"
                name="to"
                type="text"
                required
                autocomplete="off"
                placeholder="Flat / building, area, city"
              />
            </div>
          </div>
          <p class="field-hint">
            Start typing and pick your <strong>exact address</strong> from the suggestions, the more precise
            the pickup and drop points, the more accurate your quote. Pickup is from the cities we serve,
            <strong>delivery can be anywhere in India.</strong>
          </p>

          <!-- What is moving and how much of it: three related questions, one row. -->
          <div class="field-row field-row-3">
            <div class="field">
              <label for="q-service">What are you moving? <span class="req">*</span></label>
              <select id="q-service" name="service" required>
                <option value="" disabled selected>Select a service</option>
                {services.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="q-size">Truck size</label>
              <select id="q-size" name="size">
                {
                  truckSizes.map((ft) => (
                    <option value={ft} selected={ft === 14}>
                      {ft} ft
                    </option>
                  ))
                }
              </select>
            </div>
            <div class="field">
              <label for="q-pack">Packing <span class="req">*</span></label>
              <select id="q-pack" name="packing" required>
                <option value="" disabled selected> Choose packing </option>
                <option value="basic">Basic, cartons + wrap</option>
                <option value="standard">Standard, 3-layer + crates</option>
              </select>
            </div>
          </div>

          <!-- Access at both ends, the same questions the city-page estimator asks. One
               grid, so with both ends on the ground the lift questions are hidden and the
               two floor selects pair up on a single line instead of stranding one.
               NOT marked optional: each one changes the price, and defaulting quietly to
               ground floor gives a number the move cannot be done for. -->
          <div class="field-row">
            <div class="field">
              <label for="q-ffloor">Pickup floor <span class="req">*</span></label>
              <select id="q-ffloor" name="pickupFloor" required>
                <option value="" disabled selected> Choose a floor </option>
                <option value="0">Ground</option>
                <option value="1">1st</option>
                <option value="2">2nd</option>
                <option value="3">3rd</option>
                <option value="4">4th</option>
                <option value="5">5th+</option>
              </select>
            </div>
            <div class="field" id="q-flift-field" hidden>
              <label for="q-flift">Lift at pickup <span class="req">*</span></label>
              <select id="q-flift" name="pickupLift">
                <option value="" disabled selected> Is there a lift? </option>
                <option value="1">Yes, there is a lift</option>
                <option value="0">No, stairs only</option>
              </select>
            </div>
            <div class="field">
              <label for="q-tfloor">Drop floor <span class="req">*</span></label>
              <select id="q-tfloor" name="dropFloor" required>
                <option value="" disabled selected> Choose a floor </option>
                <option value="0">Ground</option>
                <option value="1">1st</option>
                <option value="2">2nd</option>
                <option value="3">3rd</option>
                <option value="4">4th</option>
                <option value="5">5th+</option>
              </select>
            </div>
            <div class="field" id="q-tlift-field" hidden>
              <label for="q-tlift">Lift at drop <span class="req">*</span></label>
              <select id="q-tlift" name="dropLift">
                <option value="" disabled selected> Is there a lift? </option>
                <option value="1">Yes, there is a lift</option>
                <option value="0">No, stairs only</option>
              </select>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="q-date">Preferred move date</label>
              <input id="q-date" name="date" type="date" />
            </div>
            <div class="field">
              <label for="q-email">Email <span class="opt">(optional)</span></label>
              <input
                id="q-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div class="field">
            <label for="q-notes">Anything else we should know?</label>
            <textarea
              id="q-notes"
              name="notes"
              rows="3"
              placeholder="Floors, lift access, fragile or special items, flexible dates…"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg qsubmit">
            See my estimated price
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            >
          </button>
          <p class="qform-fine">
            By submitting, you agree to be contacted about your move. We never sell your data, see
            our <a href="/privacy">privacy policy</a>.
          </p>
        </form>
      </div>

      <!-- Assurance aside -->
      <aside class="quote-aside">
        <div class="qa-card card">
          <h3>Why our quote is different</h3>
          <ul class="qa-list">
            {
              assurances.map((a) => (
                <li>
                  <span
                    class="qa-icon"
                    set:html={`<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>${iconSvg(a.icon)}</svg>`}
                  />
                  <span>
                    <strong>{a.title}</strong>
                    <small>{a.body}</small>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <a class="qa-call card" href={`tel:${PHONE_TEL}`}>
          <span
            class="qa-call-icon"
            set:html={`<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>${iconSvg('phone')}</svg>`}
          />
          <span>
            <small>Prefer to talk? Call us</small>
            <strong>{PHONE_DISPLAY}</strong>
          </span>
        </a>
      </aside>
    </div>
  </Band>
</BaseLayout>

<script>
  import {
    attachAutocomplete,
    hasMapsKey,
    drivingDistanceKm,
    geocodeState,
  } from '../components/quote/maps';
  import { quote, inr } from '../components/quote/estimator';
  import type { QuoteInput } from '../components/quote/estimator';
  import { PLACES, resolvePlace, routeDistanceKm } from '../components/quote/pricing';
  import { terrainFor } from '../components/quote/terrain';

  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const card = document.getElementById('quote-card');
  const banner = document.getElementById('form-error');

  if (form && card) {
    // Nobody can book a move in the past. Set on the client, not at build time: the page is
    // static and cached for a day, so a build-time `min` would go stale. Local date, not
    // toISOString() — that is UTC and reads as yesterday in IST until 5:30 am.
    const dateEl = document.getElementById('q-date') as HTMLInputElement | null;
    if (dateEl) {
      const clampDate = (): void => {
        const d = new Date();
        const min = new Date(d.getTime() - d.getTimezoneOffset() * 60000)
          .toISOString()
          .slice(0, 10);
        dateEl.min = min;
        // The picker respects `min`, but a typed or pasted value can still be earlier.
        if (dateEl.value && dateEl.value < min) dateEl.value = min;
      };
      clampDate();
      dateEl.addEventListener('change', clampDate);
    }

    // Prefill from query params (e.g. the home city selector passes ?from=Delhi).
    const params = new URLSearchParams(location.search);
    const prefill = (name: string, v: string | null) => {
      if (!v) return;
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = v;
    };
    prefill('name', params.get('name'));
    prefill('from', params.get('from'));
    prefill('to', params.get('to'));
    prefill('service', params.get('service'));
    prefill('phone', params.get('phone'));

    // Google Places suggestions on the two address fields, so people give us a real
    // address rather than just a city name. Silently no-ops without
    // PUBLIC_GOOGLE_MAPS_API_KEY, leaving both as ordinary text inputs.
    const fromInput = document.getElementById('q-from') as HTMLInputElement | null;
    const toInput = document.getElementById('q-to') as HTMLInputElement | null;
    void attachAutocomplete(fromInput);
    void attachAutocomplete(toInput);

    // The home hero passes the chosen city as ?from=Delhi. That is a starting point, not
    // the pickup address — put the caret at the end so the next keystroke refines it.
    if (hasMapsKey && fromInput?.value.trim() && !params.get('to')) {
      fromInput.focus();
      fromInput.setSelectionRange(fromInput.value.length, fromInput.value.length);
    }

    // A lift only matters above the ground floor: the floor charge is `floors * rate`,
    // which is zero at ground either way. Same rule as the city-page estimator.
    const syncLift = (floorId: string, fieldId: string): void => {
      const floor = document.getElementById(floorId) as HTMLSelectElement | null;
      const field = document.getElementById(fieldId);
      // Hidden on the ground floor AND before a floor is picked at all: asking "is there
      // a lift?" before the customer has said which floor is meaningless, and it would
      // be flagged as a missing required answer the moment they submit.
      if (floor && field) field.hidden = floor.value === '' || floor.value === '0';
    };
    const syncLifts = (): void => {
      syncLift('q-ffloor', 'q-flift-field');
      syncLift('q-tfloor', 'q-tlift-field');
    };
    syncLifts();
    for (const id of ['q-ffloor', 'q-tfloor']) {
      document.getElementById(id)?.addEventListener('change', syncLifts);
    }

    /**
     * Price the move with the same engine the city pages use, so the two never disagree.
     * Distance comes from Google when a key is configured and falls back to the in-repo
     * route table otherwise. Returns null if anything is missing, in which case the
     * success card simply omits the estimate rather than showing a wrong number.
     */
    const num = (id: string, fallback: number): number => {
      const el = document.getElementById(id) as HTMLSelectElement | null;
      const n = Number(el?.value);
      return Number.isFinite(n) ? n : fallback;
    };
    interface Estimate {
      text: string;
      meta: string;
      /** The raw figures, so the lead can record what this customer was shown. */
      distanceKm: number;
      rangeLow: number;
      rangeHigh: number;
      basis: string;
    }
    async function estimate(): Promise<Estimate | null> {
      try {
        const from = (form!.elements.namedItem('from') as HTMLInputElement).value.trim();
        const to = (form!.elements.namedItem('to') as HTMLInputElement).value.trim();
        if (!from || !to) return null;

        const [googleKm, fromState, toState] = await Promise.all([
          drivingDistanceKm(from, to),
          geocodeState(from),
          geocodeState(to),
        ]);
        const km =
          googleKm != null && googleKm > 0
            ? googleKm
            : Math.round(
                routeDistanceKm(resolvePlace(from, PLACES[0]), resolvePlace(to, PLACES[0])),
              );
        if (!km || km <= 0) return null;

        const truckFt = num('q-size', 14);
        const pickupFloor = num('q-ffloor', 0);
        const dropFloor = num('q-tfloor', 0);
        const packEl = document.getElementById('q-pack') as HTMLSelectElement | null;
        const dateEl = form!.elements.namedItem('date') as HTMLInputElement | null;

        const input: QuoteInput = {
          distanceKm: Math.round(km),
          mode: 'auto',
          truckFt,
          labour: truckFt >= 17 ? 6 : truckFt >= 15 ? 5 : 4,
          packing: true,
          pickupFloor,
          pickupLift: pickupFloor === 0 || num('q-flift', 1) === 1,
          dropFloor,
          dropLift: dropFloor === 0 || num('q-tlift', 1) === 1,
          terrainTier: terrainFor(to),
          interState: Boolean(fromState && toState && fromState !== toState),
          packingGrade: (packEl?.value as 'basic' | 'standard') ?? 'basic',
          date: dateEl?.value ?? '',
        };
        const r = quote(input);
        const mode = r.mode === 'intercity' ? 'Intercity move' : 'Local move';
        return {
          text: `${inr(r.rangeLow)} – ${inr(r.rangeHigh)}`,
          meta: `${truckFt} ft truck · ${Math.round(km)} km · ${mode} · GST extra`,
          distanceKm: Math.round(km),
          rangeLow: r.rangeLow,
          rangeHigh: r.rangeHigh,
          basis: `${truckFt} ft truck · ${mode} · ${input.packingGrade} packing`,
        };
      } catch {
        return null;
      }
    }

    const required = [
      'name',
      'phone',
      'from',
      'to',
      'service',
      // These change the price, so an unanswered one produces a number the move cannot
      // be done for. They are validated like any other required field.
      'packing',
      'pickupFloor',
      'dropFloor',
    ];

    /** A lift only matters above ground, so it is required exactly while it is shown. */
    const visibleLiftFields = (): string[] => {
      const out: string[] = [];
      if (!document.getElementById('q-flift-field')?.hidden) out.push('pickupLift');
      if (!document.getElementById('q-tlift-field')?.hidden) out.push('dropLift');
      return out;
    };
    /**
     * A real Indian mobile, or nothing.
     *
     * The old rule was `/^[+0-9 ()-]{8,}$/` - eight or more of almost any character - which
     * accepted "00000000", "1234567890" and a phone number with a digit missing. Every one of
     * those reaches a salesperson as a lead worth calling, and none of them can be rung.
     *
     * Ten digits is the whole of an Indian mobile number. `+91`, a leading 0 and any spaces,
     * dashes or brackets are accepted and stripped, because that is how people type it. The
     * first digit must be 6-9: India allocates mobile numbers only in that range, so this is
     * what rejects 1234567890 while accepting every genuine number.
     */
    const phoneDigits = (v: string): string => {
      const d = v.replace(/\D/g, '');
      if (d.length === 12 && d.startsWith('91')) return d.slice(2);
      if (d.length === 11 && d.startsWith('0')) return d.slice(1);
      return d;
    };
    const phoneOk = (v: string): boolean => /^[6-9]\d{9}$/.test(phoneDigits(v));

    const clearError = (el: HTMLElement) => {
      el.removeAttribute('aria-invalid');
      el.closest('.field')?.classList.remove('invalid');
    };
    const markError = (el: HTMLElement) => {
      el.setAttribute('aria-invalid', 'true');
      el.closest('.field')?.classList.add('invalid');
    };

    const submitBtn = form.querySelector('.qsubmit') as HTMLButtonElement | null;
    const submitLabel = submitBtn?.innerHTML ?? '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let firstBad: HTMLElement | null = null;

      for (const name of [...required, ...visibleLiftFields()]) {
        const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
        if (!el) continue;
        clearError(el);
        const empty = !el.value.trim();
        const badPhone = name === 'phone' && !phoneOk(el.value);
        if (empty || badPhone) {
          markError(el);
          firstBad = firstBad ?? el;
        }
      }

      if (firstBad) {
        if (banner) banner.textContent = 'Please fill the required fields highlighted below.';
        banner?.removeAttribute('hidden');
        firstBad.focus();
        return;
      }
      banner?.setAttribute('hidden', '');

      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
      // Optional on the form. Travels to /thank-you for Meta advanced matching, where it
      // is the strongest signal there is for matching this submission to a real person.
      const email =
        (form.elements.namedItem('email') as HTMLInputElement | null)?.value.trim() ?? '';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }

      /*
        Price before sending, so the lead records the figure this customer is about to
        see. It used to be computed after the POST purely for display, which left a
        coordinator ringing someone who had a number in their head that nobody on our
        side could see.

        Bounded and non-fatal on purpose: it calls Google for the driving distance, and
        a lead must never be lost or delayed because that was slow or down. Past the
        timeout the lead is sent without the estimate, and the customer still sees one
        if the lookup finishes later.
      */
      const est = await Promise.race([
        estimate().catch(() => null),
        new Promise<null>((r) => setTimeout(() => r(null), 4000)),
      ]);

      // Only show the success card once the lead is actually saved in the CMS.
      try {
        const data: Record<string, unknown> = Object.fromEntries(new FormData(form).entries());
        if (est) {
          data.quotedLow = est.rangeLow;
          data.quotedHigh = est.rangeHigh;
          data.distanceKm = est.distanceKm;
          data.quoteBasis = est.basis;
        }
        const res = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = submitLabel;
        }
        if (banner)
          banner.textContent =
            "Sorry. We couldn't send that just now. Please try again, or call us and we'll take your details.";
        banner?.removeAttribute('hidden');
        return;
      }

      /*
        Hand off to /thank-you rather than revealing a card in place.

        A conversion needs a URL of its own: ad platforms count a Lead when a particular
        page loads, and "a div became visible" is not something they can observe. It also
        fixes the back button - revealing a card left the browser on /get-quote, so Back
        returned to a filled-in form and people submitted twice.

        Name, phone and estimate travel in sessionStorage, not the query string: a URL
        would put the customer's details and their price into browser history, into any
        link they share, and into our own access logs.
      */
      try {
        sessionStorage.setItem(
          'mpm:quote-result',
          JSON.stringify({
            firstName: name.split(' ')[0],
            phone,
            // Optional on the form, and the strongest signal Meta can match a person on,
            // so it travels when it was given.
            email,
            text: est?.text,
            meta: est?.meta,
          }),
        );
      } catch {
        /* Private mode or a full store: /thank-you falls back to the generic wording. */
      }

      // `replace`, not `assign`, so Back from the thank-you page returns to the site
      // rather than to a form that has already been submitted.
      window.location.replace('/thank-you');
    });
  }
</script>

<style>
  .quote-layout {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 1.5rem;
    max-width: 1080px;
    margin-inline: auto;
    align-items: start;
  }
  .quote-main {
    /* The card's own breathing room. This shared a rule with the retired success card;
       removing that rule orphaned this selector onto the next one, so the padding was
       lost and the fields sat hard against the card's edge. */
    padding: clamp(1.5rem, 4vw, 2.5rem);
    grid-column: 1;
    grid-row: 1;
  }
  .qm-head {
    margin-bottom: 0.9rem;
  }
  .qm-head h2 {
    font-size: clamp(1.4rem, 3vw, var(--text-2xl));
  }
  /* States the payoff before the fields instead of leaving it to be discovered on
     submit. Tinted and iconised so it reads as a promise, not another instruction. */
  .qm-promise {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    margin-bottom: 1rem;
    background: var(--color-brand-50);
    border: 1px solid color-mix(in oklab, var(--color-brand-600) 16%, var(--color-line));
    border-left: 3px solid var(--color-orange-500);
    border-radius: var(--radius-md);
  }
  .qmp-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-600);
    color: #fff;
  }
  .qmp-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .qmp-text strong {
    font-size: var(--text-base);
    line-height: 1.35;
    color: var(--color-ink-900);
  }
  .qmp-text span {
