# systemd timer — rebuilds the site just after each release time in
# packages/shared/src/geo-pages/release.ts, so each page goes live on time. The locality
# batches (09:00 and 18:00 IST) are all out; the Indirapuram Khands now go live one a day at
# 14:00 IST (11 Nov 2026), so it runs at 14:05. Keep these times in step with release.ts.
# The droplet runs on UTC; the times below carry their own time zone.
#
# Install:  sudo bash deploy/install-units.sh
#           sudo systemctl daemon-reload && sudo systemctl enable --now mrpackermover-release.timer
# Next run: systemctl list-timers mrpackermover-release.timer
# It switches itself off when the release is finished (see mrpackermover-release.service).
# To stop it early by hand:  sudo systemctl disable --now mrpackermover-release.timer

[Unit]
Description=MrMoverPacker area page release time (14:05 IST)

[Timer]
OnCalendar=*-*-* 14:05:00 Asia/Kolkata
# A run missed while the droplet was down happens at boot instead.
Persistent=true

[Install]
WantedBy=timers.target
