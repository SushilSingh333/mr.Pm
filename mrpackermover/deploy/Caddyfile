# Caddyfile — MrMoverPacker origin on a single DigitalOcean droplet.
#
# Serves the static Astro site (built to /var/www/mrpackermover) and reverse-proxies
# the Payload admin + API (/admin, /api/*) to the Node app on :3000. TLS is a
# Cloudflare Origin Certificate (see the tls line below), not ACME. Cloudflare sits
# in front and hard-caches the HTML.
#
# The domain comes from /etc/caddy/caddy.env, read by the caddy systemd unit:
#   SITE_DOMAIN=mrmoverpacker.com

{$SITE_DOMAIN} {
	# TLS: a Cloudflare Origin Certificate, not ACME.
	#
	# Caddy's default is Let's Encrypt over the HTTP-01 challenge, which CANNOT renew
	# here: Cloudflare proxies the domain, so Let's Encrypt's validation request never
	# reaches this box and the renewal fails ~60 days in. An Origin Certificate is
	# issued by Cloudflare, is free, lasts 15 years and never renews, so there is no
	# recurring failure mode. It is trusted by Cloudflare rather than by browsers
	# directly, which is exactly right for a proxied origin - set the zone's SSL/TLS
	# mode to "Full (strict)" so Cloudflare verifies it.
	#
	# Generate at: Cloudflare > SSL/TLS > Origin Server > Create Certificate.
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	# Payload admin UI + REST API, including the public JSON endpoints
	# (/api/quote, /api/search, /api/track). Payload sets its own no-store
	# headers on these, so we don't add cache headers here.
	#
	# `/_next/*` MUST be here too: the admin is a Next.js app and loads its JS/CSS
	# chunks from /_next/static/*. Without this they fall through to the static
	# site below, which returns 404.html (HTML where JS is expected) and the admin
	# renders blank.
	@payload path /admin* /api/* /_next/*
	handle @payload {
		reverse_proxy localhost:3000
	}

	# Everything else is the static site.
	handle {
		root * /var/www/mrpackermover

		# HTML/pages: max-age=0 at the browser but s-maxage lets Cloudflare hold
		# the copy for a day and serve stale while it revalidates.
		header Cache-Control "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
		# Hashed, immutable build assets: cache forever.
		@assets path /_astro/* /assets/* /fonts/* /images/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# `build.format: 'file'` emits /foo.html — try the exact file, then .html.
		# `{path}/index.html` is required for directory-style requests: the homepage
		# `/` has no `.html` sibling (`/.html`), so without it the site root 404s.
		try_files {path} {path}.html {path}/index.html /404.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# ── Old domain -> new domain, permanently ────────────────────────────────────
#
# Every old URL redirects to the SAME PATH on the new domain. That detail is the
# whole migration: a blanket redirect to `/` tells Google the old pages no longer
# exist, and their accumulated ranking is discarded rather than transferred.
# `{uri}` carries the path and query string through unchanged, so
# /packers-and-movers/lucknow lands on /packers-and-movers/lucknow.
#
# `permanent` is a 301. Google treats 302 as temporary and keeps indexing the old
# URL, which is exactly what we do not want here.
#
# Cloudflare should ALSO hold a redirect rule on the old zone, which fires at the
# edge before a request ever reaches this box. This block is the backstop for
# traffic that hits the origin directly, and for the period before that rule
# exists. Two layers doing the same 301 is harmless.
#
# Needs its own Origin Certificate covering the old hostname, since the TLS
# handshake happens before the redirect can be issued.
#
# DISABLED. The old domain is being retired rather than redirected. Left here
# commented because an unset OLD_SITE_DOMAIN expands to an empty site address,
# which Caddy refuses to start on - so this must stay commented, not merely
# unset. To re-enable: uncomment the block, install the old domain's cert as
# origin-old.pem/.key, and set OLD_SITE_DOMAIN.
#{$OLD_SITE_DOMAIN} {
#	tls /etc/caddy/certs/origin-old.pem /etc/caddy/certs/origin-old.key
#	redir https://{$SITE_DOMAIN}{uri} permanent
#}
