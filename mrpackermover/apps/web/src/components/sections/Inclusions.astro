---
/** What's included vs what costs extra (Doc 02 §9 step 4), as two clean cards. */
interface Props {
  inclusions: string[];
  exclusions: string[];
}
const { inclusions, exclusions } = Astro.props;
const fallbackIncluded = [
  'Packing & materials',
  'Loading & unloading',
  'Transport',
  'Basic reassembly',
];
const included = inclusions.length ? inclusions : fallbackIncluded;
---

{
  (included.length > 0 || exclusions.length > 0) && (
    <div class="incl-grid">
      <section class="incl-card card incl-yes" aria-label="What's included">
        <div class="incl-head">
          <span class="incl-icon yes" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 12l5 5L20 6" />
            </svg>
          </span>
          <h3>What's included</h3>
        </div>
        <ul class="list-yes">
          {included.map((i) => (
            <li>{i}</li>
          ))}
        </ul>
      </section>

      {exclusions.length > 0 && (
        <section class="incl-card card incl-extra" aria-label="What costs extra">
          <div class="incl-head">
            <span class="incl-icon extra" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
            <h3>What costs extra</h3>
          </div>
          <ul class="list-extra">
            {exclusions.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )
}

<style>
  .incl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    max-width: 900px;
    margin-inline: auto;
  }
  .incl-card {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .incl-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
  }
  .incl-head h3 {
    font-size: var(--text-lg);
  }
  .incl-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
  }
  .incl-icon.yes {
    background: color-mix(in oklab, var(--color-accent-500) 14%, white);
    color: var(--color-accent-600);
  }
  .incl-icon.extra {
    background: color-mix(in oklab, var(--color-warn-500) 14%, white);
    color: var(--color-warn-500);
  }
  .incl-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .incl-card li {
    padding-inline-start: 1.75rem;
    position: relative;
    color: var(--color-ink-700);
  }
  .list-yes li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent-600);
    font-weight: 700;
  }
  .list-extra li::before {
    content: '＋';
    position: absolute;
    left: 0;
    color: var(--color-warn-500);
    font-weight: 700;
  }
</style>
