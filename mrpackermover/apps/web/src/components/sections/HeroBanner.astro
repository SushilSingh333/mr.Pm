---
import type { RateBand, CityHubData, ServiceQuoteMode } from '@mpm/shared';
import HeroShell from './HeroShell.astro';
import QuoteWidget from '../quote/QuoteWidget.astro';
import ServiceEnquiry from '../services/ServiceEnquiry.astro';
import { inlineHtml } from '../../lib/rich-text.js';
import CityModal from '../home/CityModal.astro';
import { rowsOfType, dataOf } from '../../data/manifest.js';

/**
 * Geo-page hero: the shared Porter hero shell with the booking bar as its
 * overlapping card. On city-scoped pages a city chip sits as a tab on top of the
 * bar and opens the shared "Choose your city" modal (so a visitor can switch city
 * without leaving the page). Used by city hub, city × service, locality, route, and
 * service hub — so every page looks identical above the fold.
 */
interface Props {
  h1: string;
  intro: string;
  badge?: string;
  image?: string;
  /** Absolute image URL (e.g. a CMS-uploaded Cloudinary image) — takes precedence over `image`. */
  imageUrl?: string;
  /** What the CMS photo shows; read by screen readers and image search. */
  imageAlt?: string;
  /** When set, shows the city chip + the "Choose your city" modal. */
  cityLabel?: string;
  prefillCity?: string;
  prefillService?: string;
  prefillOrigin?: string;
  prefillDestination?: string;
  bands?: RateBand[];
  roadKm?: number;
  /** HeroShell's layout; `split` for the city, locality and city × service pages. */
  align?: 'center' | 'split';
  /** Breadcrumbs in the banner (the split layout). */
  crumbs?: { href?: string; label: string }[];
  /**
   * The service's own enquiry form in place of the price check, for a service the price
   * check does not fit. The check prices a household move by truck size and floors, which
   * says nothing about shipping a car, a bike or a container abroad, packing on its own, or
   * hiring a loading crew - the same form the service's national page uses.
   */
  enquiry?: { mode: ServiceQuoteMode; serviceName: string; title: string; note?: string };
}
const { h1, intro, badge, image, imageUrl, imageAlt, cityLabel, align, crumbs, enquiry, ...quote } =
  Astro.props;

// City list for the modal (only needed when the chip is shown) — carries each city's
// uploaded thumbnail so the picker matches the hero.
const cities = cityLabel
  ? rowsOfType('city-hub').map((r) => {
      const d = dataOf<CityHubData>(r);
      return { slug: r.slug, name: d.cityName, image: d.heroImage?.url };
    })
  : [];
---

<HeroShell
  h1={h1}
  intro={intro}
  badge={badge}
  image={image}
  imageUrl={imageUrl}
  imageAlt={imageAlt}
  align={align}
  crumbs={crumbs}
>
  {
    enquiry ? (
      <div class="hb-enquiry">
        <p class="hb-enquiry__t">{enquiry.title}</p>
        {enquiry.note && <p class="hb-enquiry__note" set:html={inlineHtml(enquiry.note)} />}
        <ServiceEnquiry mode={enquiry.mode} serviceName={enquiry.serviceName} />
      </div>
    ) : (
      <QuoteWidget {...quote} cityLabel={cityLabel} eager />
    )
  }
</HeroShell>

{cityLabel && <CityModal cities={cities} />}

<style>
  /* The enquiry form's card: the white, softly raised card the service pages use
     (GHero's gh-card), kept to a readable width under the banner. */
  .hb-enquiry {
    max-width: 52rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: 1.75rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(60 64 67 / 0.3),
      0 2px 6px 2px rgb(60 64 67 / 0.15);
  }
  .hb-enquiry__t {
    margin: 0 0 1rem;
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--g-ink);
  }
  .hb-enquiry__note {
    margin: -0.65rem 0 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--g-ink-3);
  }
  .hb-enquiry__note :global(a) {
    color: var(--color-brand-600);
    font-weight: 500;
    text-decoration: none;
  }
</style>
