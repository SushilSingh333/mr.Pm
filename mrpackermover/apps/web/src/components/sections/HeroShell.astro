---
/**
 * The shared Porter hero shell: a dark full-bleed banner with a heading and a card
 * slot that overlaps its bottom edge. `align` controls layout — `center` (routes,
 * corporate), `left` (the homepage) and `split` (city, locality and city × service
 * pages: the words on the left over a shade that darkens only that side, so the crew and
 * truck on the right of the photo stay in full view, with the breadcrumbs in the banner).
 * A `heading` named slot lets a page supply custom heading markup (e.g. a two-line
 * styled tagline); otherwise the plain <h1> is used.
 */
import { cldUrl, CLD_TRANSFORM } from '@mpm/shared';
import { heroAlt } from '../../lib/hero.js';

interface Props {
  h1: string;
  intro?: string;
  badge?: string;
  /** Static-file convention: /images/hero/<image>.jpg (used when `imageUrl` is absent). */
  image?: string;
  /** Absolute image URL (e.g. a CMS-uploaded Cloudinary image) — takes precedence. */
  imageUrl?: string;
  align?: 'center' | 'left' | 'split';
  /** Breadcrumbs drawn inside the banner, in white (the split layout). */
  crumbs?: { href?: string; label: string }[];
  /** Overrides the description looked up from `image`. Needed for CMS uploads. */
  imageAlt?: string;
}
const {
  h1,
  intro,
  badge,
  image = 'home',
  imageUrl,
  align = 'center',
  imageAlt,
  crumbs = [],
} = Astro.props;
// A CMS-uploaded (Cloudinary) image wins; `cldUrl` injects the delivery transform and
// is a no-op for any non-Cloudinary URL. Otherwise fall back to the static file.
// A CMS file name can carry a space ("greater noida-200kb"), which is not valid in a URL.
const resolvedImage = imageUrl
  ? cldUrl(imageUrl, CLD_TRANSFORM.hero).replace(/ /g, '%20')
  : `/images/hero/${image}.jpg`;

/**
 * The banner photograph, as sources for a <picture>.
 *
 * This was a CSS background driven by three custom properties. A background is
 * invisible to a search engine and silent to a screen reader, so nine commissioned
 * photographs could never appear in image search and a blind visitor reached the
 * banner and heard nothing. A real <img> fixes both, and the rendering is identical:
 * `object-fit: cover` with `object-position` reproduces `background-size: cover` with
 * `background-position` exactly.
 *
 * It is also faster. The preload scanner finds <img>/<source> while the HTML is still
 * parsing, whereas a background could not be discovered until the render-blocking CSS
 * had arrived and been parsed. The two hand-written <link rel="preload"> hints that
 * worked around that are no longer needed.
 *
 * A Cloudinary URL is transformed on delivery, so it is used unchanged at both sizes;
 * only the committed files have WebP variants on disk.
 */
const heroSources = imageUrl
  ? { fallback: resolvedImage, narrow: null, full: null }
  : {
      fallback: `/images/hero/${image}.jpg`,
      narrow: `/images/hero/${image}-narrow.webp`,
      full: `/images/hero/${image}-full.webp`,
    };
// The built-in artwork has its own description; a CMS photo is described by the caller,
// never by the artwork's (that described a delivery rider over a city photograph).
const alt = imageAlt ?? (imageUrl ? '' : heroAlt(image));
const hasHeadingSlot = Astro.slots.has('heading');
---

<section class:list={['hero', `align-${align}`]}>
  {
    /*
    Width and height are the artwork's real pixel size. They do not constrain the
    rendered box - the CSS below stretches it to fill the banner - they give the
    browser the aspect ratio up front so it reserves the right space and the heading
    does not jump when the photo arrives.

    fetchpriority="high" because this is the page's Largest Contentful Paint; without
    it the browser treats an <img> as ordinary-priority and the banner lands late.
  */
  }
  <picture class="hero-photo">
    {
      heroSources.full && (
        <source type="image/webp" media="(min-width: 900px)" srcset={heroSources.full} />
      )
    }
    {heroSources.narrow && <source type="image/webp" srcset={heroSources.narrow} />}
    <img
      src={heroSources.fallback}
      alt={alt}
      width="1920"
      height="800"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="container-page hero-inner">
    {
      crumbs.length > 0 && (
        <nav class="hero-crumbs" aria-label="Breadcrumb">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    {badge && <span class="hero-badge">{badge}</span>}
    {hasHeadingSlot ? <slot name="heading" /> : <h1>{h1}</h1>}
    {intro && <p class="hero-intro">{intro}</p>}
  </div>
</section>

{/* `id="quote"`: every "Check my price" button on the page scrolls here. */}
<div class:list={['hero-card', 'container-page', `align-${align}`]} id="quote">
  <slot />
</div>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Still painted, so the banner is near-black rather than white for the moment
       before the photograph decodes - the same black the photo is shaded with. */
    background-color: #0b0b0d;
    color: #fff;
    min-height: clamp(330px, 30vw, 440px);
    padding: clamp(2.25rem, 4.5vw, 3.5rem) 0 clamp(3.5rem, 6vw, 4.75rem);
  }
  /* Light top-to-bottom overlay, matching porter.in exactly (0.65 → 0.15). Keeps
     the photo clearly visible; a text-shadow guarantees heading contrast. */
  /* Reproduces what `background-size: cover` + `background-position` did.
     `object-fit: cover` is the same algorithm, so the crop is unchanged.

     The 25% vertical bias is kept from the background rule: the banner is far wider
     than the photographs (~2.7:1 against ~2.4:1), so cover crops top and bottom.
     Biasing upward keeps faces and the top of the scene visible, and the extra bottom
     crop is hidden behind the booking card that overlaps this section. */
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.15));
    z-index: 1;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hero.align-center {
    text-align: center;
  }
  /* Geo pages: the words sit over a busy, branded photo (crew, truck, logos). A soft
     shade with no edges deepens towards the middle, where the words are, and fades out
     towards the sides, so the heading reads clearly and the photo still shows whole. */
  .hero.align-center::before {
    background:
      radial-gradient(
        ellipse 62% 66% at 50% 46%,
        rgb(8 6 28 / 0.78),
        rgb(8 6 28 / 0.38) 60%,
        transparent 100%
      ),
      linear-gradient(rgb(0 0 0 / 0.42), rgb(0 0 0 / 0.18));
  }
  /* On a phone the lines run nearly edge to edge, past the middle's shade: an even,
     deeper shade instead. */
  @media (max-width: 640px) {
    .hero.align-center::before {
      background: linear-gradient(rgb(8 6 28 / 0.72), rgb(8 6 28 / 0.55));
    }
  }
  .hero.align-center .hero-inner {
    align-items: center;
  }
  .hero.align-center :global(h1) {
    max-width: 22ch;
    letter-spacing: -0.015em;
    line-height: 1.12;
    text-shadow:
      0 2px 4px rgb(0 0 0 / 0.35),
      0 4px 24px rgb(0 0 0 / 0.55);
  }
  /* Wide enough for three lines rather than four. */
  .hero.align-center .hero-intro {
    max-width: 64ch;
    color: #fff;
    text-shadow:
      0 1px 3px rgb(0 0 0 / 0.5),
      0 2px 18px rgb(0 0 0 / 0.6);
  }
  /* ── Split (city, locality, city × service): the words on the left ──
     A shade that darkens only the left side, where the words are, and lifts away to
     nothing across the photo - so the heading reads crisply and the crew and truck on
     the right stay in full view. The breadcrumbs sit in the banner, in white. */
  .hero.align-split {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(400px, 34vw, 500px);
    padding-bottom: clamp(4.25rem, 7vw, 5.75rem);
  }
  .hero.align-split::before {
    background:
      linear-gradient(
        90deg,
        rgb(10 6 34 / 0.92) 0%,
        rgb(10 6 34 / 0.84) 36%,
        rgb(10 6 34 / 0.45) 56%,
        rgb(10 6 34 / 0) 76%
      ),
      linear-gradient(rgb(0 0 0 / 0.18), rgb(0 0 0 / 0) 40%, rgb(10 6 34 / 0.35));
  }
  .hero.align-split .hero-photo img {
    object-position: 70% 25%;
  }
  .hero.align-split .hero-inner {
    align-items: flex-start;
    gap: 0;
    text-align: left;
  }
  .hero.align-split :global(h1) {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(1.75rem, 3.3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }
  .hero.align-split .hero-intro {
    max-width: 36rem;
    margin: 0.875rem 0 0;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.9);
    text-wrap: pretty;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.4);
  }
  .hero-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.7);
  }
  .hero-crumbs a {
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
  }
  .hero-crumbs a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .hero-crumbs [aria-current] {
    color: #fff;
    font-weight: 500;
  }
  @media (max-width: 760px) {
    /* The words run full width on a phone: an even shade, deeper at the foot. */
    .hero.align-split::before {
      background: linear-gradient(rgb(10 6 34 / 0.62), rgb(10 6 34 / 0.8));
    }
    .hero.align-split {
      min-height: 0;
    }
  }

  /* Home: bottom-align the headline so it sits just above the (centered) card. */
  .hero.align-left {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero.align-left .hero-inner {
    align-items: flex-start;
    text-align: left;
  }

  .hero :global(h1),
  .hero-intro,
  .hero-badge {
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* Safety Orange accent. Kept as a translucent wash + solid rule so the
       label stays white-on-dark (high contrast) rather than white-on-orange,
       which is only 3.2:1. */
    background: rgba(255, 85, 0, 0.22);
    border: 1px solid var(--color-orange-500);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.5rem;
  }
  .hero :global(h1) {
    color: #fff;
    font-size: clamp(1.9rem, 4.5vw, var(--text-4xl));
    max-width: 20ch;
  }
  .hero.align-left :global(h1) {
    max-width: 18ch;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    line-height: 1.08;
  }
  .hero-intro {
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--text-lg);
    max-width: 56ch;
    /* Even lines, no lone last word, now the city briefs give the banner a full sentence
       or two. */
    text-wrap: balance;
  }
  /* The overlapping card (booking bar / service selector) is always centered. */
  .hero-card {
    position: relative;
    z-index: 5;
    margin-top: clamp(-3.5rem, -6vw, -2.5rem);
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
  }
</style>
