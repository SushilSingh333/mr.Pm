---
import fs from 'node:fs';
import path from 'node:path';
import { cldUrl, CLD_TRANSFORM, type ManifestLink } from '@mpm/shared';

/**
 * "Cities we serve" — a centered grid of small city cards, each linking to that
 * city's hub (where its areas/localities are listed). A city landmark thumbnail is
 * used when available. This is a page section, NOT a sitewide footer city-dump
 * (Doc 01 §8), so link equity still flows through hierarchy.
 */
interface Props {
  cities: ManifestLink[];
  heading?: string;
  intro?: string;
}
const { cities, heading = 'Cities we serve', intro } = Astro.props;
// Keep the section compact as the city list grows: the first six render
// visible, the rest ship in the HTML (crawlable) but hidden until the visitor
// asks. With six or fewer cities no button renders.
const VISIBLE_CITIES = 6;
const hasMore = cities.length > VISIBLE_CITIES;
const slugOf = (path: string): string => path.split('/').filter(Boolean).pop() ?? '';
// Prefer the city's uploaded (Cloudinary) thumbnail; fall back to the static file.
// Dedicated city artwork exists only for the original cities. A city added later
// (the north India import) has no file yet, so fall back to the brand image rather
// than emitting a src that 404s in the grid.
const cityArt = (slug: string): string | null =>
  fs.existsSync(path.resolve('public/images/hero/cities', `${slug}.jpg`))
    ? `/images/hero/cities/${slug}.jpg`
    : null;
// A 240x240 crop of the brand photograph, not the 1920px hero. The card renders at
// 72x72; pointing it at the full hero meant downloading ~216 KB on top of the hero's
// own WebP to fill a thumbnail.
const thumbFor = (c: ManifestLink): string =>
  c.image
    ? cldUrl(c.image, CLD_TRANSFORM.thumb)
    : (cityArt(slugOf(c.path)) ?? '/images/hero/cities/_default.jpg');
---

<div class="section-head">
  <h2>{heading}</h2>
  {intro && <p>{intro}</p>}
</div>

<div data-cities-block>
  <div class="cities-grid">
    {
      cities.map((c, i) => (
        <a
          class:list={['city-card', { 'city-extra': hasMore && i >= VISIBLE_CITIES }]}
          href={c.path}
          hidden={hasMore && i >= VISIBLE_CITIES}
        >
          <span class="city-thumb">
            {/*
              alt="" on purpose. The link already reads "<city>, View areas & prices",
              so describing the thumbnail too would make a screen reader announce the
              same city twice. An empty alt marks it decorative and it is skipped.
            */}
            <img src={thumbFor(c)} alt="" loading="lazy" width="72" height="72" />
          </span>
          <span class="city-body">
            <strong>{c.anchor}</strong>
            <small>View areas &amp; prices</small>
          </span>
        </a>
      ))
    }
  </div>

  {
    hasMore && (
      <div class="cities-more">
        <button type="button" class="btn btn-ghost" data-show-cities>
          Show all {cities.length} cities
        </button>
      </div>
    )
  }
</div>

<style>
  .cities-more {
    margin-top: 1.1rem;
    text-align: center;
  }

  .cities-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    max-width: 1040px;
    margin-inline: auto;
  }
  .city-card {
    flex: 0 1 232px;
    max-width: 300px;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: var(--color-ink-900);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .city-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-pop);
    text-decoration: none;
  }
  .city-thumb {
    width: 54px;
    height: 54px;
    flex: none;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface-3);
  }
  .city-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .city-body {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .city-body strong {
    font-weight: 600;
  }
  .city-body small {
    color: var(--color-ink-500);
    font-size: var(--text-xs);
  }
  /* Two cities per row on phones. */
  @media (max-width: 560px) {
    .cities-grid {
      gap: 0.6rem;
    }
    .city-card {
      flex: 1 1 calc(50% - 0.3rem);
      max-width: none;
      gap: 0.6rem;
      padding: 0.6rem 0.65rem;
    }
    .city-thumb {
      width: 44px;
      height: 44px;
    }
    .city-body strong {
      font-size: var(--text-sm);
    }
    .city-body small {
      font-size: 11px;
    }
  }
</style>
