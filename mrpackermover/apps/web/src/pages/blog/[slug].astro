---
import { jsonld } from '@mpm/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/ui/Band.astro';
import Prose from '../../components/page/Prose.astro';
import Breadcrumbs from '../../components/nav/Breadcrumbs.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import { formatDate } from '../../lib/format.js';
import { staticRow } from '../../lib/page.js';
import { POSTS, relatedPosts, type BlogPost } from '../../data/blog.js';

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: BlogPost;
}
const { post } = Astro.props;

const row = staticRow({
  path: `/blog/${post.slug}`,
  pageType: 'guide',
  title: post.metaTitle ?? (post.title.length <= 65 ? post.title : `${post.title.slice(0, 62)}…`),
  h1: post.title,
  metaDescription:
    post.metaDescription ??
    (post.excerpt.length <= 175 ? post.excerpt : `${post.excerpt.slice(0, 172)}…`),
  breadcrumbs: [
    { path: '/', anchor: 'Home' },
    { path: '/blog', anchor: 'Blog' },
  ],
});

const related = relatedPosts(post.slug, 3);
const extraJsonLd = [
  jsonld.article({
    headline: post.title,
    authorName: post.author,
    datePublished: post.date,
    dateModified: post.date,
  }),
];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  {
    /* Long-form pages benefit from showing how much is left, and it doubles as the
      only motion here. Decorative, so it is hidden from assistive tech and removed
      under prefers-reduced-motion. */
  }
  <div class="read-progress" aria-hidden="true"><span id="read-bar"></span></div>

  <article class="post">
    <header class="post-head">
      <span class="ph-photo">
        <img src={post.cover} alt={post.coverAlt} width="1920" height="800" decoding="async" />
      </span>
      <div class="container-page post-head-inner">
        <div class="ph-text">
          <Breadcrumbs items={row.breadcrumbs} current={post.category} />
          <span class="post-cat">
            {post.category}
            <span class="pc-rule" aria-hidden="true"></span>
          </span>
          <h1>{post.title}</h1>
          <p class="post-lead">{post.excerpt}</p>
          <div class="post-meta">
            <span>{post.author}</span>
            <span class="dot" aria-hidden="true">·</span>
            <span>{formatDate(post.date)}</span>
            <span class="dot" aria-hidden="true">·</span>
            <span>{post.readMins} min read</span>
          </div>
        </div>
      </div>
    </header>

    <div class="container-page post-body">
      <Prose><Fragment set:html={post.body} /></Prose>
      <div class="post-tags">
        <span class="tags-label">Filed under</span>
        {post.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <a class="back-link" href="/blog">← Back to all articles</a>
    </div>
  </article>

  {
    related.length > 0 && (
      <Band alt label="Related articles">
        <div class="section-head">
          <h2>Keep reading</h2>
        </div>
        <div class="related-grid">
          {related.map((p) => (
            <BlogCard post={p} />
          ))}
        </div>
      </Band>
    )
  }

  <CtaBand
    heading="Ready to move for real?"
    text="Turn the reading into a plan. Get a fixed, itemised quote from a mover you can verify before you book."
    primaryLabel="Get a fixed quote"
    primaryHref="/get-quote"
    secondaryLabel="Talk to us"
    secondaryHref="/company/contact"
  />
</BaseLayout>

<style>
  /* The article opens on its own cover photo rather than the generic blue block that
     every other page uses, with the image and the headline as one composition instead
     of a header slab sitting above a separate picture. The scrim is a brand-blue wash
     over black so white type keeps its contrast whatever photo an editor attaches. */
  .post-head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(330px, 40vw, 470px);
    /* Type sits on flat brand blue, never on the photograph. The covers are brand
       montages carrying their own watermark and a diagonal seam, so a headline laid
       over one competes with artwork instead of leading it. */
    background: linear-gradient(
      120deg,
      var(--color-navy-900) 0%,
      var(--color-navy-800) 55%,
      var(--color-navy-700) 100%
    );
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  /* The cover keeps its own panel, bleeding off the right edge and dissolving into the
     blue so there is no hard seam. */
  .ph-photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: clamp(300px, 47%, 780px);
    z-index: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
  }
  /* The photograph is a real <img> rather than a background so the article's cover can
     be indexed and described. The panel keeps the mask; the blue wash that used to be
     the first background layer is now ::after, which paints over the image and under
     the type - the same order it had in the shorthand. */
  .ph-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .ph-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--color-navy-900) 62%, transparent) 0%,
      color-mix(in oklab, var(--color-navy-900) 14%, transparent) 55%,
      color-mix(in oklab, var(--color-navy-900) 26%, transparent) 100%
    );
  }
  .post-head :global(.breadcrumbs a),
  .post-head :global(.breadcrumbs [aria-current='page']) {
    color: rgba(255, 255, 255, 0.72);
  }
  .post-head :global(.breadcrumbs .sep) {
    color: rgba(255, 255, 255, 0.3);
  }
  .post-head-inner {
    position: relative;
    z-index: 1;
  }
  /* Capped so the headline never runs under the photo panel. */
  .ph-text {
    max-width: min(53%, 620px);
  }
  /* Same category-plus-orange-rule motif the article cards use. */
  .post-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #fff;
    margin-block: 0.9rem 0.75rem;
  }
  .pc-rule {
    height: 2px;
    width: 34px;
    border-radius: 2px;
    background: var(--color-orange-500);
  }
  .post-head h1 {
    font-size: clamp(1.75rem, 3.4vw, var(--text-4xl));
    line-height: 1.12;
    color: #fff;
    margin: 0;
  }
  .post-lead {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.5vw, var(--text-lg));
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
  }
  /* Narrow: the panel cannot hold a photograph beside the type, so the cover moves
     behind it, dropped back and faded out at the bottom to keep the type legible. */
  @media (max-width: 860px) {
    .ph-text {
      max-width: none;
    }
    .ph-photo {
      inset: 0;
      width: 100%;
      opacity: 0.55;
      -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 96%);
      mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 96%);
    }
    /* Vertical rather than horizontal here: the scrim has to be lightest at the top,
       where nothing sits, and heaviest across the headline and lead. It overrides the
       ::after wash rather than the old background layer - the photograph underneath is
       an <img> now, so the gradient can no longer ride in the same shorthand. */
    .ph-photo::after {
      background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-navy-900) 18%, transparent) 0%,
        color-mix(in oklab, var(--color-navy-900) 62%, transparent) 52%,
        color-mix(in oklab, var(--color-navy-900) 88%, transparent) 100%
      );
    }
  }

  /* Reading progress: a hairline that fills as the article scrolls. */
  .read-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--color-brand-600), var(--color-orange-500));
  }
  @media (prefers-reduced-motion: reduce) {
    .read-progress {
      display: none;
    }
  }

  /* Articles read better at a tighter measure than the legal pages Prose is tuned for. */
  .post-body :global(.prose) {
    max-width: 68ch;
  }
  /* The opening paragraph carries the piece, so give it more air and weight.
     Targets the first paragraph rather than a .lead class: rich text authored in the
     CMS has no classes, so keying on markup position is the only reliable hook. */
  .post-body :global(.prose > p:first-of-type),
  .post-body :global(.prose .lead) {
    font-size: clamp(1.15rem, 2.4vw, var(--text-xl));
    line-height: 1.6;
    color: var(--color-ink-900);
    margin-bottom: 1.6rem;
  }
  /* Section heads carry the same orange rule as the cards, so the blog reads as one
     system instead of two unrelated pages. */
  .post-body :global(.prose h2) {
    position: relative;
    padding-top: 1.1rem;
    color: var(--color-ink-900);
  }
  .post-body :global(.prose h2)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-orange-500);
  }
  .post-body :global(.prose blockquote) {
    margin: 1.6rem 0;
    padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 3px solid var(--color-brand-200);
    color: var(--color-ink-900);
    font-size: var(--text-xl);
    line-height: 1.5;
  }

  .post-cover {
    max-width: 1080px;
    margin: clamp(1.25rem, 3vw, 2rem) auto 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    aspect-ratio: 2 / 1;
    background: var(--color-surface-3);
  }
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-body {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 68ch;
    width: 100%;
    margin-top: 2.5rem;
  }
  .tags-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    align-self: center;
    margin-right: 0.15rem;
  }
  .tag {
    font-size: var(--text-sm);
    color: var(--color-ink-500);
    background: var(--color-surface-2);
    border: 1px solid var(--color-line);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
  }
  .back-link {
    align-self: flex-start;
    max-width: 78ch;
    width: 100%;
    margin-top: 2rem;
    font-weight: 600;
    color: var(--color-brand-700);
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 1120px;
    margin-inline: auto;
  }
  @media (max-width: 860px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Width of the progress hairline = how far through the article body we are.
  // Reads layout only inside rAF, and stays silent when the reader prefers
  // reduced motion (the bar is hidden by CSS in that case anyway).
  const bar = document.getElementById('read-bar');
  const article = document.querySelector('.post-body');
  if (bar && article && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = (): void => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const done = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      bar.style.width = `${done * 100}%`;
      ticking = false;
    };
    const onScroll = (): void => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
