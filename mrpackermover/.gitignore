# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.next-dev/
.astro/
.turbo/
*.tsbuildinfo

# Generated artefacts
manifest.json
apps/web/src/data/manifest.json
apps/web/public/sitemap*.xml
apps/web/public/robots.txt
# Payload regenerates this on dev/build; the committed copy lives in packages/shared.
apps/cms/src/payload-types.ts

# Env & secrets
.env
.env.*
!.env.example
.dev.vars
.wrangler/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/

# Local-disk uploads. With Cloudinary configured (production) Media is stored on the
# CDN and this folder never appears; without the secrets (local dev, CI) Payload falls
# back to disk here. These are developer test uploads, not source - keep them out of
# the repo so they can never be pushed or end up in a production image.
apps/cms/media/
