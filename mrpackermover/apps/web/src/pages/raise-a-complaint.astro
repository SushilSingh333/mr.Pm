---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import Band from '../components/ui/Band.astro';
import FeatureGrid from '../components/page/FeatureGrid.astro';
import { iconSvg } from '../lib/icons.js';
import { staticRow, org, editorialFor } from '../lib/page.js';
import { PHONE_DISPLAY, PHONE_TEL, EMAIL } from '../lib/site.js';

const ed = editorialFor('raise-a-complaint');
const row = staticRow({
  path: '/raise-a-complaint',
  pageType: 'core',
  title: ed.metaTitle ?? 'Raise a Complaint | MrPackerMover',
  h1: ed.title ?? 'Raise a complaint — and get it tracked to closure',
  metaDescription:
    ed.seoDescription ??
    'How to raise a complaint with MrPackerMover: the channels, what to include, our response commitment, and how to escalate to our grievance officer if it isn’t resolved.',
  breadcrumbs: [{ path: '/', anchor: 'Home' }],
});
const o = org();

const phoneRaw = PHONE_DISPLAY;
const tel = PHONE_TEL;
const email = EMAIL;

const steps = [
  {
    title: 'You raise it',
    body: 'Contact your coordinator first, or use the channels below. You’ll get an acknowledgement with a complaint reference.',
  },
  {
    title: 'We investigate',
    body: 'We review your complaint against the record — your inventory, packing photos and coordinator notes — and come back with findings.',
  },
  {
    title: 'We resolve or escalate',
    body: 'We agree a fix: a repair, replacement, refund or claim settlement. Not satisfied? It escalates to our grievance officer.',
  },
  {
    title: 'We close & learn',
    body: 'Once resolved, the case is logged. Patterns feed back into crew training — which is how the same issue stops recurring.',
  },
];
---

<BaseLayout row={row}>
  <PageHero
    dark
    eyebrow={ed.eyebrow ?? 'We’re listening'}
    h1={row.h1}
    intro={ed.intro ??
      'Something went wrong, or just didn’t meet the bar we set? Tell us properly. Every complaint gets a reference, a real investigation, and a defined path to closure.'}
    breadcrumbs={row.breadcrumbs}
    current="Raise a complaint"
  />

  <Band label="How to raise it">
    <div class="raise-grid">
      <a class="raise-card card" href={`tel:${tel}`}>
        <span
          class="rc-icon"
          set:html={`<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>${iconSvg('phone')}</svg>`}
        />
        <strong>Call us</strong>
        <span>{phoneRaw}</span>
      </a>
      <a class="raise-card card" href={`mailto:${email}?subject=Complaint`}>
        <span
          class="rc-icon"
          set:html={`<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>${iconSvg('mail')}</svg>`}
        />
        <strong>Email grievances</strong>
        <span>{email}</span>
      </a>
      <a class="raise-card card" href="/company/contact">
        <span
          class="rc-icon"
          set:html={`<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>${iconSvg('headset')}</svg>`}
        />
        <strong>Contact form</strong>
        <span>All the ways to reach us</span>
      </a>
    </div>
    {
      o?.complaintSla && (
        <p class="sla">
          <span class="sla-badge">Our commitment</span> {o.complaintSla}
        </p>
      )
    }
  </Band>

  <Band alt label="What to include">
    <div class="include-box card">
      <h2>What to include</h2>
      <p>The more of this you can share, the faster we can resolve it:</p>
      <ul class="include-list">
        <li>Your <strong>job reference</strong> (from your confirmation or invoice)</li>
        <li>The move date and pickup/drop cities</li>
        <li>A clear description of what went wrong</li>
        <li>Photos of any affected items, with their packing if possible</li>
        <li>What outcome you’re looking for</li>
      </ul>
      <p class="include-note">
        If it concerns damage or loss, keep the item and its packaging until the case is closed — it
        helps the assessment. See how settlements work on our <a href="/claims">claims page</a>.
      </p>
    </div>
  </Band>

  <Band label="What happens next">
    <div class="section-head">
      <h2>What happens after you raise it</h2>
      <p>A defined four-step path — no black hole, no being passed around.</p>
    </div>
    <FeatureGrid items={steps} columns={4} numbered />
  </Band>

  <Band alt label="Escalation">
    <div class="escalate card">
      <span
        class="esc-icon"
        set:html={`<svg viewBox='0 0 24 24' width='24' height='24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>${iconSvg('scale')}</svg>`}
      />
      <div>
        <h2>Not resolved? Escalate to our grievance officer</h2>
        <p>
          If your complaint isn’t resolved to your satisfaction, ask for it to be escalated to our
          grievance officer, who reviews it independently of the team involved. Email{' '}
          <a href={`mailto:${email}?subject=Escalation`}>{email}</a> with your complaint reference and
          “Escalation” in the subject.
        </p>
        <p class="esc-note">
          Grievance officer contact details are being finalised before launch and will be named here
          in full.
        </p>
      </div>
    </div>
  </Band>
</BaseLayout>

<style>
  .raise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 900px;
    margin-inline: auto;
  }
  .raise-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.6rem;
    text-decoration: none;
    text-align: left;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .raise-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
    text-decoration: none;
  }
  .rc-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-md);
    background: var(--color-brand-50);
    color: var(--color-brand-600);
    margin-bottom: 0.5rem;
  }
  .raise-card strong {
    color: var(--color-ink-900);
  }
  .raise-card span {
    color: var(--color-ink-500);
    font-size: var(--text-sm);
  }
  .sla {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: var(--color-ink-700);
  }
  .sla-badge {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-600);
    background: color-mix(in oklab, var(--color-accent-500) 13%, white);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
  }

  .include-box {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  .include-box h2 {
    font-size: clamp(1.35rem, 3vw, var(--text-2xl));
    margin-bottom: 0.5rem;
  }
  .include-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 1rem 0;
  }
  .include-list li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--color-ink-700);
  }
  .include-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent-600);
    font-weight: 800;
  }
  .include-note {
    color: var(--color-ink-500);
    font-size: var(--text-base);
  }

  .escalate {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  .esc-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: linear-gradient(140deg, var(--color-navy-600), var(--color-navy-800));
    color: #fff;
    box-shadow: 0 6px 16px rgba(9, 35, 65, 0.28);
  }
  .escalate h2 {
    font-size: clamp(1.25rem, 3vw, var(--text-xl));
    margin-bottom: 0.5rem;
  }
  .esc-note {
    margin-top: 0.65rem;
    font-size: var(--text-sm);
    color: var(--color-ink-500);
  }
  @media (max-width: 720px) {
    .raise-grid {
      grid-template-columns: 1fr;
    }
    .escalate {
      flex-direction: column;
    }
  }
</style>
