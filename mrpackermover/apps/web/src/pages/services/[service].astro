---
import type { ServiceHubData, ServicePage } from '@mpm/shared';
import {
  CLD_TRANSFORM,
  SERVICE_PAGE_LABELS,
  cldUrl,
  pageWithCityCount,
  plainText,
  serviceCopy,
  servicePage,
} from '@mpm/shared';
import { jsonld } from '@mpm/seo';
import { rowsOfType, dataOf } from '../../data/manifest.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceEnquiry from '../../components/services/ServiceEnquiry.astro';
import GPage from '../../components/g/GPage.astro';
import GHero from '../../components/g/GHero.astro';
import GBody from '../../components/g/GBody.astro';
import GFaqBand from '../../components/g/GFaqBand.astro';
import GLinkBand from '../../components/g/GLinkBand.astro';
import GCtaPanel from '../../components/g/GCtaPanel.astro';
import { bandTones, tocOf, withIds } from '../../lib/page-sections.js';
import { SITE_ORIGIN } from '../../lib/site.js';
import { heroAlt, heroForService } from '../../lib/hero.js';
import { paragraphsHtml } from '../../lib/rich-text.js';

/**
 * National service page (/services/<slug>), in Google's Material style: a light hero with
 * the enquiry form in its own card (GHero), then everything on one centre line: section
 * tabs, the sections as alternating white / tinted bands, the FAQs as expansion panels,
 * the cities as cards, and the brand-blue closing panel.
 *
 * Every service page uses exactly these pieces in this order; only the brief's words
 * differ. The copy comes finished from the manifest - the brief with the editor's
 * "Service page" fields laid over it - and the committed sample manifest CI builds from
 * has none, so there the brief itself stands in.
 */
export function getStaticPaths() {
  return rowsOfType('service-hub')
    .filter((row) => row.path.startsWith('/services/'))
    .map((row) => ({ params: { service: row.slug }, props: { row } }));
}

const { row } = Astro.props;
const data = dataOf<ServiceHubData>(row);

// Only the cities that actually offer this service - never a city whose
// /packers-and-movers/<city>/<service> page does not exist.
const cityLinks = row.relatedLinks.filter((l) => l.group === 'cities');
// "Bike transport in Delhi": the sentence-case name, whatever capitals the CMS record
// uses. The city is the part after the last " in ".
const svcName = serviceCopy(row.slug)?.name ?? data.serviceName;
const cityOf = (anchor: string): string => anchor.replace(/^.* in /, '');

const brief = servicePage(row.slug);
const page: ServicePage =
  data.page ??
  (brief
    ? pageWithCityCount(brief, cityLinks.length || rowsOfType('city-hub').length)
    : {
        // A service with no brief at all: a plain page that is still true.
        title: row.title,
        metaDescription: row.metaDescription ?? '',
        h1: row.h1,
        subhead: `${data.serviceName} by our own trained crews, on one fixed, written quote.`,
        trust: [],
        quoteMode: 'home',
        quoteNote: '',
        sections: [{ heading: "What's included", blocks: [{ kind: 'scope' }] }],
        faqHeading: '',
        faqs: [],
        citiesHeading: 'Cities we serve',
        citiesIntro: '',
        ctaHeading: 'Get one fixed, written price',
        ctaText: 'Tell us what you are moving and where. A real person calls you back.',
        related: [{ label: 'All services', href: '/services' }],
        serviceType: data.serviceName,
      });

// Anchors for the "On this page" list: one per headed section. The page breaks before the
// FAQs, which run full width below with the cities.
const sections = withIds(page.sections);
const toc = tocOf(sections);

// The bands after the sections carry on their white / tinted alternation.
const tone = bandTones(sections.length);
const tones = {
  faq: page.faqs.length > 0 ? tone() : 'white',
  cities: cityLinks.length > 0 ? tone() : 'white',
  cta: tone(),
};

const faqs = page.faqs.map((f) => ({
  question: f.question,
  answer: plainText(f.answer),
  html: paragraphsHtml(f.answer),
}));

const image = heroForService(row.slug);
// The photo: the one uploaded in the CMS (Cloudinary, sized for a banner), or the built-in
// files for this service. Both slots - the strip and the photo under the heading - use it.
const photo = page.photo
  ? {
      wide: cldUrl(page.photo.url, CLD_TRANSFORM.hero),
      narrow: cldUrl(page.photo.url, CLD_TRANSFORM.hero),
      fallback: cldUrl(page.photo.url, CLD_TRANSFORM.hero),
      alt: page.photo.alt || heroAlt(image),
    }
  : {
      wide: `/images/hero/${image}-full.webp`,
      narrow: `/images/hero/${image}-narrow.webp`,
      fallback: `/images/hero/${image}.jpg`,
      alt: heroAlt(image),
    };
const webp = !page.photo; // only the built-in files have WebP variants on disk

// The small fixed words, from the CMS where an editor set them.
const L = {
  chip: page.chip || SERVICE_PAGE_LABELS.chip,
  cardTitle: page.cardTitle || SERVICE_PAGE_LABELS.cardTitle,
  ctaCheck: page.ctaCheck || SERVICE_PAGE_LABELS.ctaCheck,
  ctaCall: page.ctaCall || SERVICE_PAGE_LABELS.ctaCall,
  ctaWhatsapp: page.ctaWhatsapp || SERVICE_PAGE_LABELS.ctaWhatsapp,
};

const extraJsonLd = [
  jsonld.service({
    siteOrigin: SITE_ORIGIN,
    name: row.h1,
    serviceType: page.serviceType,
    description: plainText(page.subhead),
    // The cities it picks up from, as the brief's schema asks; India when none are live.
    areaServed: cityLinks.length ? cityLinks.map((l) => cityOf(l.anchor)) : 'India',
  }),
  jsonld.faqPage(faqs.map((f) => ({ question: f.question, answer: f.answer }))),
];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  <GPage tint>
    <GHero
      crumbs={[
        { href: '/', label: 'Home' },
        { href: '/services', label: 'Services' },
        { label: svcName },
      ]}
      h1={row.h1}
      sub={page.subhead}
      trust={page.trust}
      photo={{ ...photo, webp }}
      chip={L.chip}
      cardTitle={L.cardTitle}
      cardNote={page.quoteNote}
    >
      <ServiceEnquiry mode={page.quoteMode} serviceName={data.serviceName} />
    </GHero>

    <GBody
      sections={sections}
      toc={toc}
      inclusions={data.inclusions}
      exclusions={data.exclusions}
    />

    <GFaqBand heading={page.faqHeading} faqs={faqs} tone={tones.faq} />

    <GLinkBand
      id="cities"
      heading={page.citiesHeading}
      intro={page.citiesIntro}
      links={cityLinks.map((l) => ({ href: l.path, label: cityOf(l.anchor), sub: svcName }))}
      tone={tones.cities}
    />

    <GCtaPanel
      heading={page.ctaHeading}
      text={page.ctaText}
      labels={{ check: L.ctaCheck, call: L.ctaCall, whatsapp: L.ctaWhatsapp }}
      related={page.related}
      tone={tones.cta}
    />
  </GPage>
</BaseLayout>
