---
import './quote.css';

/**
 * Booking bar + instant estimator. The bar design is our existing Porter bar
 * (Pickup · Drop · Phone · Shifting Date · Check Price) — unchanged. Interactivity
 * is a plain client script (not a hydrated island), so "Check Price" always works
 * and can never trigger a page reload. The pricing maths lives in ./pricing.ts.
 */
interface Props {
  prefillCity?: string;
  prefillService?: string;
  prefillOrigin?: string;
  prefillDestination?: string;
  cityLabel?: string;
  // Accepted for backward-compat with existing callers; unused by the estimator.
  bands?: unknown;
  roadKm?: number;
  turnstileSiteKey?: string;
  eager?: boolean;
}
const { prefillCity, prefillService, prefillOrigin, prefillDestination } = Astro.props;
const pickupValue = prefillOrigin ?? prefillCity ?? '';
const dropValue = prefillDestination ?? '';
const service = prefillService ?? '';
---

<div class="booking-shell" data-service={service}>
  <div class="booking-bar" role="group" aria-label="Get a fixed quote">
    <div class="bar-fields">
      <label class="bar-field">
        <span class="bar-label">Full Name <b>*</b></span>
        <input id="q-name" type="text" autocomplete="name" placeholder="Your name" />
      </label>
      <label class="bar-field">
        <span class="bar-label">Pickup Location <b>*</b></span>
        <input
          id="q-pickup"
          type="text"
          value={pickupValue}
          placeholder="Sending from"
          autocomplete="off"
        />
      </label>
      <label class="bar-field">
        <span class="bar-label">Drop Location <b>*</b></span>
        <input
          id="q-drop"
          type="text"
          value={dropValue}
          placeholder="Sending to"
          autocomplete="off"
        />
      </label>
      <label class="bar-field">
        <span class="bar-label">Phone Number <b>*</b></span>
        <input
          id="q-phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="Enter Contact Details"
        />
      </label>
      <label class="bar-field">
        <span class="bar-label">Shifting Date <b>*</b></span>
        <input id="q-date" type="date" />
      </label>
    </div>
    <button type="button" class="btn btn-primary bar-cta" id="q-go">
      Check Price
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </button>
  </div>

  <!-- Estimator (revealed on Check Price) -->
  <div class="est" id="q-est" hidden>
    <div class="est-top">
      <div>
        <div class="est-amt-row">
          <span class="est-amt" id="q-amt">₹0</span>
          <span class="est-gst">+ GST</span>
        </div>
        <div class="est-lane" id="q-lane"></div>
      </div>
      <a class="btn btn-primary" id="q-cta" href="/get-quote">Get a fixed quote</a>
    </div>

    <div class="est-body">
      <div class="est-inputs">
        <h4>Adjust the details</h4>
        <div class="est-row">
          <label class="est-ctrl">
            <span>Truck size</span>
            <select id="q-size">
              <option value="10">10 ft</option>
              <option value="12">12 ft</option>
              <option value="14" selected>14 ft</option>
              <option value="15">15 ft</option>
              <option value="16">16 ft</option>
              <option value="17">17 ft</option>
              <option value="19">19 ft</option>
            </select>
          </label>
          <label class="est-ctrl">
            <span>Packing</span>
            <select id="q-pack">
              <option value="basic" selected>Basic — cartons + wrap</option>
              <option value="standard">Standard — 3-layer + crates</option>
            </select>
          </label>
        </div>
        <div class="est-row">
          <label class="est-ctrl">
            <span>Pickup floor</span>
            <select id="q-ffloor"
              ><option value="0">Ground</option><option value="1">1st</option><option value="2"
                >2nd</option
              ><option value="3">3rd</option><option value="4">4th</option><option value="5"
                >5th+</option
              ></select
            >
          </label>
          <label class="est-ctrl">
            <span>Lift at pickup</span>
            <select id="q-flift"><option value="1">Yes</option><option value="0">No</option></select
            >
          </label>
        </div>
        <div class="est-row">
          <label class="est-ctrl">
            <span>Drop floor</span>
            <select id="q-tfloor"
              ><option value="0">Ground</option><option value="1">1st</option><option value="2"
                >2nd</option
              ><option value="3">3rd</option><option value="4">4th</option><option value="5"
                >5th+</option
              ></select
            >
          </label>
          <label class="est-ctrl">
            <span>Lift at drop</span>
            <select id="q-tlift"><option value="1">Yes</option><option value="0">No</option></select
            >
          </label>
        </div>
      </div>
    </div>

    <div class="est-foot">
      <span>Built from our published rate card · accurate to about ±6% before survey.</span>
      <span>A free 10-minute video survey turns this into one fixed number.</span>
    </div>
  </div>
</div>

<script>
  import { quote, inr } from './estimator';
  import type { QuoteInput } from './estimator';
  import { attachAutocomplete, drivingDistanceKm, geocodeState } from './maps';
  import { PLACES, resolvePlace, routeDistanceKm } from './pricing';

  const byId = <T extends HTMLElement = HTMLElement>(id: string): T =>
    document.getElementById(id) as T;
  const root = document.querySelector<HTMLElement>('.booking-shell');

  if (root) {
    const DROP_DEFAULT = PLACES.find((p) => p.name === 'Sector 62') ?? PLACES[0];
    const service = root.dataset.service ?? '';
    const est = byId('q-est');

    // The user now picks the truck size (ft) directly; crew grows on the bigger trucks.
    const labourForTruck = (ft: number): number => (ft >= 17 ? 6 : ft >= 15 ? 5 : 4);

    // Inter-state detection for the permit/tax surcharge. Google gives the real state;
    // the NCR fallback maps a resolved place's zone to its state when there's no key.
    const ZONE_STATE: Record<string, string> = {
      'South Delhi': 'Delhi',
      'West Delhi': 'Delhi',
      'North Delhi': 'Delhi',
      'East Delhi': 'Delhi',
      Noida: 'Uttar Pradesh',
      Ghaziabad: 'Uttar Pradesh',
      Gurugram: 'Haryana',
      Faridabad: 'Haryana',
    };
    const zoneState = (text: string): string | null =>
      ZONE_STATE[resolvePlace(text, PLACES[0]).zone] ?? null;
    let lastInterState = false;

    // Hill / mountain destinations get a surcharge on the truck line (see move-pricing.ts).
    // Auto-detected from the drop location text; extend this list as needed.
    const HILL_DESTINATIONS = [
      'almora',
      'nainital',
      'ranikhet',
      'mukteshwar',
      'kausani',
      'bhimtal',
      'mussoorie',
      'mussorie',
      'dhanaulti',
      'chakrata',
      'joshimath',
      'auli',
      'pithoragarh',
      'bageshwar',
      'uttarkashi',
      'shimla',
      'manali',
      'kullu',
      'dharamshala',
      'dharamsala',
      'mcleodganj',
      'dalhousie',
      'kasauli',
      'solan',
      'chail',
      'kufri',
      'spiti',
      'kalpa',
      'gangtok',
      'darjeeling',
      'kalimpong',
      'shillong',
      'tawang',
      'gulmarg',
      'pahalgam',
      'sonamarg',
      'leh',
      'ladakh',
      'ooty',
      'kodaikanal',
      'munnar',
      'coonoor',
      'wayanad',
      'coorg',
      'madikeri',
      'mount abu',
      'mahabaleshwar',
      'lonavala',
      'panchgani',
      'matheran',
    ];
    const isHillDestination = (text: string): boolean => {
      const t = text.toLowerCase();
      return HILL_DESTINATIONS.some((w) => t.includes(w));
    };
    let lastHill = false;

    // Address dropdowns via Google Places (silently no-ops without an API key).
    void attachAutocomplete(byId<HTMLInputElement>('q-pickup'));
    void attachAutocomplete(byId<HTMLInputElement>('q-drop'));

    let lastKm = 0; // cached driving distance so tweaking sliders doesn't re-hit the API

    function readInputs() {
      return {
        name: byId<HTMLInputElement>('q-name').value,
        pickup: byId<HTMLInputElement>('q-pickup').value,
        drop: byId<HTMLInputElement>('q-drop').value,
        phone: byId<HTMLInputElement>('q-phone').value,
        truck: +byId<HTMLSelectElement>('q-size').value,
        pack: byId<HTMLSelectElement>('q-pack').value as 'basic' | 'standard',
        fFloor: +byId<HTMLSelectElement>('q-ffloor').value,
        fLift: +byId<HTMLSelectElement>('q-flift').value === 1,
        tFloor: +byId<HTMLSelectElement>('q-tfloor').value,
        tLift: +byId<HTMLSelectElement>('q-tlift').value === 1,
        date: byId<HTMLInputElement>('q-date').value,
      };
    }

    function render(km: number): void {
      const o = readInputs();
      const input: QuoteInput = {
        distanceKm: Math.round(km),
        mode: 'auto',
        truckFt: o.truck,
        labour: labourForTruck(o.truck),
        packing: true,
        pickupFloor: o.fFloor,
        pickupLift: o.fLift,
        dropFloor: o.tFloor,
        dropLift: o.tLift,
        hillDestination: lastHill,
        interState: lastInterState,
        packingGrade: o.pack,
        date: o.date,
      };
      const r = quote(input);

      byId('q-amt').textContent = `${inr(r.rangeLow)} – ${inr(r.rangeHigh)}`;

      // Highlighted chips below the price: truck size + distance stand out (brand pills),
      // move type is a neutral pill. Content is all numbers / fixed strings — safe to inject.
      // (Hill surcharge is still applied to the price via hillDestination; it's just not
      // surfaced to the customer.)
      const modeText = r.mode === 'intercity' ? 'Intercity move' : 'Local move';
      const truckIcon =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h2"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/></svg>';
      const distIcon =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><path d="M6 9l-3 3 3 3"/><path d="M18 9l3 3-3 3"/></svg>';
      byId('q-lane').innerHTML =
        `<span class="lane-chip">${truckIcon}${o.truck} ft truck</span>` +
        `<span class="lane-chip">${distIcon}${Math.round(km)} km</span>` +
        `<span class="lane-chip lane-chip-mode">${modeText}</span>`;

      const cta = byId<HTMLAnchorElement>('q-cta');
      cta.href =
        `/get-quote?from=${encodeURIComponent(o.pickup)}&to=${encodeURIComponent(o.drop)}` +
        (o.name ? `&name=${encodeURIComponent(o.name)}` : '') +
        (o.phone ? `&phone=${encodeURIComponent(o.phone)}` : '') +
        (service ? `&service=${encodeURIComponent(service)}` : '');
      est.hidden = false;
    }

    // Driving distance: Google Distance Matrix first, else the built-in haversine estimate.
    async function fetchDistanceKm(): Promise<number> {
      const o = readInputs();
      const g = await drivingDistanceKm(o.pickup, o.drop);
      if (g != null && g > 0) return g;
      const from = resolvePlace(o.pickup, PLACES[0]);
      const to = resolvePlace(o.drop, DROP_DEFAULT);
      return Math.round(routeDistanceKm(from, to));
    }

    // Capture the price check as a lead (source = price-check) once a name + valid phone
    // are present — so every price check reaches the CMS. Fire-and-forget; never blocks UI.
    let lastSentPhone = '';
    function capturePriceCheck(): void {
      const o = readInputs();
      const phone = o.phone.trim();
      const name = o.name.trim();
      if (name.length < 2 || !/^[+0-9 ()-]{8,}$/.test(phone) || phone === lastSentPhone) return;
      lastSentPhone = phone;
      try {
        void fetch('/api/quote', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            source: 'price-check',
            name,
            pickup: o.pickup,
            drop: o.drop,
            phone,
            date: o.date,
            size: `${o.truck} ft`,
            service,
          }),
        }).catch(() => {});
      } catch {
        /* no-op */
      }
    }

    byId('q-go').addEventListener('click', async () => {
      const o = readInputs();
      const [km, ps, ds] = await Promise.all([
        fetchDistanceKm(),
        geocodeState(o.pickup),
        geocodeState(o.drop),
      ]);
      lastKm = km;
      const pState = ps ?? zoneState(o.pickup);
      const dState = ds ?? zoneState(o.drop);
      lastInterState = Boolean(pState && dState && pState !== dState);
      lastHill = isHillDestination(o.drop);
      render(lastKm);
      capturePriceCheck();
    });
    ['q-size', 'q-pack', 'q-ffloor', 'q-flift', 'q-tfloor', 'q-tlift', 'q-date'].forEach((id) =>
      byId(id).addEventListener('change', () => {
        if (!est.hidden) render(lastKm);
      }),
    );
  }
</script>
