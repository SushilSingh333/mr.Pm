---
import type { BlogPost } from '../../data/blog.js';
import { formatDate } from '../../lib/format.js';

/**
 * An article card on /blog and in "Keep reading".
 *
 * The category sits above the headline with a Safety Orange rule that runs out to full
 * width on hover, borrowing the brand's own motif: a checked line on a written record.
 * It replaces the floating pill that used to sit on the photo, where it competed with
 * whatever the image happened to show.
 *
 * Cards stretch to equal height (`height: 100%` plus a column layout) so a row of
 * three with different excerpt lengths still lines up along the bottom.
 */
interface Props {
  post: BlogPost;
}
const { post } = Astro.props;
---

<article class="blog-card" data-category={post.category}>
  <a class="bc-link" href={`/blog/${post.slug}`}>
    <div class="bc-media">
      <img
        src={post.cover}
        alt={post.coverAlt}
        loading="lazy"
        decoding="async"
        width="640"
        height="360"
      />
    </div>
    <div class="bc-body">
      <span class="bc-cat">
        {post.category}
        <span class="bc-rule" aria-hidden="true"></span>
      </span>
      <h3 class="bc-title">{post.title}</h3>
      <p class="bc-excerpt">{post.excerpt}</p>
      <div class="bc-meta">
        <time datetime={post.date}>{formatDate(post.date)}</time>
        <span class="bc-dot" aria-hidden="true">·</span>
        <span>{post.readMins} min read</span>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    height: 100%;
  }
  .bc-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .bc-link:hover,
  .bc-link:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
    border-color: color-mix(in oklab, var(--color-brand-600) 22%, var(--color-line));
    text-decoration: none;
  }
  .bc-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-3);
  }
  .bc-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .bc-link:hover .bc-media img {
    transform: scale(1.04);
  }
  .bc-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.15rem 1.35rem 1.3rem;
    flex: 1;
  }
  /* Category + the rule that reads as a checked line. */
  .bc-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-brand-600);
  }
  .bc-rule {
    height: 2px;
    width: 18px;
    background: var(--color-orange-500);
    border-radius: 2px;
    transition: width var(--dur-base) var(--ease-out);
  }
  .bc-link:hover .bc-rule,
  .bc-link:focus-visible .bc-rule {
    width: 46px;
  }
  .bc-title {
    font-size: var(--text-xl);
    line-height: 1.22;
    color: var(--color-ink-900);
    margin: 0;
  }
  .bc-excerpt {
    color: var(--color-ink-500);
    font-size: var(--text-base);
    line-height: 1.55;
    flex: 1;
    margin: 0;
  }
  .bc-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-ink-500);
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-line);
    margin-top: 0.35rem;
  }
</style>
