# systemd timer — rebuilds the site just after each locality release time, 09:00 and
# 18:00 IST (packages/shared/src/geo-pages/release.ts), so each batch goes live on time.
# The droplet runs on UTC; the times below carry their own time zone.
#
# Install:  sudo bash deploy/install-units.sh
#           sudo systemctl daemon-reload && sudo systemctl enable --now mrpackermover-release.timer
# Next run: systemctl list-timers mrpackermover-release.timer
# Once the last batch is out it can be switched off:
#           sudo systemctl disable --now mrpackermover-release.timer

[Unit]
Description=MrMoverPacker locality release times (09:05 and 18:05 IST)

[Timer]
OnCalendar=*-*-* 09:05:00 Asia/Kolkata
OnCalendar=*-*-* 18:05:00 Asia/Kolkata
# A run missed while the droplet was down happens at boot instead.
Persistent=true

[Install]
WantedBy=timers.target
