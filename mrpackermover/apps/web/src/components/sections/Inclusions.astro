---
/** What's included vs what costs extra (Doc 02 §9 step 4), as two clean cards. */
interface Props {
  inclusions: string[];
  exclusions: string[];
}
const { inclusions, exclusions } = Astro.props;
const fallbackIncluded = [
  'Packing & materials',
  'Loading & unloading',
  'Transport',
  'Basic reassembly',
];
const included = inclusions.length ? inclusions : fallbackIncluded;
const hasExtra = exclusions.length > 0;
---

{
  included.length > 0 && (
    <div class:list={['incl-grid', { single: !hasExtra }]}>
      <section class="incl-card yes" aria-label="What's included">
        <header class="incl-head">
          <span class="incl-badge yes" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 12l5 5L20 6" />
            </svg>
          </span>
          <span class="incl-title">
            <h3>What's included</h3>
            <small>{included.length} in every quote — no asterisks</small>
          </span>
        </header>
        <ul>
          {included.map((i) => (
            <li>
              <span class="mark yes" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 12l5 5L20 6" />
                </svg>
              </span>
              <span>{i}</span>
            </li>
          ))}
        </ul>
      </section>

      {hasExtra && (
        <section class="incl-card extra" aria-label="What costs extra">
          <header class="incl-head">
            <span class="incl-badge extra" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
            <span class="incl-title">
              <h3>What costs extra</h3>
              <small>Optional add-ons — itemised up front, never a surprise</small>
            </span>
          </header>
          <ul>
            {exclusions.map((i) => (
              <li>
                <span class="mark extra" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    width="13"
                    height="13"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )
}

<style>
  .incl-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    max-width: 940px;
    margin-inline: auto;
  }
  .incl-grid.single {
    grid-template-columns: 1fr;
    max-width: 560px;
  }

  .incl-card {
    position: relative;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  /* A coloured accent strip along the top edge tells the two cards apart at a glance. */
  .incl-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
  }
  .incl-card.yes::before {
    background: var(--color-accent-500);
  }
  .incl-card.extra::before {
    background: var(--color-warn-500);
  }

  .incl-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .incl-badge {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: var(--radius-md);
  }
  .incl-badge.yes {
    background: color-mix(in oklab, var(--color-accent-500) 15%, white);
    color: var(--color-accent-600);
  }
  .incl-badge.extra {
    background: color-mix(in oklab, var(--color-warn-500) 16%, white);
    color: var(--color-warn-500);
  }
  .incl-title h3 {
    font-size: var(--text-lg);
    line-height: 1.15;
  }
  .incl-title small {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--text-xs);
    color: var(--color-ink-500);
  }

  .incl-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .incl-card li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--color-ink-800);
    font-size: var(--text-base);
    line-height: 1.4;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    margin-top: 0.05rem;
    border-radius: var(--radius-pill);
  }
  .mark.yes {
    background: color-mix(in oklab, var(--color-accent-500) 16%, white);
    color: var(--color-accent-600);
  }
  .mark.extra {
    background: color-mix(in oklab, var(--color-warn-500) 18%, white);
    color: var(--color-warn-500);
  }

  @media (max-width: 620px) {
    .incl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
