---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import Band from '../components/ui/Band.astro';
import { iconSvg } from '../lib/icons.js';
import { staticRow } from '../lib/page.js';

const row = staticRow({
  path: '/track',
  pageType: 'core',
  title: 'Track Your Move | MrPackerMover',
  h1: 'Track your move',
  metaDescription:
    'Enter your job reference to check the live status of a booked move with MrPackerMover. Real status from our operations system — never a fabricated update.',
  breadcrumbs: [{ path: '/', anchor: 'Home' }],
});
---

<BaseLayout row={row}>
  <PageHero
    dark
    eyebrow="Live status"
    h1={row.h1}
    intro="Booked a move with us? Enter the job reference from your confirmation to see where things stand."
    breadcrumbs={row.breadcrumbs}
    current="Track your move"
  />

  <Band label="Tracking">
    <div class="track-card card">
      <form id="track-form" class="track-form" novalidate>
        <label for="track-ref">Job reference</label>
        <div class="track-row">
          <input
            id="track-ref"
            name="ref"
            type="text"
            inputmode="text"
            autocomplete="off"
            placeholder="e.g. MPM-2026-04821"
            aria-describedby="track-help"
            required
          />
          <button type="submit" class="btn btn-primary">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={iconSvg('search')}
            />
            Track
          </button>
        </div>
        <p id="track-help" class="track-help">
          Your reference is on your booking confirmation and GST invoice.
        </p>
      </form>

      <div id="track-result" class="track-result" aria-live="polite" hidden></div>
    </div>

    <p class="track-foot">
      Can’t find your reference, or need a human? <a href="/company/contact">Contact us</a> and
      we’ll pull up your move.
    </p>
  </Band>
</BaseLayout>

<script>
  const form = document.getElementById('track-form') as HTMLFormElement | null;
  const input = document.getElementById('track-ref') as HTMLInputElement | null;
  const result = document.getElementById('track-result') as HTMLDivElement | null;
  if (form && input && result) {
    const render = (variant: 'ok' | 'warn' | 'info', title: string, body: string): void => {
      result.hidden = false;
      result.className = `track-result show ${variant}`;
      result.innerHTML = `<strong>${title}</strong><span>${body}</span>`;
    };

    // Prefill + auto-run if a ?ref= is present in the URL.
    const preset = new URLSearchParams(location.search).get('ref');
    if (preset) input.value = preset;

    const lookup = async (ref: string): Promise<void> => {
      render('info', 'Checking…', 'Looking up your move.');
      try {
        const res = await fetch(`/track/result?ref=${encodeURIComponent(ref)}`, {
          headers: { Accept: 'application/json' },
        });
        const type = res.headers.get('content-type') ?? '';
        if (!type.includes('application/json')) throw new Error('unavailable');
        const data = (await res.json()) as { status?: string; message?: string };
        if (res.ok && data.status && data.status !== 'unknown') {
          render('ok', `Status: ${data.status}`, data.message ?? 'Your move is on track.');
        } else {
          render('warn', 'Not found', data.message ?? 'We could not find that reference.');
        }
      } catch {
        render(
          'info',
          'Tracking is coming soon',
          'Live tracking is being connected to our operations system. In the meantime, your coordinator can give you an update — reach us on the contact page.',
        );
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const ref = input.value.trim();
      if (!ref) {
        render('warn', 'Enter a reference', 'Please type the job reference from your confirmation.');
        return;
      }
      void lookup(ref);
    });

    if (preset) void lookup(preset.trim());
  }
</script>

<style>
  .track-card {
    max-width: 620px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .track-form label {
    display: block;
    font-weight: 600;
    color: var(--color-ink-900);
    margin-bottom: 0.5rem;
  }
  .track-row {
    display: flex;
    gap: 0.6rem;
  }
  .track-row input {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    font-size: var(--text-base);
    font-family: var(--font-text);
    color: var(--color-ink-900);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-btn);
  }
  .track-row input:focus-visible {
    outline: 3px solid var(--color-brand-400);
    outline-offset: 1px;
  }
  .track-help {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink-500);
  }
  .track-result {
    margin-top: 1.25rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .track-result strong {
    color: var(--color-ink-900);
  }
  .track-result span {
    color: var(--color-ink-700);
    font-size: var(--text-sm);
  }
  .track-result.ok {
    border-color: color-mix(in oklab, var(--color-accent-500) 40%, var(--color-line));
    background: color-mix(in oklab, var(--color-accent-500) 8%, white);
  }
  .track-result.warn {
    border-color: color-mix(in oklab, var(--color-warn-500) 40%, var(--color-line));
    background: color-mix(in oklab, var(--color-warn-500) 8%, white);
  }
  .track-result.info {
    background: var(--color-surface-2);
  }
  .track-foot {
    text-align: center;
    margin-top: 1.5rem;
    color: var(--color-ink-500);
  }
  @media (max-width: 480px) {
    .track-row {
      flex-direction: column;
    }
  }
</style>
