---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import Band from '../../components/ui/Band.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import { formatDate } from '../../lib/format.js';
import { staticRow, editorialFor } from '../../lib/page.js';
import { CATEGORIES, featuredPost, sortedPosts } from '../../data/blog.js';

const ed = editorialFor('blog-index');
const row = staticRow({
  path: '/blog',
  pageType: 'core',
  title: ed.metaTitle ?? 'The Move Well Blog | MrPackerMover',
  h1: 'Moving, minus the mystery',
  metaDescription:
    ed.seoDescription ??
    'Practical, no-nonsense guides on home shifting, office moves, packing, pricing and staying safe from moving fraud — from the MrPackerMover team.',
  breadcrumbs: [{ path: '/', anchor: 'Home' }],
});

const featured = featuredPost();
const rest = sortedPosts().filter((p) => p.slug !== featured.slug);
---

<BaseLayout row={row}>
  <PageHero
    dark
    eyebrow="The Move Well blog"
    h1={row.h1}
    intro="No fluff, no filler — just the things that make a move go smoothly, written by the people who do this every day."
    breadcrumbs={row.breadcrumbs}
    current="Blog"
  />

  <Band label="Featured article">
    <a class="featured" href={`/blog/${featured.slug}`}>
      <div class="ft-media">
        <img
          src={featured.cover}
          alt={featured.coverAlt}
          width="800"
          height="600"
          decoding="async"
        />
      </div>
      <div class="ft-body">
        <span class="ft-flag">
          <span class="ft-cat">{featured.category}</span>
          <span class="ft-featured">Featured</span>
        </span>
        <h2>{featured.title}</h2>
        <p class="ft-excerpt">{featured.excerpt}</p>
        <div class="ft-meta">
          <span>{featured.author}</span>
          <span class="bc-dot" aria-hidden="true">·</span>
          <span>{formatDate(featured.date)}</span>
          <span class="bc-dot" aria-hidden="true">·</span>
          <span>{featured.readMins} min read</span>
        </div>
        <span class="ft-cta">Read the guide →</span>
      </div>
    </a>
  </Band>

  <Band alt label="All articles">
    <div class="section-head">
      <h2>Latest articles</h2>
      <p>Browse everything, or filter by what you need right now.</p>
    </div>

    <div class="filters" role="group" aria-label="Filter articles by category">
      <button type="button" class="chip active" data-filter="all" aria-pressed="true">All</button>
      {
        CATEGORIES.map((c) => (
          <button type="button" class="chip" data-filter={c} aria-pressed="false">
            {c}
          </button>
        ))
      }
    </div>

    <div class="blog-grid" id="blog-grid">
      {rest.map((post) => <BlogCard post={post} />)}
    </div>
    <p class="no-results" id="no-results" hidden>No articles in this category yet.</p>
  </Band>

  <CtaBand
    heading="Reading is nice. A fixed quote is better."
    text="When you’re ready to actually move, skip the guesswork — get an itemised, fixed price from a company you can verify."
    primaryLabel="Get a fixed quote"
    primaryHref="/get-quote"
    secondaryLabel="How we price"
    secondaryHref="/pricing"
  />
</BaseLayout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#blog-grid .blog-card'));
  const empty = document.getElementById('no-results');

  const apply = (filter: string): void => {
    let shown = 0;
    for (const card of cards) {
      const match = filter === 'all' || card.dataset.category === filter;
      card.hidden = !match;
      if (match) shown++;
    }
    if (empty) empty.hidden = shown !== 0;
  };

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      for (const c of chips) {
        const active = c === chip;
        c.classList.toggle('active', active);
        c.setAttribute('aria-pressed', String(active));
      }
      apply(chip.dataset.filter ?? 'all');
    });
  }
</script>

<style>
  /* Featured split card */
  .featured {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 0;
    max-width: 1080px;
    margin-inline: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .featured:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
    text-decoration: none;
  }
  .ft-media {
    position: relative;
    min-height: 280px;
    overflow: hidden;
    background: var(--color-surface-3);
  }
  .ft-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .featured:hover .ft-media img {
    transform: scale(1.04);
  }
  .ft-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.75rem, 3vw, 2.75rem);
  }
  .ft-flag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ft-cat {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-brand-700);
    background: var(--color-brand-50);
    padding: 0.28rem 0.6rem;
    border-radius: var(--radius-pill);
  }
  .ft-featured {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent-600);
  }
  .ft-body h2 {
    font-size: clamp(1.5rem, 3.2vw, var(--text-3xl));
    color: var(--color-ink-900);
  }
  .ft-excerpt {
    color: var(--color-ink-500);
    font-size: var(--text-lg);
  }
  .ft-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-ink-500);
  }
  .ft-cta {
    margin-top: 0.35rem;
    font-weight: 700;
    color: var(--color-brand-700);
  }

  /* Filters */
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .chip {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-ink-700);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .chip:hover {
    border-color: var(--color-brand-300);
    color: var(--color-brand-700);
  }
  .chip.active {
    background: var(--color-brand-600);
    border-color: var(--color-brand-600);
    color: #fff;
  }

  /* Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 1120px;
    margin-inline: auto;
  }
  .no-results {
    text-align: center;
    color: var(--color-ink-500);
    margin-top: 1.5rem;
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .ft-media {
      min-height: 220px;
    }
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
