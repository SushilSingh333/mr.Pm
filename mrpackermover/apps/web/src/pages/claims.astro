---
import { jsonld } from '@mpm/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import Band from '../components/ui/Band.astro';
import FeatureGrid from '../components/page/FeatureGrid.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBand from '../components/page/CtaBand.astro';
import { staticRow, org, editorialFor } from '../lib/page.js';

const ed = editorialFor('claims');
const row = staticRow({
  path: '/claims',
  pageType: 'trust',
  title: ed.metaTitle ?? 'Damage Claims & Settlement | MrMoverPacker',
  h1: ed.title ?? 'If something is damaged, here is exactly what happens',
  metaDescription:
    ed.seoDescription ??
    'How MrMoverPacker handles damage claims: free to raise, checked against the photos taken at pickup, a first reply within 24 hours, and a settlement agreed in writing.',
  breadcrumbs: [{ path: '/', anchor: 'Home' }],
});
const o = org();

/**
 * What a customer gets if something is damaged: the commitments the service pages already
 * make (home shifting: "Raising a claim is free", "We respond first within 24 hours,
 * checking your report against the pickup photos", repair, replacement or reimbursement).
 * No figures: there are no published claims statistics, and the page does not promise any.
 */
const promises = [
  {
    icon: 'tag',
    title: 'Free to raise',
    body: 'Raising a claim costs nothing. Tell your coordinator, or use our raise-a-complaint page, with photos.',
  },
  {
    icon: 'camera',
    title: 'Checked against the photos',
    body: 'Your report is compared with the photo inventory you signed at pickup. The record settles it, not an argument.',
  },
  {
    icon: 'clock',
    title: 'A first reply within 24 hours',
    body: 'A coordinator responds within 24 hours, tells you what happens next, and stays with the claim until it closes.',
  },
  {
    icon: 'shield-check',
    title: 'Repair, replace or reimburse',
    body: 'Settled to the cover you chose: basic liability on every move, or your declared value with transit insurance.',
  },
];

const steps = [
  {
    title: 'Report it within the window',
    body: 'Tell your coordinator (or use raise-a-complaint) within the claims window on your invoice. Share photos and your inventory reference.',
  },
  {
    title: 'We assess against the record',
    body: 'We check your report against the sealed inventory and the packing photos taken on the day, the shared record, not a he-said-she-said.',
  },
  {
    title: 'We agree a settlement',
    body: 'For a covered item we agree repair, replacement or reimbursement, based on your declared value and any transit insurance you opted for.',
  },
  {
    title: 'You’re paid, and it’s logged',
    body: 'The settlement is paid out and the claim is closed in writing, with a record you keep.',
  },
];

const faqs = [
  {
    question: 'Is it free to raise a claim?',
    answer:
      'Yes. Raising a claim costs nothing. Tell your coordinator, or use our raise-a-complaint page, with photos of the damage and your inventory reference. We reply within 24 hours.',
  },
  {
    question: 'What is actually covered?',
    answer:
      'Transit damage caused by our handling is our responsibility. Your liability cover is basic by default; opting for transit insurance raises it to your declared value. Pre-existing damage and items you packed yourself without our inspection are treated differently, all spelled out before the move.',
  },
  {
    question: 'How is a settlement amount decided?',
    answer:
      'By the declared value of the item and the cover you chose. With transit insurance, it is settled to the insured value; without it, to the basic liability limit. We show you both options on your quote so there are no surprises.',
  },
  {
    question: 'How long do I have to raise a claim?',
    answer:
      'The exact window is printed on your invoice. Report as soon as you notice an issue, ideally at handover, and keep the item and its packing until the claim is closed.',
  },
];

const extraJsonLd = [jsonld.faqPage(faqs)];
---

<BaseLayout row={row} extraJsonLd={extraJsonLd}>
  <PageHero
    dark
    eyebrow={ed.eyebrow ?? 'Claims & settlement'}
    h1={row.h1}
    intro={ed.intro ??
      'Pretending damage never happens is how this industry lost your trust. So every move comes with a written claims process: free to raise, checked against the photos taken at pickup, a first reply within 24 hours, and a settlement agreed in writing.'}
    breadcrumbs={row.breadcrumbs}
    current="Claims"
  />

  <Band label="Our claims promise">
    <div class="section-head">
      <h2>What you get if something is damaged</h2>
      <p>The same four promises on every move, written down before the crew arrives.</p>
    </div>
    <FeatureGrid items={promises} columns={4} />
  </Band>

  <Band alt label="How claims work">
    <div class="section-head">
      <h2>How a claim works</h2>
      <p>Four steps, defined before your move begins, not improvised after something breaks.</p>
    </div>
    <FeatureGrid items={steps} columns={4} numbered />
  </Band>

  <Band label="Claims FAQ">
    <Faq faqs={faqs} heading="Claims questions, answered" />
    {
      o?.complaintSla && (
        <p class="sla-note">
          Our commitment: {o.complaintSla} Prefer to start now?{' '}
          <a href="/raise-a-complaint">Raise a complaint</a>.
        </p>
      )
    }
  </Band>

  <CtaBand
    heading="Protection you can read before you book"
    text="See exactly how your goods are covered in transit, and choose the level of protection that fits your move."
    primaryLabel="Transit insurance"
    primaryHref="/insurance"
    secondaryLabel="Raise a complaint"
    secondaryHref="/raise-a-complaint"
  />
</BaseLayout>

<style>
  .sla-note {
    text-align: center;
    margin-top: 1.5rem;
    color: var(--color-ink-500);
  }
  .sla-note a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
