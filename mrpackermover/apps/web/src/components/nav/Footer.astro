---
import { manifest, rowsOfType } from '../../data/manifest.js';
import type { CityHubData } from '@mpm/shared';
import {
  FOOTER_SERVICES,
  FOOTER_COMPANY,
  FOOTER_TRUST,
  FOOTER_LEGAL,
  SOCIALS,
  PHONE_DISPLAY,
  PHONE_TEL,
  EMAIL,
} from '../../lib/site.js';
import Logo from './Logo.astro';

/**
 * Footer, in Porter's structure but adapted to what we actually have: no app
 * download (we have no app), no "Countries" (India only). Cities are the
 * serviceable cities from the manifest.
 */
const cityLinks = rowsOfType('city-hub').map((r) => ({
  path: r.path,
  name: (r.data as unknown as CityHubData).cityName,
}));
const year = new Date().getFullYear();

const ICONS: Record<string, string> = {
  facebook:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"/></svg>',
  instagram:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  youtube:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 00-1.77-1.77C19.34 5 12 5 12 5s-7.34 0-8.83.53A2.5 2.5 0 001.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 001.77 1.77C4.66 19 12 19 12 19s7.34 0 8.83-.53a2.5 2.5 0 001.77-1.77C23 15.2 23 12 23 12zm-13 3V9l5 3z"/></svg>',
  x: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
};
const socialIcon = (name: string): string => ICONS[name] ?? '';
---

<footer class="site-footer">
  <div class="container-page footer-top">
    <div class="footer-brand">
      <Logo light />
      <p class="footer-tagline">
        Fixed quotes, verified crews, and claims data we actually publish. We serve the areas listed
        below — we don't claim offices we don't have.
      </p>

      <div class="footer-contact">
        <a href={`tel:${PHONE_TEL}`}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.6l1.4 4-2 1.3a11 11 0 0 0 4.7 4.7L18 16l1.4 1.4V21a1 1 0 0 1-1 1A15 15 0 0 1 3 6a1 1 0 0 1 1-1z"/></svg>
          {PHONE_DISPLAY}
        </a>
        <a href={`mailto:${EMAIL}`}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/></svg>
          {EMAIL}
        </a>
      </div>

      <div class="footer-social">
        <span class="follow">Follow us on</span>
        <div class="social-row">
          {
            SOCIALS.map((s) => (
              <a
                href={s.href}
                class="social"
                aria-label={s.label}
                target="_blank"
                rel="noopener noreferrer"
                set:html={socialIcon(s.icon)}
              />
            ))
          }
        </div>
      </div>
    </div>

    <nav class="footer-col" aria-label="Company">
      <h2 class="footer-heading">Company</h2>
      <ul>
        {FOOTER_COMPANY.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Services">
      <h2 class="footer-heading">Services</h2>
      <ul>
        {FOOTER_SERVICES.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Support">
      <h2 class="footer-heading">Support</h2>
      <ul>
        {FOOTER_TRUST.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Legal and safety">
      <h2 class="footer-heading">Legal &amp; safety</h2>
      <ul>
        {FOOTER_LEGAL.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {
    cityLinks.length > 0 && (
      <div class="container-page footer-cities">
        <h2 class="footer-heading">Cities we serve</h2>
        <ul class="cities-list">
          {cityLinks.map((c) => (
            <li>
              <a href={c.path}>{c.name}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="footer-bottom-wrap">
    <div class="container-page footer-bottom">
      <span>© {year} MrPackerMover. Serviceability is proven with completed-job data.</span>
      <span class="dev-by">Developed by <strong>AAJneeti Connect Limited</strong></span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: #092341;
    color: color-mix(in oklab, white 76%, #092341);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 2rem;
    padding-block: 3.5rem 2.5rem;
  }
  .footer-tagline {
    margin-top: 1.1rem;
    max-width: 36ch;
    font-size: var(--text-sm);
    color: color-mix(in oklab, white 60%, #092341);
  }
  .footer-contact {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: color-mix(in oklab, white 82%, #092341);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .footer-contact a svg {
    color: var(--color-brand-300);
    flex: none;
  }
  .footer-contact a:hover {
    color: #fff;
  }
  .footer-social {
    margin-top: 1.5rem;
  }
  .follow {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: color-mix(in oklab, white 70%, #092341);
    margin-bottom: 0.6rem;
  }
  .social-row {
    display: flex;
    gap: 0.6rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in oklab, white 18%, #092341);
    color: color-mix(in oklab, white 82%, #092341);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .social:hover {
    background: var(--color-brand-600);
    color: #fff;
    border-color: var(--color-brand-600);
  }
  .footer-heading {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    margin-bottom: 1rem;
  }
  .footer-col ul,
  .cities-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .site-footer a {
    color: color-mix(in oklab, white 78%, #092341);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer-cities {
    padding-block: 0.5rem 2.5rem;
  }
  .cities-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.65rem 1.5rem;
  }
  .footer-bottom-wrap {
    border-top: 1px solid color-mix(in oklab, white 12%, #092341);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem 2rem;
    font-size: var(--text-sm);
    color: color-mix(in oklab, white 55%, #092341);
  }
  .dev-by strong {
    color: color-mix(in oklab, white 85%, #092341);
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 1.25rem;
      padding-block: 2.75rem 2rem;
    }
    /* Brand block spans the full width; the four link columns sit as a 2×2 below it. */
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
  @media (max-width: 360px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
