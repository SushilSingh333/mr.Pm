---
/**
 * MrPackerMover master logo (MPM Brand Guideline).
 *
 * The artwork is the approved lockup, not a font rebuild — the guideline forbids
 * recreating it in a different typeface, so both variants are cut from the master
 * file with their alpha recovered, keeping the letterforms, the circular movement
 * arrows and the "o" location pin exactly as drawn.
 *
 * Two variants ship, per "Color Usage Guidelines":
 *   /logo.png          Deep Royal Blue wordmark — for white/light surfaces (header)
 *   /logo-inverse.png  White wordmark — for the blue and dark surfaces (footer)
 * Orange stays #FF5500 in both; only the neutral half flips, so contrast stays
 * maximal on either ground as the guideline requires.
 *
 * The tagline-bearing lockup (/logo-lockup*.png) is the one the 240px minimum
 * width protects. This header mark carries no tagline, so it reads cleanly
 * smaller — but keep it >=140px or the pin's centre point starts to disappear.
 */
interface Props {
  light?: boolean;
  href?: string;
  /** Rendered width in px. Height follows the 3.168:1 artwork ratio. */
  width?: number;
}
const { light = false, href = '/', width = 165 } = Astro.props;
const height = Math.round((width / 640) * 202);
const src = light ? '/logo-inverse.png' : '/logo.png';
---

<a class="logo" href={href} aria-label="MrPackerMover home">
  <img
    src={src}
    alt="MrPackerMover"
    width={width}
    height={height}
    decoding="async"
    loading="eager"
    fetchpriority="high"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo img {
    display: block;
    height: auto;
    max-width: 100%;
  }
</style>
