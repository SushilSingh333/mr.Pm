  linkedin:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>',
  reddit:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-6.993 4.87-3.86 0-6.99-2.176-6.99-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12c-.688 0-1.25.561-1.25 1.25 0 .687.562 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>',
  quora:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="7.5"/><path d="M12.6 15.4c1.1 2.5 2.2 3.6 4.4 3.6"/></svg>',
  threads:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.056 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.128-.657-.328-1.216-.598-1.664-.363-.603-.921-1.055-1.658-1.34-.019-.006-.038-.013-.057-.02-.564-.202-1.235-.269-1.87-.187-.55.071-1.017.26-1.388.564l-1.34-1.605c.63-.514 1.415-.848 2.334-.994 1.026-.163 2.13-.06 3.089.29.017.006.033.012.05.019 1.207.443 2.145 1.19 2.788 2.223.475.762.799 1.664.964 2.688 1.508.6 2.65 1.54 3.31 2.723.97 1.74 1.06 4.582-1.253 6.847-1.77 1.733-3.916 2.516-6.984 2.539Zm1.53-9.99c-.24 0-.485.007-.734.021-1.847.104-2.996.888-2.928 2.166.071 1.34 1.55 1.964 2.97 1.887 1.306-.07 3.006-.578 3.294-3.95a10.94 10.94 0 0 0-2.602-.124Z"/></svg>',
  pinterest:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0"/></svg>',
  discord:
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.198.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>',
};
const socialIcon = (name: string): string => ICONS[name] ?? '';
---

<footer class="site-footer">
  <div class="container-page footer-top">
    <div class="footer-brand">
      <Logo light />
      <p class="footer-tagline">
        Fixed quotes, verified crews, and claims data we actually publish. We serve the areas listed
        below.
      </p>

      <div class="footer-contact">
        <a href={`tel:${PHONE_TEL}`}>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M5 4h3.6l1.4 4-2 1.3a11 11 0 0 0 4.7 4.7L18 16l1.4 1.4V21a1 1 0 0 1-1 1A15 15 0 0 1 3 6a1 1 0 0 1 1-1z"
            ></path></svg
          >
          {PHONE_DISPLAY}
        </a>
        <a href={`mailto:${EMAIL}`}>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3.5 7l8.5 6 8.5-6"
            ></path></svg
          >
          {EMAIL}
        </a>
      </div>

      <div class="footer-social">
        <span class="follow">Follow us on</span>
        <div class="social-row">
          {
            SOCIALS.map((s) => (
              <a
                href={s.href}
                class="social"
                aria-label={s.label}
                target="_blank"
                rel="noopener noreferrer"
                set:html={socialIcon(s.icon)}
              />
            ))
          }
        </div>
      </div>
    </div>

    <nav class="footer-col" aria-label="Company">
      <h2 class="footer-heading">Company</h2>
      <ul>
        {
          company.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Services">
      <h2 class="footer-heading">Services</h2>
      <ul>
        {
          FOOTER_SERVICES.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Support">
      <h2 class="footer-heading">Support</h2>
      <ul>
        {
          trust.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Legal and safety">
      <h2 class="footer-heading">Legal &amp; safety</h2>
      <ul>
        {
          legal.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {
    cityLinks.length > 0 && (
      <div class="container-page footer-cities">
        <h2 class="footer-heading">Cities we serve</h2>
        <ul class="cities-list" data-cities-block>
          {cityLinks.map((c, i) => (
            <li
              class:list={{
                'city-extra': cityLinks.length > VISIBLE_CITIES && i >= VISIBLE_CITIES,
              }}
              hidden={cityLinks.length > VISIBLE_CITIES && i >= VISIBLE_CITIES}
            >
              <a href={c.path}>{c.name}</a>
            </li>
          ))}
          {cityLinks.length > VISIBLE_CITIES && (
            <li class="cities-more-item">
              <button type="button" class="cities-more-btn" data-show-cities>
                Show all {cityLinks.length} cities
              </button>
            </li>
          )}
        </ul>
      </div>
    )
  }

  <div class="footer-bottom-wrap">
    <div class="container-page footer-bottom">
      <span class="fb-copy">© {year} MrMoverPacker. All rights reserved.</span>
    </div>
  </div>
</footer>

<script>
  // "Show all N cities" — one delegated listener serves every cities block on
  // the page (this footer list and the home CitiesGrid). The extra cities are
  // in the HTML from the start (crawlable, nothing fetched); the button only
  // removes the hidden attribute, then retires itself.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('[data-show-cities]');
    if (!button) return;
    const block = button.closest('[data-cities-block]');
    if (!block) return;
    block.querySelectorAll('.city-extra[hidden]').forEach((el) => el.removeAttribute('hidden'));
    (button.closest('.cities-more, .cities-more-item') ?? button).remove();
  });
</script>

<style>
  .site-footer {
    background: #0f0063;
    color: color-mix(in oklab, white 76%, #0f0063);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 2rem;
    padding-block: 3.5rem 2.5rem;
  }
  .footer-tagline {
    margin-top: 1.1rem;
    max-width: 36ch;
    font-size: var(--text-base);
    color: color-mix(in oklab, white 60%, #0f0063);
  }
  .footer-contact {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: color-mix(in oklab, white 82%, #0f0063);
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: none;
  }
  .footer-contact a svg {
    color: var(--color-brand-300);
    flex: none;
  }
  .footer-contact a:hover {
    color: #fff;
  }
  .footer-social {
    margin-top: 1.5rem;
  }
  .follow {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: color-mix(in oklab, white 70%, #0f0063);
    margin-bottom: 0.6rem;
  }
  /* Grid, not a flex line: ten marks on one row overflowed the brand column, and a
     five-across grid splits them into two even rows of five. */
  .social-row {
    display: grid;
    grid-template-columns: repeat(5, 38px);
    gap: 0.55rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in oklab, white 18%, #0f0063);
    color: color-mix(in oklab, white 82%, #0f0063);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .social:hover {
    background: var(--color-brand-600);
    color: #fff;
    border-color: var(--color-brand-600);
  }
  .footer-heading {
    font-family: var(--font-text);
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    margin-bottom: 1rem;
  }
  .footer-col ul,
  .cities-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .site-footer a {
    color: color-mix(in oklab, white 78%, #0f0063);
    text-decoration: none;
    font-size: var(--text-base);
  }
  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer-cities {
    padding-block: 0.5rem 2.5rem;
  }
  .cities-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.65rem 1.5rem;
  }
  .cities-more-btn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom-wrap {
    border-top: 1px solid color-mix(in oklab, white 12%, #0f0063);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem 2rem;
    font-size: 0.9375rem;
    color: color-mix(in oklab, white 55%, #0f0063);
  }
  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 1.25rem;
      padding-block: 2.75rem 2rem;
    }
    /* Brand block spans the full width; the four link columns sit as a 2×2 below it. */
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
  @media (max-width: 360px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
