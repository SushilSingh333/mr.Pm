---
import { manifest } from '../../data/manifest.js';

/**
 * The hard credibility marker under the H1 (Doc 01 §3): registration + insurance +
 * years. Real, from the Organization profile — not "10,000+ happy customers".
 */
const org = manifest().org;
---

<div class="trust-bar" role="group" aria-label="Credentials">
  <span class="trust-item">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"
      ><path
        fill="currentColor"
        d="M10 1l7 3v5c0 4.4-3 8.3-7 10-4-1.7-7-5.6-7-10V4l7-3zm-1 12l5-5-1.4-1.4L9 10.2 7.4 8.6 6 10l3 3z"
      ></path></svg
    >
    {org ? <>GSTIN {org.gstin}</> : 'Registered & GST-verified'}
  </span>
  <span class="trust-item">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"
      ><path fill="currentColor" d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 12H9v-2h2v2zm0-3H9V6h2v5z"
      ></path></svg
    >
    {
      org?.insurancePartner ? (
        <>Transit insurance · {org.insurancePartner}</>
      ) : (
        'Transit insurance available'
      )
    }
  </span>
  <span class="trust-item">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"
      ><path fill="currentColor" d="M10 1l2.5 5 5.5.8-4 3.9.9 5.5L10 19l-4.9 2.6.9-5.5-4-3.9L7.5 6z"
      ></path></svg
    >
    {org ? <>{org.yearsOperating} years operating</> : 'Years of operations'}
  </span>
</div>

<style>
  .trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-700);
  }
  .trust-item svg {
    color: var(--color-accent-600);
    flex: none;
  }
</style>
